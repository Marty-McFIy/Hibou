# ─── Hôtes Proxmox ──────────────────────────────────────────────────────────
preparer_hote() {  # bundle rôle
  local b="$1"
  etape "Supervision de l’hôte"
  source_locale "$b/apt/pve"
  apt_hibou $PAQUETS_PVE
  # Carte Intel I217-LM (e1000e) : blocages connus avec les déchargements TSO/GSO/GRO.
  local itf
  for itf in /sys/class/net/*; do
    [[ "$(basename "$(readlink -f "$itf/device/driver" 2>/dev/null)")" == e1000e ]] || continue
    itf=$(basename "$itf")
    cat > "/etc/systemd/system/hibou-e1000e@.service" <<'EOF'
[Unit]
Description=Hibou : déchargements désactivés sur %i (e1000e)
After=network-pre.target
Before=network.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/ethtool -K %i tso off gso off gro off
[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload && systemctl enable --now "hibou-e1000e@$itf.service" >/dev/null 2>&1
    fait "Déchargements TSO, GSO et GRO désactivés sur $itf (e1000e)."
  done
  install -m 755 "$b/extra/pve/smartctl_exporter" /usr/local/bin/smartctl_exporter
  cat > /etc/systemd/system/smartctl-exporter.service <<'EOF'
[Unit]
Description=Exportateur Prometheus des états SMART
After=network-online.target
[Service]
ExecStart=/usr/local/bin/smartctl_exporter --web.listen-address=:9633
Restart=on-failure
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload
  systemctl enable --now prometheus-node-exporter smartctl-exporter >/dev/null 2>&1 || true
  fait "Exportateurs node (9100) et SMART (9633) actifs."
  if [[ "$2" != forge ]] && ping -c1 -W2 "$HIBOU_IP_FORGE" >/dev/null 2>&1; then
    printf 'server %s iburst\n' "$HIBOU_IP_FORGE" > /etc/chrony/sources.d/hibou.sources 2>/dev/null && systemctl restart chrony && fait "Heure prise sur forge."
  fi
  if [[ "$2" == forge ]]; then
    [[ -n "${HIBOU_STOCKAGE_SAUVEGARDE:-}" ]] || erreur "Aucun stockage de sauvegarde dans la configuration." "Refais le menu du bundle (« Tout refaire ») et indique un stockage Proxmox."
    pvesm status --storage "$HIBOU_STOCKAGE_SAUVEGARDE" --content backup >/dev/null 2>&1 \
      || erreur "Le stockage $HIBOU_STOCKAGE_SAUVEGARDE n’existe pas ou n’accepte pas les sauvegardes." "Datacenter > Storage : ajoute-le avec le contenu « VZDump backup file », puis relance."
    install -d /var/lib/prometheus/node-exporter
    cat > /usr/local/bin/hibou-vzdump-hook <<'EOF'
#!/bin/sh
# Appelé par vzdump : note l’heure de chaque sauvegarde réussie pour Prometheus.
[ "$1" = "backup-end" ] || exit 0
f=/var/lib/prometheus/node-exporter/hibou_vzdump_$3.prom
echo "hibou_sauvegarde_derniere_reussite_timestamp{type=\"vzdump\",vmid=\"$3\"} $(date +%s)" > "$f.tmp" && mv "$f.tmp" "$f"
EOF
    chmod 755 /usr/local/bin/hibou-vzdump-hook
    pvesh get /cluster/backup/hibou >/dev/null 2>&1 && pvesh delete /cluster/backup/hibou
    # forge seule : les VM GPU ne contiennent que des modèles et une configuration, rejouables depuis le bundle.
    pvesh create /cluster/backup --id hibou --schedule "03:00" --vmid "$HIBOU_VMID_FORGE" --mode snapshot --compress zstd \
      --storage "$HIBOU_STOCKAGE_SAUVEGARDE" --prune-backups keep-daily=7,keep-weekly=4 \
      --script /usr/local/bin/hibou-vzdump-hook --notes-template "Hibou {{guestname}}" >/dev/null
    fait "Sauvegarde quotidienne à 3 h de forge vers $HIBOU_STOCKAGE_SAUVEGARDE, 7 jours et 4 semaines."
  fi
}

# Cartes NVIDIA réservées à vfio-pci, tout de suite et à chaque démarrage. Proxmox 9 active l’IOMMU Intel par défaut.
gpu_vfio() {
  local ids d p drv n=0
  [[ -n "$(lspci -d 10de: 2>/dev/null)" ]] || erreur "Je ne vois aucune carte NVIDIA sur cet hôte." "Vérifie le montage des cartes et leur alimentation."
  [[ -n "$(ls /sys/kernel/iommu_groups 2>/dev/null)" ]] \
    || erreur "L’IOMMU est inactive." "Dans le BIOS du R730 : Processor Settings > Virtualization Technology = Enabled, et Integrated Devices > Memory Mapped I/O above 4GB = Enabled. Redémarre puis relance."
  ids=$(lspci -n -d 10de: | awk '{print $3}' | sort -u | paste -sd,)
  printf 'options vfio-pci ids=%s disable_vga=1\nsoftdep nouveau pre: vfio-pci\nsoftdep nvidia pre: vfio-pci\n' "$ids" > /etc/modprobe.d/hibou-vfio.conf
  printf 'blacklist nouveau\nblacklist nvidiafb\nblacklist nvidia\n' > /etc/modprobe.d/hibou-blacklist.conf
  printf 'vfio\nvfio_iommu_type1\nvfio_pci\n' > /etc/modules-load.d/hibou-vfio.conf
  update-initramfs -u -k all >/dev/null 2>&1
  modprobe vfio-pci
  for d in $(lspci -Dmm -d 10de: | awk '{print $1}'); do
    p="/sys/bus/pci/devices/$d"; drv=$(basename "$(readlink -f "$p/driver" 2>/dev/null)")
    n=$((n + 1))
    [[ "$drv" == vfio-pci ]] && continue
    [[ -e "$p/driver" ]] && echo "$d" > "$p/driver/unbind"
    echo vfio-pci > "$p/driver_override"; echo "$d" > /sys/bus/pci/drivers_probe
  done
  fait "$n fonctions PCI NVIDIA confiées à vfio-pci ($ids)."
}

stockage_vm() {
  if [[ -n "${HIBOU_STOCKAGE:-}" ]]; then echo "$HIBOU_STOCKAGE"; return; fi
  pvesm status --content images --enabled 1 2>/dev/null | awk 'NR>1 {print $6, $1}' | sort -n | tail -1 | cut -d' ' -f2
}

# Domaine de connexion « forgejo » sur l’hôte : certificat racine et secret lus sur forge par SSH.
realm_proxmox() {
  local ca env id secret
  ca=$(ssh_vm "$HIBOU_IP_FORGE" 'sudo cat /srv/hibou/hibou-ca.crt' 2>/dev/null) \
    && env=$(ssh_vm "$HIBOU_IP_FORGE" 'sudo cat /srv/hibou/pve-oidc.env' 2>/dev/null) \
    || { note "Forge injoignable ou pas encore configurée : connexion Proxmox par Forgejo à refaire plus tard (relance ce rôle)."; return 0; }
  printf '%s\n' "$ca" > /usr/local/share/ca-certificates/hibou.crt && update-ca-certificates >/dev/null
  id=$(sed -n 's/^PVE_ID=//p' <<< "$env"); secret=$(sed -n 's/^PVE_SECRET=//p' <<< "$env")
  local opts=(--issuer-url "https://forge.$DOMAINE/" --client-id "$id" --client-key "$secret" --username-claim username --autocreate 1 --comment "Hibou · Forge")
  if pveum realm list --output-format json | jq -e '.[] | select(.realm=="forgejo")' >/dev/null; then pveum realm modify forgejo "${opts[@]}"
  else pveum realm add forgejo --type openid "${opts[@]}"; fi
  # L’administrateur Hibou administre Proxmox ; root@pam reste l’accès de secours.
  pveum user list --output-format json | jq -e --arg u "$HIBOU_ADMIN_NOM@forgejo" '.[] | select(.userid==$u)' >/dev/null \
    || pveum user add "$HIBOU_ADMIN_NOM@forgejo" --email "$HIBOU_ADMIN_MAIL"
  pveum acl modify / --users "$HIBOU_ADMIN_NOM@forgejo" --roles Administrator
  fait "Proxmox : connexion par Forgejo active, $HIBOU_ADMIN_NOM@forgejo administrateur. root@pam reste l’accès de secours."
}

ssh_vm() {  # adresse commande...
  ssh -i /root/.ssh/hibou_ed25519 -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new \
    -o UserKnownHostsFile=/root/.ssh/hibou_known_hosts -T "hibou@$1" "${@:2}"
}
attendre_ssh() {
  local i
  for i in $(seq 1 72); do ssh_vm "$1" true 2>/dev/null && return 0; sleep 5; done
  erreur "La VM $1 ne répond pas en SSH après 6 minutes." "Ouvre sa console dans Proxmox (compte hibou) et regarde « cloud-init status --long »."
}

creer_vm() {  # rôle bundle
  local role="$1" b="$2" id ip nom st mem coeurs sockets disque
  id="HIBOU_VMID_${role^^}"; id="${!id}"; ip="HIBOU_IP_${role^^}"; ip="${!ip}"; nom="hibou-$role"
  disque="HIBOU_DISQUE_${role^^}"; disque="${!disque}"
  etape "VM $nom ($id)"
  if qm status "$id" >/dev/null 2>&1; then
    note "La VM $id existe déjà : je la garde. Pour repartir de zéro : qm stop $id && qm destroy $id --purge"
    qm start "$id" >/dev/null 2>&1 || true
    return 0
  fi
  st=$(stockage_vm); [[ -n "$st" ]] || erreur "Aucun stockage Proxmox n’accepte de disques de VM." "Indique-le avec HIBOU_STOCKAGE=<nom>."
  sockets=$(lscpu | awk -F: '/^Socket\(s\)/ {gsub(/ /,"",$2); print $2}')
  if [[ "$role" == forge ]]; then mem=$((HIBOU_RAM_FORGE * 1024)); coeurs="$HIBOU_CPU_FORGE"; sockets=1
  else
    # Par défaut tout l’hôte moins 16 Go et 4 fils ; HIBOU_RAM_GPU (Go) et HIBOU_CPU_GPU pour un hôte partagé (essais).
    mem=$(( ${HIBOU_RAM_GPU:-0} > 0 ? HIBOU_RAM_GPU * 1024 : $(awk '/MemTotal/ {print int($2/1024)}' /proc/meminfo) - 16384 ))
    coeurs=$(( ${HIBOU_CPU_GPU:-0} > 0 ? HIBOU_CPU_GPU / sockets : ($(nproc) - 4) / sockets ))
  fi
  local net="virtio,bridge=$HIBOU_PONT${HIBOU_VLAN:+,tag=$HIBOU_VLAN}" pfx="${HIBOU_RESEAU#*/}"
  # Démarrage sécurisé désactivé (pre-enrolled-keys=0) : le module NVIDIA compilé par DKMS n’est pas signé.
  qm create "$id" --name "$nom" --machine q35 --bios ovmf --efidisk0 "$st:1,efitype=4m,pre-enrolled-keys=0" \
    --cpu host --sockets "$sockets" --cores "$coeurs" --numa $(( sockets > 1 )) --memory "$mem" --balloon 0 \
    --net0 "$net" --scsihw virtio-scsi-single --ostype l26 --serial0 socket --onboot 1 --agent enabled=1,fstrim_cloned_disks=1 >/dev/null
  qm set "$id" --scsi0 "$st:0,import-from=$b/extra/$IMAGE_CLOUD,discard=on,iothread=1,ssd=1" >/dev/null
  qm resize "$id" scsi0 "${disque}G" >/dev/null
  local cles; cles=$(mktemp); echo "$HIBOU_SSH_VM_PUB" > "$cles"
  # ciupgrade 0 : pas de mise à jour au premier démarrage, il n’y a pas d’Internet.
  qm set "$id" --ide2 "$st:cloudinit" --boot order=scsi0 --ciuser hibou --cipassword "$HIBOU_VM_MDP" --ciupgrade 0 \
    --sshkeys "$cles" --ipconfig0 "ip=$ip/$pfx${HIBOU_PASSERELLE:+,gw=$HIBOU_PASSERELLE}" \
    --nameserver "$HIBOU_IP_FORGE" --searchdomain "$DOMAINE" >/dev/null
  rm -f "$cles"
  if [[ "$role" != forge ]]; then
    local i=0 slot
    for slot in $(lspci -Dmm -d 10de: | awk '{print $1}' | sed 's/\.[0-7]$//' | sort -u); do
      qm set "$id" --hostpci$i "$slot,pcie=1" >/dev/null; i=$((i + 1))
    done
    fait "$i cartes passées à la VM, toutes fonctions comprises."
  fi
  qm start "$id"
  fait "VM $nom créée sur $st : $coeurs cœurs × $sockets, $((mem / 1024)) Go, ${disque} Go de disque, $ip."
}

# Cartes NVIDIA de l’hôte et cartes de la VM alignées (ajout de la deuxième RTX 6000 Ada, par exemple).
cartes_vm() {  # rôle
  local id="HIBOU_VMID_${1^^}" voulu actuel slot i=0 k
  id="${!id}"
  voulu=$(lspci -Dmm -d 10de: | awk '{print $1}' | sed 's/\.[0-7]$//' | sort -u | paste -sd' ')
  actuel=$(qm config "$id" | awk -F'[ ,]' '/^hostpci[0-9]+:/ {print $2}' | sort -u | paste -sd' ')
  if [[ "$voulu" == "$actuel" ]]; then note "Cartes de la VM inchangées."; return 0; fi
  etape "Cartes de la VM : ${actuel:-aucune} → $voulu"
  qm shutdown "$id" --timeout 180 >/dev/null 2>&1 || qm stop "$id"
  for k in $(qm config "$id" | grep -oE '^hostpci[0-9]+'); do qm set "$id" --delete "$k" >/dev/null; done
  for slot in $voulu; do qm set "$id" --hostpci$i "$slot,pcie=1" >/dev/null; i=$((i + 1)); done
  qm start "$id"
  fait "$i cartes passées à la VM."
}

copier_vers_vm() {  # rôle bundle adresse ; rsync ne transfère que ce qui a changé
  local role="$1" b="$2" liste nom alias; liste=$(mktemp)
  {
    printf '%s\n' hibou config.env secrets.chiffre MANIFEST.md SHA256SUMS
    (cd "$b" && find apt/ubuntu charte amorces -type f)
    for nom in $(images_du_role "$role"); do printf 'images/%s.tar.zst\n' "$nom"; done
    for alias in $(modeles_du_role "$role"); do (cd "$b" && find "models/$role/$alias" -type f); done
    [[ "$role" == forge && -d "$b/mirror" ]] && (cd "$b" && find mirror -type f)
  } > "$liste"
  etape "Copie du bundle $role vers la VM"
  # Modèles retirés du profil : effacés de la copie dans la VM, le reste n’est pas retransféré.
  ssh_vm "$3" "rm -rf hibou-bundle/models/*.gguf; mkdir -p hibou-bundle/models/$role && touch hibou-bundle/.partiel && cd hibou-bundle/models/$role && for d in *; do case ' $(modeles_du_role "$role" | tr '\n' ' ') ' in *\" \$d \"*) ;; *) rm -rf \"\$d\" ;; esac; done"
  rsync -a --info=progress2 -e "ssh -i /root/.ssh/hibou_ed25519 -o BatchMode=yes -o UserKnownHostsFile=/root/.ssh/hibou_known_hosts" \
    --files-from="$liste" "$b/" "hibou@$3:hibou-bundle/"
  rm -f "$liste"
  fait "Copié dans ~hibou/hibou-bundle."
}

dans_la_vm() {  # adresse rôle phase
  printf '%s\n' "$PHRASE" | ssh_vm "$1" \
    "sudo HIBOU_SAUTER='${HIBOU_SAUTER:-}' HIBOU_MAJ='${HIBOU_MAJ:-}' HIBOU_PHASE='$3' HIBOU_SANS_VERIF=1 NO_COLOR='${NO_COLOR:-}' bash hibou-bundle/hibou installer $2 hibou-bundle" \
    || erreur "L’installation dans la VM s’est arrêtée." "Les messages ci-dessus disent pourquoi. Relance la même commande : les étapes déjà faites sont rapides."
}

sur_proxmox() {  # rôle bundle
  local role="$1" b="$2" ip; ip="HIBOU_IP_${role^^}"; ip="${!ip}"
  if [[ "$role" == noeud ]]; then
    saute verif || verifier "$b"; secrets "$b"
    install -d -m 700 /root/.ssh; base64 -d <<< "$HIBOU_SSH_VM_B64" > /root/.ssh/hibou_ed25519; chmod 600 /root/.ssh/hibou_ed25519
    preparer_hote "$b" noeud; realm_proxmox; return
  fi
  local etapes=("verif:Vérification des empreintes" "hote:Préparation de l’hôte Proxmox" "vm:Création de la VM" "copie:Copie du bundle dans la VM"
                "socle:Socle de la VM (paquets, pilote, Docker)" "images:Chargement des images" "modeles:Copie des modèles" "config:Configuration et démarrage")
  [[ "$role" == forge ]] && etapes=("${etapes[@]/#modeles:*}") && etapes+=("comptes:Comptes, dépôts et connexion unique" "miroir:Import du miroir de dépendances")
  [[ "$role" != forge ]] && etapes+=("redemarrage:Redémarrage de la VM et contrôle des GPU" "evaluation:Évaluation des modèles depuis forge")
  # Mise à jour : ni préparation de l’hôte, ni création de VM, ni comptes Forgejo (leurs secrets ne changent pas).
  [[ -n "${HIBOU_MAJ:-}" ]] && etapes=("${etapes[@]/#hote:*}") && etapes=("${etapes[@]/#vm:*}") && etapes=("${etapes[@]/#comptes:*}")
  local e propre=(); for e in "${etapes[@]}"; do [[ -n "$e" ]] && propre+=("$e"); done
  proposer_sauts "${propre[@]}"
  saute verif || verifier "$b"
  secrets "$b"
  install -d -m 700 /root/.ssh
  base64 -d <<< "$HIBOU_SSH_VM_B64" > /root/.ssh/hibou_ed25519; chmod 600 /root/.ssh/hibou_ed25519
  if [[ -n "${HIBOU_MAJ:-}" ]]; then
    qm status "$(v=HIBOU_VMID_${role^^}; echo "${!v}")" >/dev/null 2>&1 || erreur "La VM $role n’existe pas." "Lance d’abord « hibou installer $role »."
    qm set "$(v=HIBOU_VMID_${role^^}; echo "${!v}")" --agent enabled=1,fstrim_cloned_disks=1 >/dev/null   # pris en compte au prochain démarrage
    [[ "$role" == forge ]] || { gpu_vfio; cartes_vm "$role"; }
  else
    if ! saute hote; then preparer_hote "$b" "$role"; [[ "$role" == forge ]] || { etape "Cartes NVIDIA pour la VM"; gpu_vfio; }; fi
    if ! saute vm; then ssh-keygen -R "$ip" -f /root/.ssh/hibou_known_hosts >/dev/null 2>&1 || true; creer_vm "$role" "$b"; fi
  fi
  etape "Attente de la VM ($ip)"; attendre_ssh "$ip"; fait "La VM répond."
  saute copie || copier_vers_vm "$role" "$b" "$ip"
  if [[ "$role" == forge ]]; then dans_la_vm "$ip" forge ""; [[ -n "${HIBOU_MAJ:-}" ]] || realm_proxmox; return; fi
  dans_la_vm "$ip" "$role" socle
  # En mise à jour, on ne redémarre que si le noyau ou le pilote ont changé.
  if [[ -n "${HIBOU_MAJ:-}" ]] && ! ssh_vm "$ip" 'test -f /var/run/reboot-required'; then HIBOU_SAUTER+=",redemarrage"; fi
  if ! saute redemarrage; then
    etape "Redémarrage de la VM sur le pilote NVIDIA"
    ssh_vm "$ip" 'sudo systemctl reboot' || true; sleep 20; attendre_ssh "$ip"
    ssh_vm "$ip" nvidia-smi -L || erreur "La VM ne voit pas ses cartes." "Dans la VM : sudo dmesg | grep -i nvidia. Sur l’hôte : dmesg | grep -i vfio."
  fi
  dans_la_vm "$ip" "$role" suite
  [[ -n "${HIBOU_MAJ:-}" ]] || realm_proxmox
  if ssh_vm "$ip" 'for i in $(seq 1 60); do curl -fsS localhost:8080/health >/dev/null && exit 0; sleep 5; done; exit 1'; then
    fait "API du serveur $role en ligne."
    if ! saute evaluation; then
      ssh_vm "$HIBOU_IP_FORGE" "sudo systemd-run --unit hibou-eval-$role --collect -E NO_COLOR=1 /usr/local/lib/hibou/hibou evaluer $role /usr/local/lib/hibou" >/dev/null 2>&1 \
        && note "Évaluation lancée sur forge (20 à 60 min) : sudo journalctl -fu hibou-eval-$role, puis le tableau « Évaluation » de Grafana." \
        || note "Évaluation non lancée (forge injoignable). Sur forge : sudo /usr/local/lib/hibou/hibou evaluer $role /usr/local/lib/hibou"
    fi
  else
    note "L’API ne répond pas encore. Dans la VM : docker compose -f /srv/hibou/compose.yaml logs --tail 50"
  fi
}

# ─── Rôles dans les VM ──────────────────────────────────────────────────────
indices_gpu() {  # rôle → IDX_LLM, IDX_IMG (listes JSON de chaînes)
  local lignes=() l idx nom llm=() img=()
  mapfile -t lignes < <(nvidia-smi --query-gpu=index,name --format=csv,noheader)
  (( ${#lignes[@]} )) || erreur "nvidia-smi ne voit aucune carte." "Redémarre la VM, puis relance avec HIBOU_SAUTER=socle."
  if [[ "$1" == doc && "${HIBOU_IMG_NB:-0}" != 0 ]]; then
    if [[ "$HIBOU_IMG_GPU" == "$HIBOU_DOC_GPU" ]]; then img=("${lignes[-1]%%,*}")
    else
      for l in "${lignes[@]}"; do
        idx="${l%%,*}"; nom="${l#*, }"
        [[ " $nom " =~ [[:space:]]${HIBOU_IMG_GPU}[[:space:]] ]] && { img=("$idx"); break; }
      done
      (( ${#img[@]} )) || erreur "Je ne trouve pas la carte $HIBOU_IMG_GPU." "Cartes vues : ${lignes[*]}"
    fi
  fi
  for l in "${lignes[@]}"; do idx="${l%%,*}"; [[ " ${img[*]} " == *" $idx "* ]] || llm+=("$idx"); done
  IDX_LLM=$(printf '"%s",' "${llm[@]}"); IDX_LLM="[${IDX_LLM%,}]"
  IDX_IMG=$(printf '"%s",' "${img[@]}"); IDX_IMG="[${IDX_IMG%,}]"
  NB_LLM=${#llm[@]}
}

config_llama_swap() {  # rôle
  local n="HIBOU_PROFIL_${1^^}" ligne alias ctx args base split=""
  profil "$1" "${!n}"
  if (( NB_LLM > 1 )); then split="--split-mode layer --tensor-split $(printf '1,%.0s' $(seq "$NB_LLM") | sed 's/,$//')"; fi
  {
    echo "# Généré par Hibou $VERSION_HIBOU : un utilisateur à la fois par modèle (-np 1), tout le contexte pour lui."
    echo "healthCheckTimeout: 900"
    echo "models:"
    for ligne in "${MODELES_ROLE[@]}"; do
      IFS='|' read -r alias _ _ ctx args <<< "$ligne"
      servi "$args" || continue
      # shellcheck disable=SC2059
      [[ "$args" == *@ebauche* ]] && args="${args/@ebauche/$(printf -- "$ARGS_EBAUCHE" "$(gguf ebauche)")}"
      base="/app/llama-server --port \${PORT} -m /models/$(gguf "$alias")"
      [[ -n "$(mmproj "$alias")" ]] && base+=" --mmproj /models/$(mmproj "$alias")"
      if [[ "$args" == *--embedding* ]]; then base+=" -c $ctx $args"
      else base+=" -ngl 99 $split -c $ctx -np 1 -fa on -ctk q8_0 -ctv q8_0 --jinja $args"; fi
      printf '  %s:\n    cmd: %s\n    ttl: 0\n' "$alias" "${base% }"
    done
    printf 'groups:\n%s\n' "$GROUPES"
  } > /srv/hibou/llama-swap.yaml
}

config_priorite() {  # rôle : clés et rangs des utilisateurs, services d’Open WebUI et OpenCode
  local u nom mail mdp eq k rang=0 rang_dev=""
  local cles="{}" courriels="{}"
  for u in "${HIBOU_UTILISATEURS[@]}"; do
    IFS='|' read -r nom mail mdp eq k <<< "$u"
    cles=$(jq -c --arg k "$k" --arg n "$nom" --argjson r "$rang" '. + {($k): {nom: $n, rang: $r}}' <<< "$cles")
    courriels=$(jq -c --arg m "$mail" --arg n "$nom" --argjson r "$rang" '. + {($m): {nom: $n, rang: $r}}' <<< "$courriels")
    [[ -z "$rang_dev" && ",$eq," == *,dev,* ]] && rang_dev=$rang
    rang=$((rang + 1))
  done
  jq -n --argjson cles "$cles" --argjson courriels "$courriels" \
    --arg w "$HIBOU_CLE_WEBUI" --arg o "$HIBOU_CLE_OPENCODE" --argjson rd "${rang_dev:-$rang}" --argjson dernier "$rang" \
    --argjson ctx "$(for l in "${MODELES_ROLE[@]}"; do IFS='|' read -r a _ _ c x <<< "$l"; servi "$x" || continue; printf '%s\n%s\n' "$a" "$c"; done | jq -Rn '[inputs] | [range(0; length; 2) as $i | {(.[$i]): (.[$i+1] | tonumber)}] | add')" \
    --arg r "${HIBOU_CLE_RELECTEUR:-$HIBOU_CLE_WEBUI}" \
    '{cles: $cles, courriels: $courriels, contextes: $ctx, services: {($w): {nom: "open-webui", rang: $dernier}, ($r): {nom: "relecteur", rang: $dernier}, ($o): {nom: "opencode", rang: $rd}}}' \
    > /srv/hibou/priorite.json
  chmod 600 /srv/hibou/priorite.json
}

# Charge le modèle avec son ébauche ; si llama-server refuse la paire, on retire l’ébauche plutôt que de casser le modèle.
verifier_speculatif() {
  grep -q -- ' -md ' /srv/hibou/llama-swap.yaml || return 0
  local modele; modele=$(grep -B1 -- ' -md ' /srv/hibou/llama-swap.yaml | grep -oE '^  [^ :]+' | tr -d ' ' | head -1)
  etape "Décodage spéculatif : essai de $modele avec son ébauche"
  local corps; corps=$(jq -nc --arg m "$modele" '{model:$m,max_tokens:16,messages:[{role:"user",content:"Écris une fonction Python qui additionne deux nombres."}]}')
  local i
  for i in $(seq 1 30); do curl -fsS localhost:8080/health >/dev/null 2>&1 && break; sleep 2; done
  if curl -fsS -m 900 localhost:8080/v1/chat/completions -H "Authorization: Bearer $HIBOU_CLE_WEBUI" -H 'Content-Type: application/json' -d "$corps" | jq -e '.choices[0]' >/dev/null 2>&1; then
    fait "$modele répond avec son ébauche. Le gain se lit dans Grafana (Génération, tokens/s) et dans l’évaluation."
  else
    sed -i -E 's# -md /models/[^ ]+ -ngld 99 --draft-max [0-9]+ --draft-min [0-9]+##' /srv/hibou/llama-swap.yaml
    (cd /srv/hibou && docker compose restart llama-swap >/dev/null)
    note "llama-server refuse l’ébauche pour $modele : retirée, le modèle tourne sans. Journal : docker compose -f /srv/hibou/compose.yaml logs llama-swap"
  fi
}

installer_gpu() {  # rôle bundle
  local role="$1" b="$2"
  local apt_e; apt_e=$(sha256sum "$b/apt/ubuntu/Packages.gz" | cut -c1-64)
  if [[ -n "${HIBOU_MAJ:-}" && "$(cat /srv/hibou/etat/apt 2>/dev/null)" == "$apt_e" ]]; then HIBOU_SAUTER+=",socle"; note "Paquets inchangés : socle sauté."; fi
  if [[ "${HIBOU_PHASE:-}" != suite ]] && ! saute socle; then
    etape "Pilote NVIDIA $NVIDIA_VERSION, Docker, NVIDIA Container Toolkit"
    source_locale "$b/apt/ubuntu"
    apt_hibou $PAQUETS_UBUNTU $PAQUETS_GPU
    agrandir_systeme
    verifier_dkms
    docker_nvidia
    client_reseau
    pare_feu
    install -d /srv/hibou/etat; echo "$apt_e" > /srv/hibou/etat/apt
    fait "Socle installé."
  fi
  [[ "${HIBOU_PHASE:-}" == socle ]] && return 0
  nvidia-smi >/dev/null 2>&1 || erreur "Le pilote NVIDIA n’est pas chargé." "Redémarre la VM, puis relance avec HIBOU_SAUTER=socle."
  saute images  || { etape "Images";  charger_images "$b" "$role"; }
  saute modeles || { etape "Modèles"; copier_modeles "$b" "$role"; }
  saute config && return 0
  etape "Configuration"
  install -d /srv/hibou /srv/hibou/metriques
  indices_gpu "$role"
  config_llama_swap "$role"
  config_priorite
  local comfy=""
  if [[ "$role" == doc && "${HIBOU_IMG_NB:-0}" != 0 ]]; then
    local args; args=$(modele_image "$HIBOU_IMG_GO" | cut -d'|' -f4)
    comfy="
  comfyui:
    image: hibou/comfyui:actuel
    restart: unless-stopped
    command: [${args:+\"$args\"}]
    ports: [\"8188:8188\"]
    volumes: [\"/srv/models/comfy:/opt/comfyui/models/checkpoints:ro\", \"comfy-sortie:/opt/comfyui/output\"]
    deploy: { resources: { reservations: { devices: [{ driver: nvidia, device_ids: $IDX_IMG, capabilities: [gpu] }] } } }
    networks: [externe]"
  fi
  cat > /srv/hibou/compose.yaml <<EOF
name: hibou-$role
services:
  llama-swap:
    image: ${IMAGES[llama-swap]}
    restart: unless-stopped
    volumes: ["/srv/models:/models:ro", "./llama-swap.yaml:/app/config.yaml:ro"]
    deploy: { resources: { reservations: { devices: [{ driver: nvidia, device_ids: $IDX_LLM, capabilities: [gpu] }] } } }
    networks: [interne]
  priorite:
    image: hibou/priorite:actuel
    restart: unless-stopped
    environment: { AMONT: "http://llama-swap:8080" }
    volumes: ["./priorite.json:/etc/hibou/priorite.json:ro"]
    ports: ["8080:8080"]
    networks: [interne, externe]$comfy$(exportateurs)
networks:
  interne: { internal: true }
  externe: {}
volumes: { comfy-sortie: {} }
EOF
  service_demarrage /srv/hibou
  if [[ -n "${HIBOU_MAJ:-}" ]]; then demarrer /srv/hibou --force-recreate; else demarrer /srv/hibou; fi
  verifier_speculatif
  fait "Serveur $role démarré : $NB_LLM carte(s) pour le LLM, modèle principal $PRINCIPAL. API via https://llm-$role.$DOMAINE"
}

