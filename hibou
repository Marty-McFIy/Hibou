LOCALES="opencode docs-builder priorite comfyui miroir relecteur"   # images construites sur la machine connectée
# OpenCode : version figée dans versions.lock au premier bundle (dernière publiée sur npm à ce moment-là).
COMFY_BASE="pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime"   # à vérifier : CUDA 12.8 couvre Turing, Ampere, Ada et Blackwell
declare -A ROLE_IMAGES=(
