CAPACITE_SUPPORT_GO="${HIBOU_SUPPORT_GO:-512}"

# Cartes proposées au menu : nom tel que nvidia-smi l’affiche | mémoire (Go).
GPUS=("RTX 6000 Ada|48" "RTX PRO 6000 Blackwell|96" "L40S|48" "RTX A6000|48" "RTX 5000 Ada|32"
      "RTX 4000 Ada|20" "RTX A4000|16" "RTX A2000 12GB|12" "Quadro RTX 4000|8" "RTX A400|4")

# ─── Profils de modèles ─────────────────────────────────────────────────────
# alias|dépôt Hugging Face|motifs|contexte|arguments llama-server
# Un seul utilisateur par serveur : -np 1 donne tout le contexte à la requête en cours,
# et le cache KV en q8_0 divise sa taille par deux. Tailles approchées, à valider avec hibou-eval.
PROFILS_DEV=("≥ 90 Go : Qwen3-Coder-Next Q6 (256k) ou Qwen3.8 27B Q8 (128k), complétion 7B toujours chargée"
             "≥ 48 Go : Qwen3-Coder-Next Q4 (64k) ou Qwen3.8 27B Q8 (128k) + complétion 7B"
             "≥ 24 Go : Qwen3.8 27B Q4 (64k) + complétion 3B"
             "≥ 12 Go : Qwen3.5 9B Q4 (64k) + complétion 1.5B"
             "≥ 4 Go : Qwen3.5 4B Q4 (16k) + complétion 1.5B")
PROFILS_DEV_GO=(90 48 24 12 4)
PROFILS_DOC=("≥ 48 Go : Gemma 4 26B Q8 (128k) ou Qwen3.8 27B Q8 (128k), vision, embeddings"
             "≥ 24 Go : Gemma 4 26B Q6 (64k) ou Qwen3.8 27B Q4 (32k), vision, embeddings"
             "≥ 12 Go : Qwen3.5 9B Q4 (32k), embeddings"
             "≥ 4 Go : Qwen3.5 4B Q4 (8k), vision, embeddings sur le processeur")
PROFILS_DOC_GO=(48 24 12 4)

profil() {  # rôle numéro → MODELES_ROLE, GROUPES, PRINCIPAL
  local emb="qwen3-embedding|Qwen/Qwen3-Embedding-0.6B-GGUF|*Q8_0*|8192|-ngl 0 --embedding --pooling last"
  local rag="  rag: { persistent: true, swap: false, exclusive: false, members: [qwen3-embedding] }"
  case "$1:$2" in
    dev:1) MODELES_ROLE=(
        "qwen3-coder-next|unsloth/Qwen3-Coder-Next-GGUF|*UD-Q6_K_XL*|262144|--cache-reuse 256"
        "qwen3.8-27b|unsloth/Qwen3.8-27B-GGUF|*UD-Q8_K_XL*,*mmproj*F16*|131072|--cache-reuse 256"
        "fim|Qwen/Qwen2.5-Coder-7B-Instruct-GGUF|*q8_0*|16384|")
      GROUPES="  principal: { swap: true, exclusive: false, members: [qwen3-coder-next, qwen3.8-27b] }
  completion: { persistent: true, swap: false, exclusive: false, members: [fim] }" ;;
    dev:2) MODELES_ROLE=(
        "qwen3-coder-next|unsloth/Qwen3-Coder-Next-GGUF|*UD-Q4_K_XL*|65536|--cache-reuse 256"
        "qwen3.8-27b|unsloth/Qwen3.8-27B-GGUF|*UD-Q8_K_XL*,*mmproj*F16*|131072|--cache-reuse 256"
        "fim|Qwen/Qwen2.5-Coder-7B-Instruct-GGUF|*q8_0*|8192|")
      GROUPES="  code: { swap: false, exclusive: true, members: [qwen3.8-27b, fim] }" ;;
    dev:3) MODELES_ROLE=(
        "qwen3.8-27b|unsloth/Qwen3.8-27B-GGUF|*UD-Q4_K_XL*,*mmproj*F16*|65536|--cache-reuse 256"
        "fim|ggml-org/Qwen2.5-Coder-3B-Q8_0-GGUF|*q8_0*|8192|")
      GROUPES="  code: { swap: false, exclusive: true, members: [qwen3.8-27b, fim] }" ;;
    dev:4) MODELES_ROLE=(
        "qwen3.5-9b|unsloth/Qwen3.5-9B-GGUF|*UD-Q4_K_XL*|65536|--cache-reuse 256"
        "fim|ggml-org/Qwen2.5-Coder-1.5B-Q8_0-GGUF|*q8_0*|8192|")
      GROUPES="  code: { swap: false, exclusive: true, members: [qwen3.5-9b, fim] }" ;;
    dev:5) MODELES_ROLE=(
        "qwen3.5-4b|unsloth/Qwen3.5-4B-GGUF|*UD-Q4_K_XL*|16384|--cache-reuse 256"
        "fim|ggml-org/Qwen2.5-Coder-1.5B-Q8_0-GGUF|*q8_0*|4096|")
      GROUPES="  code: { swap: false, exclusive: true, members: [qwen3.5-4b, fim] }" ;;
    doc:1) MODELES_ROLE=(
        "gemma-4-26b|unsloth/gemma-4-26B-A4B-it-GGUF|*UD-Q8_K_XL*,*mmproj*F16*|131072|"
        "qwen3.8-27b|unsloth/Qwen3.8-27B-GGUF|*UD-Q8_K_XL*,*mmproj*F16*|131072|" "$emb")
      GROUPES="$rag" ;;
    doc:2) MODELES_ROLE=(
        "gemma-4-26b|unsloth/gemma-4-26B-A4B-it-GGUF|*UD-Q6_K_XL*,*mmproj*F16*|65536|"
        "qwen3.8-27b|unsloth/Qwen3.8-27B-GGUF|*UD-Q4_K_XL*,*mmproj*F16*|32768|" "$emb")
      GROUPES="$rag" ;;
    doc:3) MODELES_ROLE=("qwen3.5-9b|unsloth/Qwen3.5-9B-GGUF|*UD-Q4_K_XL*|32768|" "$emb")
      GROUPES="$rag" ;;
    doc:4) MODELES_ROLE=("qwen3.5-4b|unsloth/Qwen3.5-4B-GGUF|*UD-Q4_K_XL*,*mmproj*F16*|8192|" "$emb")
      GROUPES="$rag" ;;
    *) erreur "Profil inconnu : $1 $2." ;;
  esac
  PRINCIPAL="${MODELES_ROLE[0]%%|*}"
  # Décodage spéculatif sur dev : un petit modèle de la même famille propose les tokens, le 27B dense les valide.
  # Le projecteur de vision est retiré du 27B de dev (llama-server ne combine pas vision et ébauche) ; la vision reste sur doc.
  if [[ "$1" == dev && "${HIBOU_SPECULATIF:-0}" == 1 ]]; then
    local i a d m c x
    for i in "${!MODELES_ROLE[@]}"; do
      IFS='|' read -r a d m c x <<< "${MODELES_ROLE[i]}"
      [[ "$a" == qwen3.8-27b ]] && MODELES_ROLE[i]="$a|$d|${m%,\*mmproj*}|$c|$x @ebauche"
    done
    MODELES_ROLE+=("ebauche|$EBAUCHE_DEPOT|$EBAUCHE_MOTIF|0|@fichier")
  fi
}
# Modèle d’ébauche : même tokenizer que la famille Qwen3.x. À vérifier au premier bundle ; si llama-server
# refuse la paire, l’installation retire l’ébauche d’elle-même (verifier_speculatif).
EBAUCHE_DEPOT="unsloth/Qwen3.5-0.8B-GGUF"
EBAUCHE_MOTIF="*Q8_0*"
ARGS_EBAUCHE="-md /models/%s -ngld 99 --draft-max 16 --draft-min 1"
servi() { [[ "$1" != *@fichier* ]]; }   # les fichiers d’ébauche ne sont pas des modèles exposés

# Génération d’images : checkpoint selon la mémoire de la carte dédiée.
modele_image() {  # Go → "dépôt|fichier|taille|arguments ComfyUI"
  if (( $1 >= 8 )); then echo "stabilityai/stable-diffusion-xl-base-1.0|sd_xl_base_1.0.safetensors|1024x1024|"
  else echo "stable-diffusion-v1-5/stable-diffusion-v1-5|v1-5-pruned-emaonly.safetensors|512x512|--lowvram"; fi
}

images_du_role() {
  local l="${ROLE_IMAGES[$1]}"
  [[ "$1" == doc && "${HIBOU_IMG_NB:-0}" != 0 ]] && l+=" comfyui"
  [[ "$1" == forge && "${HIBOU_MIROIR:-0}" == 1 ]] && l+=" miroir"
  echo "$l"
}
modeles_du_role() {
  local n="HIBOU_PROFIL_${1^^}" ligne
  [[ "$1" == forge ]] && return 0
  profil "$1" "${!n}"
  for ligne in "${MODELES_ROLE[@]}"; do echo "${ligne%%|*}"; done
  [[ "$1" == doc && "${HIBOU_IMG_NB:-0}" != 0 ]] && echo comfy
  return 0
}

# ─── Charte Hibou dans le terminal ──────────────────────────────────────────
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  # Jetons de hibou-jetons.css : ambre F2B544, brume E9E4D8, pierre 8A93A6, danger F0876B, succès 5CC8B8.
  AMBRE=$'\e[38;2;242;181;68m'; BRUME=$'\e[38;2;233;228;216m'
  PIERRE=$'\e[38;2;138;147;166m'; DANGER=$'\e[38;2;240;135;107m'
  SUCCES=$'\e[38;2;92;200;184m'; GRAS=$'\e[1m'; FIN=$'\e[0m'
else
  AMBRE=""; BRUME=""; PIERRE=""; DANGER=""; SUCCES=""; GRAS=""; FIN=""
fi

symbole() {
  local l1='                  , _ ,'
  local l3="                /'\` ' \`'\\"
  local l4="                |'''''''|"
  local l5="                |\\\\'''//|"
  local l6='                   """'
  printf '%s%s%s\n' "$BRUME" "$l1" "$FIN"
  printf '%s                 ( %so%s %so%s )%s     %sHibou%s %s%s%s\n' "$BRUME" "$AMBRE" "$BRUME" "$AMBRE" "$BRUME" "$FIN" "$GRAS$BRUME" "$FIN" "$PIERRE" "$VERSION_HIBOU" "$FIN"
  printf '%s%s%s     %sL’IA qui veille chez vous.%s\n' "$BRUME" "$l3" "$FIN" "$PIERRE" "$FIN"
  printf '%s%s%s\n' "$BRUME" "$l4" "$FIN"
  printf '%s%s%s\n' "$BRUME" "$l5" "$FIN"
  printf '%s%s%s\n\n' "$BRUME" "$l6" "$FIN"
}
etape()  { printf '\n%s%s%s %s%s%s\n' "$AMBRE" "▸" "$FIN" "$GRAS$BRUME" "$*" "$FIN"; }
dire()   { printf '  %s%s%s\n' "$BRUME" "$*" "$FIN"; }
note()   { printf '  %s%s%s\n' "$PIERRE" "$*" "$FIN"; }
fait()   { printf '  %sFait%s  %s\n' "$SUCCES" "$FIN" "$*"; }
erreur() { printf '\n  %sErreur%s  %s\n' "$DANGER" "$FIN" "$1" >&2; [[ -n "${2:-}" ]] && printf '  %s%s%s\n' "$PIERRE" "$2" "$FIN" >&2; exit 1; }

exiger_root() { [[ $EUID -eq 0 ]] || erreur "Il me faut les droits administrateur." "Relance avec sudo."; }
exiger_cmd()  { command -v "$1" >/dev/null || erreur "La commande $1 est absente." "${2:-Installe-la puis relance.}"; }
cle() { head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 40; }

# ─── Questions (machine connectée uniquement) ───────────────────────────────
demander() {  # variable question défaut [regex]
  local _r
  while :; do
    read -rp "  $2${3:+ [$3]} : " _r; _r="${_r:-$3}"
    [[ -z "${4:-}" || "$_r" =~ $4 ]] && break
    note "Valeur refusée."
  done
  printf -v "$1" '%s' "$_r"
}
demander_mdp() {  # variable libellé
  local a b
  while :; do
    read -rsp "  $2 : " a; echo; read -rsp "  Confirme : " b; echo
    [[ "$a" == "$b" ]] || { note "Les deux saisies diffèrent."; continue; }
    (( ${#a} >= 12 )) || { note "12 caractères minimum."; continue; }
    # Les mots de passe passent dans du JSON et des fichiers d’environnement.
    [[ "$a" != *[\'\"\\\$\`\ ]* ]] || { note "Évite les espaces et ' \" \\ \$ \`."; continue; }
    printf -v "$1" '%s' "$a"; return
  done
}
choisir() {  # variable question défaut options...
  local _i=1 _o _r _n=$(($# - 3))
  printf '  %s\n' "$2"
  for _o in "${@:4}"; do printf '    %s%d%s  %s\n' "$AMBRE" "$_i" "$FIN" "$_o"; _i=$((_i + 1)); done
  while :; do read -rp "  Choix [$3] : " _r; _r="${_r:-$3}"; [[ "$_r" =~ ^[0-9]+$ ]] && (( _r >= 1 && _r <= _n )) && break; done
  printf -v "$1" '%s' "$_r"
}
RE_IP='^([0-9]{1,3}\.){3}[0-9]{1,3}$'

choisir_gpu() {  # préfixe libellé → <préfixe>_GPU, _GO, _NB
  local libs=() g c nom go nb
  for g in "${GPUS[@]}"; do libs+=("${g%|*} (${g#*|} Go)"); done
  choisir c "$2 : quelle carte ?" 1 "${libs[@]}" "Autre"
  if (( c <= ${#GPUS[@]} )); then nom="${GPUS[c-1]%|*}"; go="${GPUS[c-1]#*|}"
  else demander nom "Nom exact affiché par nvidia-smi (sans « NVIDIA »)" "" '.+'; demander go "Mémoire par carte (Go)" "" '^[0-9]+$'; fi
  demander nb "Nombre de cartes" 1 '^[1-8]$'
  printf -v "${1}_GPU" '%s' "$nom"; printf -v "${1}_GO" '%s' "$go"; printf -v "${1}_NB" '%s' "$nb"
}
choisir_profil() {  # rôle Go_disponibles → HIBOU_PROFIL_<RÔLE>
  local -n libs="PROFILS_${1^^}" seuils="PROFILS_${1^^}_GO"
  local i defaut=${#seuils[@]} p
  for i in "${!seuils[@]}"; do (( $2 >= seuils[i] )) && { defaut=$((i + 1)); break; }; done
  (( $2 >= seuils[-1] )) || note "Attention : $2 Go est sous le plus petit profil (${seuils[-1]} Go)."
  choisir p "Modèles du serveur $1 ($2 Go de mémoire GPU pour le LLM)" "$defaut" "${libs[@]}"
  printf -v "HIBOU_PROFIL_${1^^}" '%s' "$p"
}

listes_miroir() {  # dossier : modèles de listes, jamais écrasés
  install -d "$1"
  local f
  declare -A ex=(
    [requirements.txt]=$'# Paquets Python, syntaxe pip. Exemples :\n# requests\n# fastapi==0.115.*\n# -r autre-liste.txt\n'
    [npm-packages.txt]=$'# Paquets npm, nom ou nom@version. Exemples :\n# typescript\n# vite@6\n'
    [git-repos.txt]=$'# Dépôts git copiés dans l’organisation hibou. Exemple :\n# https://github.com/ggml-org/llama.cpp.git\n'
    [docker-images.txt]=$'# Images Docker copiées dans le registre de Forgejo. Exemples :\n# python:3.12-slim\n# postgres:17\n')
  for f in "${!ex[@]}"; do [[ -f "$1/$f" ]] || printf '%s' "${ex[$f]}" > "$1/$f"; done
}

choisir_materiel() {
  etape "Serveur dev"
  choisir_gpu DEV "Serveur dev"
  HIBOU_DEV_GPU="$DEV_GPU" HIBOU_DEV_GO="$DEV_GO" HIBOU_DEV_NB="$DEV_NB"
  choisir_profil dev $((DEV_GO * DEV_NB))
  HIBOU_SPECULATIF=0
  if (( HIBOU_PROFIL_DEV <= 3 )); then
    local sp; choisir sp "Décodage spéculatif pour Qwen3.8 27B (plus rapide en code ; sa vision passe sur doc) ?" 2 "Non" "Oui"
    HIBOU_SPECULATIF=$((sp - 1))
  fi

  etape "Serveur doc"
  choisir_gpu DOC "Serveur doc (LLM)"
  HIBOU_DOC_GPU="$DOC_GPU" HIBOU_DOC_GO="$DOC_GO" HIBOU_DOC_NB="$DOC_NB"
  local img; choisir img "Génération d’images (ComfyUI) sur une carte à part ?" 1 "Non" "Oui, une carte dédiée en plus" "Oui, en prenant une des cartes du LLM"
  HIBOU_IMG_NB=0 HIBOU_IMG_GPU="" HIBOU_IMG_GO=0
  case "$img" in
    2) choisir_gpu IMG "Carte d’images"; HIBOU_IMG_GPU="$IMG_GPU" HIBOU_IMG_GO="$IMG_GO" HIBOU_IMG_NB=1 ;;
    3) (( DOC_NB > 1 )) || erreur "Il faut au moins deux cartes pour en prendre une." "Relance et choisis une carte dédiée."
       HIBOU_IMG_GPU="$DOC_GPU" HIBOU_IMG_GO="$DOC_GO" HIBOU_IMG_NB=1; HIBOU_DOC_NB=$((DOC_NB - 1)) ;;
  esac
  (( HIBOU_IMG_NB == 0 || HIBOU_IMG_GO >= 8 )) || note "Moins de 8 Go : Stable Diffusion 1.5 en mode basse mémoire. Une RTX A2000 12 Go permet SDXL."
  choisir_profil doc $((HIBOU_DOC_GO * HIBOU_DOC_NB))
}

ecrire_config() {  # dossier
  local v
  { echo "# Réponses du menu Hibou $VERSION_HIBOU ($(date +%F)). Rien de secret ici."
    for v in DOMAINE RESEAU PASSERELLE PONT VLAN IP_FORGE IP_DOC IP_DEV IP_PVE_DOC IP_PVE_DEV IP_CLUSTER \
             VMID_FORGE VMID_DOC VMID_DEV DISQUE_FORGE DISQUE_DOC DISQUE_DEV RAM_FORGE CPU_FORGE STOCKAGE STOCKAGE_SAUVEGARDE \
             DEV_GPU DEV_GO DEV_NB DOC_GPU DOC_GO DOC_NB IMG_GPU IMG_GO IMG_NB PROFIL_DEV PROFIL_DOC SPECULATIF MIROIR PY_VERSIONS; do
      v="HIBOU_$v"; printf '%s=%q\n' "$v" "${!v:-}"
    done
  } > "$1/config.env"
}

configurer_bundle() {  # dossier
  local s="$1"
  if [[ -f "$s/config.env" && -f "$s/secrets.chiffre" ]]; then
    local garde; choisir garde "Ce bundle a déjà une configuration." 1 "La garder" "Changer seulement les cartes et les modèles" "Tout refaire"
    # shellcheck disable=SC1091
    [[ "$garde" == 1 ]] && { source "$s/config.env"; return 0; }   # sinon HIBOU_DOMAINE etc. restent vides
    if [[ "$garde" == 2 ]]; then
      # shellcheck disable=SC1091
      source "$s/config.env"; choisir_materiel; ecrire_config "$s"
      fait "Cartes et modèles mis à jour ; comptes, mots de passe et clés inchangés."; return 0
    fi
  fi
  etape "Réseau"
  demander HIBOU_DOMAINE "Domaine interne" "hibou.lan" '^[a-z0-9.-]+$'
  demander HIBOU_RESEAU "Réseau (CIDR)" "192.168.10.0/24" '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'
  demander HIBOU_PASSERELLE "Passerelle (vide s’il n’y en a pas)" "" '^(([0-9]{1,3}\.){3}[0-9]{1,3})?$'
  demander HIBOU_PONT "Pont Proxmox des VM" "vmbr0" '^[a-z0-9]+$'
  demander HIBOU_VLAN "VLAN des VM (vide = aucun)" "" '^[0-9]*$'
  demander HIBOU_IP_FORGE "Adresse de la VM forge (applications, sur le cluster)" "" "$RE_IP"
  demander HIBOU_IP_DOC "Adresse de la VM doc" "" "$RE_IP"
  demander HIBOU_IP_DEV "Adresse de la VM dev" "" "$RE_IP"
  demander HIBOU_IP_PVE_DOC "Adresse de l’hôte Proxmox R730 doc" "" "$RE_IP"
  demander HIBOU_IP_PVE_DEV "Adresse de l’hôte Proxmox R730 dev" "" "$RE_IP"
  demander HIBOU_IP_CLUSTER "Adresses des nœuds du cluster à superviser (séparées par des espaces)" "" '^[0-9. ]*$'

  etape "Machines virtuelles"
  demander HIBOU_VMID_FORGE "Numéro de la VM forge" 210 '^[0-9]+$'
  demander HIBOU_VMID_DOC "Numéro de la VM doc" 220 '^[0-9]+$'
  demander HIBOU_VMID_DEV "Numéro de la VM dev" 230 '^[0-9]+$'
  demander HIBOU_DISQUE_FORGE "Disque de forge (Go)" 200 '^[0-9]+$'
  demander HIBOU_DISQUE_DOC "Disque de doc (Go)" 400 '^[0-9]+$'
  demander HIBOU_DISQUE_DEV "Disque de dev (Go)" 600 '^[0-9]+$'
  demander HIBOU_RAM_FORGE "Mémoire de forge (Go)" 32 '^[0-9]+$'
  demander HIBOU_CPU_FORGE "Cœurs de forge" 8 '^[0-9]+$'
  note "doc et dev prennent toute la mémoire et tous les cœurs de leur R730, moins 16 Go et 4 fils pour Proxmox."
  demander HIBOU_STOCKAGE "Stockage Proxmox des disques (vide = celui qui a le plus de place)" "" '^[A-Za-z0-9_-]*$'
  note "Sauvegarde de forge obligatoire : comptes, dépôts, conversations, documentation, supervision."
  note "Choisis un stockage sur d’autres disques que la VM (Proxmox Backup Server, NFS, disque dédié)."
  demander HIBOU_STOCKAGE_SAUVEGARDE "Stockage Proxmox des sauvegardes de forge" "" '^[A-Za-z0-9_-]+$'

  choisir_materiel

  etape "Miroir de dépendances (pip, npm, git, images Docker)"
  note "Ces paquets sont copiés dans Forgejo pour développer sans Internet."
  local mir; choisir mir "Préparer un miroir ?" 2 "Non" "Oui"
  HIBOU_MIROIR=$((mir - 1)) HIBOU_PY_VERSIONS=""
  if (( HIBOU_MIROIR )); then
    demander HIBOU_PY_VERSIONS "Versions de Python à couvrir" "3.11 3.12 3.13" '^[0-9. ]+$'
    listes_miroir "$s/miroir.d"
    dire "Remplis les listes dans $s/miroir.d (une entrée par ligne), puis appuie sur Entrée."
    read -r _
  fi

  etape "Administrateur (Forgejo, Open WebUI, Grafana)"
  demander HIBOU_ADMIN_NOM "Identifiant" "hibou-admin" '^[a-z][a-z0-9-]{2,30}$'
  demander HIBOU_ADMIN_MAIL "Adresse électronique" "$HIBOU_ADMIN_NOM@$HIBOU_DOMAINE" '^[^@ ]+@[^@ ]+$'
  demander_mdp HIBOU_ADMIN_MDP "Mot de passe"
  demander_mdp HIBOU_VM_MDP "Mot de passe du compte « hibou » des VM (console Proxmox)"

  etape "Utilisateurs, du plus prioritaire au moins prioritaire"
  note "Si deux personnes interrogent le même serveur en même temps, la première de la liste passe devant."
  note "L’autre attend la fin de la réponse en cours, rien n’est interrompu."
  HIBOU_UTILISATEURS=()
  local nom mail eq mdp
  while :; do
    demander nom "Identifiant n° $(( ${#HIBOU_UTILISATEURS[@]} + 1 )) (vide pour terminer)" "" '^([a-z][a-z0-9-]{1,30})?$'
    if [[ -z "$nom" ]]; then (( ${#HIBOU_UTILISATEURS[@]} )) && break; note "Il faut au moins un utilisateur."; continue; fi
    demander mail "Adresse électronique de $nom" "$nom@$HIBOU_DOMAINE" '^[^@ ]+@[^@ ]+$'
    choisir eq "Serveurs de $nom" 3 "doc" "dev" "doc et dev"
    demander_mdp mdp "Mot de passe initial de $nom (à changer à la première connexion)"
    HIBOU_UTILISATEURS+=("$nom|${mail,,}|$mdp|$(case $eq in 1) echo doc;; 2) echo dev;; *) echo doc,dev;; esac)|$(cle)")
  done

  etape "Phrase de passe du bundle"
  note "Elle chiffre les mots de passe et les clés. Elle sera demandée une seule fois par installation."
  local phrase; demander_mdp phrase "Phrase de passe"

  ecrire_config "$s"

  local tmp; tmp=$(mktemp -d)
  ssh-keygen -q -t ed25519 -N '' -C "hibou@$HIBOU_DOMAINE" -f "$tmp/vm"
  ssh-keygen -q -t ed25519 -N '' -C "hibou-dev@$HIBOU_DOMAINE" -f "$tmp/agent"
  HIBOU_SSH_VM_B64=$(base64 -w0 < "$tmp/vm"); HIBOU_SSH_VM_PUB=$(cat "$tmp/vm.pub")
  HIBOU_SSH_AGENT_B64=$(base64 -w0 < "$tmp/agent")
  HIBOU_CLE_WEBUI=$(cle); HIBOU_CLE_OPENCODE=$(cle); HIBOU_CLE_RELECTEUR=$(cle)
  rm -rf "$tmp"
  # declare -g : les variables restent globales quand « secrets » les relit dans une fonction.
  declare -p HIBOU_ADMIN_NOM HIBOU_ADMIN_MAIL HIBOU_ADMIN_MDP HIBOU_VM_MDP HIBOU_UTILISATEURS \
             HIBOU_SSH_VM_B64 HIBOU_SSH_VM_PUB HIBOU_SSH_AGENT_B64 HIBOU_CLE_WEBUI HIBOU_CLE_OPENCODE HIBOU_CLE_RELECTEUR \
    | sed -E 's/^declare -- /declare -g /; s/^declare -a /declare -ga /' \
    | openssl enc -aes-256-cbc -pbkdf2 -iter 600000 -salt -out "$s/secrets.chiffre" -pass fd:3 3<<<"$phrase"
  fait "Configuration enregistrée : config.env (clair) et secrets.chiffre (chiffré)."
  # shellcheck disable=SC1091
  source "$s/config.env"
}

# ─── Téléchargement (machine connectée) ─────────────────────────────────────
# HIBOU_PARTIES limite le téléchargement, ex. HIBOU_PARTIES=apt,extra pour ne refaire que les paquets.
# ─── Versions figées ────────────────────────────────────────────────────────
# versions.lock, dans le bundle : empreinte de chaque image, version d’OpenCode, commit de ComfyUI,
# révision de chaque modèle. Un nouveau bundle reprend ces versions ; seul HIBOU_ACTUALISER les change.
verrou_lire()  { awk -v n="$1" '$1==n {print $2}' "$SORTIE/versions.lock" 2>/dev/null; }
verrou_ecrire() {
  { grep -v "^$1 " "$SORTIE/versions.lock" 2>/dev/null || true; echo "$1 $2"; } | sort > "$SORTIE/versions.lock.tmp"
  mv "$SORTIE/versions.lock.tmp" "$SORTIE/versions.lock"
}
actualiser() {  # clé : vrai si pas encore figée, ou si l’utilisateur l’a demandé
  [[ -z "$(verrou_lire "$1")" || ",${HIBOU_ACTUALISER:-}," == *",tout,"* || ",${HIBOU_ACTUALISER:-}," == *",${1#*:},"* ]]
}
choisir_actualisation() {
  [[ -f "$SORTIE/versions.lock" && -z "${HIBOU_ACTUALISER+x}" && -t 0 ]] || return 0
  local a; choisir a "Versions des images, d’OpenCode, de ComfyUI et des modèles" 1 \
    "Garder celles du bundle précédent" "Tout actualiser" "Choisir ce qu’il faut actualiser"
  case "$a" in
    2) HIBOU_ACTUALISER=tout ;;
    3) note "Noms possibles : $(awk '{sub(/^[a-z]+:/,"",$1); print $1}' "$SORTIE/versions.lock" | sort -u | paste -sd' ')"
       demander HIBOU_ACTUALISER "Noms séparés par des virgules" "" '^[A-Za-z0-9.,_-]*$' ;;
    *) HIBOU_ACTUALISER="" ;;
  esac
}

veut() { [[ ",${HIBOU_PARTIES:-apt,extra,images,modeles,miroir}," == *",$1,"* ]]; }

# Une image dont l’identifiant n’a pas changé n’est pas réenregistrée : le fichier du bundle reste identique,
# rien ne repart vers les VM à la mise à jour.
enregistrer() {  # nom référence identifiant
  local f="$SORTIE/images/$1.tar.zst" avant=""
  # Premier passage : pas de digests.precedent. awk échouerait et set -e arrêterait le script sans message.
  [[ -f "$SORTIE/images/digests.precedent" ]] && avant=$(awk -v n="$1" '$1==n {print $3}' "$SORTIE/images/digests.precedent")
  if [[ -f "$f" && "$avant" == "$3" ]]; then note "$1 inchangée"
  else docker save "$2" | zstd -q -f -T0 -10 -o "$f"; fi
  echo "$1 $2 $3" >> "$SORTIE/images/digests.txt"
}
construire() {  # nom ; Dockerfile dans $CTX
  # Identifiant = empreinte des entrées (contexte + image de base), pas l'Id de construction :
  # le cache Docker n'est pas garanti, et une reconstruction identique changerait l'Id.
  local base cle
  base=$(awk 'toupper($1)=="FROM" {print $2; exit}' "$CTX/Dockerfile")
  docker image inspect "$base" >/dev/null 2>&1 || docker pull -q "$base" >/dev/null
  cle="sha256:$( { (cd "$CTX" && find . -type f -print0 | sort -z | xargs -0 sha256sum); docker image inspect -f '{{.Id}}' "$base"; } | sha256sum | cut -d' ' -f1)"
  if [[ -f "$SORTIE/images/$1.tar.zst" && -f "$SORTIE/images/digests.precedent" ]] \
     && awk -v n="$1" -v c="$cle" '$1==n && $3==c {t=1} END {exit !t}' "$SORTIE/images/digests.precedent"; then
    enregistrer "$1" "hibou/$1:actuel" "$cle"; return
  fi
  docker build -q -t "hibou/$1:actuel" "$CTX" >/dev/null
  enregistrer "$1" "hibou/$1:actuel" "$cle"
}

source_priorite() {
cat <<'PY'
"""hibou-priorite : file d’attente par priorité devant llama-swap.

Une requête de génération à la fois par modèle. Quand une place se libère,
l’utilisateur le mieux classé passe ; à rang égal, le premier arrivé.
Rien n’est interrompu : la réponse en cours va à son terme.
"""
import asyncio, heapq, itertools, json, os, re, time
from collections import defaultdict

GARDE = ("/v1/chat/completions", "/v1/completions", "/v1/responses", "/v1/messages", "/completion", "/infill")
compteur = itertools.count()


class Porte:
    def __init__(self):
        self.occupe, self.file = False, []

    async def prendre(self, rang):
        if not self.occupe and not self.file:
            self.occupe = True
            return
        fut = asyncio.get_running_loop().create_future()
        heapq.heappush(self.file, (rang, next(compteur), fut))
        try:
            await fut
        except asyncio.CancelledError:
            if fut.done() and not fut.cancelled():  # la place venait d’être donnée : on la rend
                self.rendre()
            raise

    def rendre(self):
        while self.file:
            fut = heapq.heappop(self.file)[2]
            if not fut.done():
                fut.set_result(None)
                return
        self.occupe = False


TIMINGS = re.compile(rb'"timings"\s*:\s*(\{[^{}]*\})')


def lire_timings(fin):
    """Dernier objet « timings » de llama-server dans la fin d’une réponse (JSON ou flux SSE)."""
    trouves = TIMINGS.findall(fin)
    if not trouves:
        return None
    try:
        return json.loads(trouves[-1])
    except ValueError:
        return None


class Mesures:
    """Compteurs au format Prometheus, écrits à la main : pas de dépendance en plus."""

    def __init__(self, contextes):
        self.contextes = contextes
        self.compteurs = defaultdict(float)
        self.jauges = {}

    def ajouter(self, nom, valeur, **etiq):
        self.compteurs[(nom, tuple(sorted(etiq.items())))] += valeur

    def fixer(self, nom, valeur, **etiq):
        self.jauges[(nom, tuple(sorted(etiq.items())))] = valeur

    def texte(self, portes, charges):
        lignes = []
        def ecrire(nom, etiq, v):
            e = ",".join(f'{k}="{str(x).replace(chr(34), "")}"' for k, x in etiq)
            lignes.append(f"{nom}{{{e}}} {v}")
        for (nom, etiq), v in sorted(self.compteurs.items()):
            ecrire(nom, etiq, v)
        for (nom, etiq), v in sorted(self.jauges.items()):
            ecrire(nom, etiq, v)
        for modele, p in portes.items():
            ecrire("hibou_llm_en_attente", (("modele", modele),), len([f for f in p.file if not f[2].done()]))
            ecrire("hibou_llm_en_cours", (("modele", modele),), int(p.occupe))
        for modele, ctx in self.contextes.items():
            ecrire("hibou_llm_contexte_max", (("modele", modele),), ctx)
            ecrire("hibou_llm_charge", (("modele", modele),), int(modele in charges))
        return "\n".join(lignes) + "\n"


def servir():
    from aiohttp import web, ClientSession, ClientTimeout

    amont = os.environ.get("AMONT", "http://llama-swap:8080")
    conf = json.load(open(os.environ.get("CONF", "/etc/hibou/priorite.json")))
    defaut = len(conf["courriels"])
    portes = {}
    mesures = Mesures(conf.get("contextes", {}))
    retirer = {"host", "content-length", "authorization", "transfer-encoding", "connection"}

    def qui(req):
        cle = req.headers.get("Authorization", "").removeprefix("Bearer ").strip()
        if cle in conf["cles"]:
            return conf["cles"][cle]
        if cle in conf["services"]:
            s = conf["services"][cle]
            mail = req.headers.get("X-OpenWebUI-User-Email", "").lower()
            return conf["courriels"].get(mail, {"nom": mail or s["nom"], "rang": s["rang"]})
        return None

    async def relais(req):
        corps = await req.read()
        u = qui(req)
        if req.path == "/metrics":  # port ouvert à forge seule (pare-feu de la VM)
            charges = set()
            try:
                async with req.app["session"].get(amont + "/running") as r:
                    charges = {m.get("model") for m in (await r.json(content_type=None)).get("running", [])}
            except Exception:
                pass
            return web.Response(text=mesures.texte(portes, charges), content_type="text/plain")
        if u is None and req.path != "/health":
            return web.json_response({"error": {"message": "Clé d’API absente ou invalide."}}, status=401)
        porte = None
        if req.method == "POST" and req.path in GARDE:
            try:
                modele = json.loads(corps).get("model", "")
            except (ValueError, AttributeError):
                modele = ""
            porte = portes.setdefault(modele, Porte())
            attente = len(porte.file) + porte.occupe
            if attente:
                print(f"{u['nom']} (rang {u['rang']}) attend {modele} : {attente} devant ou en cours", flush=True)
            debut = time.monotonic()
            await porte.prendre(u["rang"])
            attente = time.monotonic() - debut
            mesures.ajouter("hibou_llm_requetes_total", 1, modele=modele, utilisateur=u["nom"])
            mesures.ajouter("hibou_llm_attente_secondes_total", attente, modele=modele, utilisateur=u["nom"])
            mesures.fixer("hibou_llm_attente_derniere_secondes", round(attente, 2), modele=modele)
        fin = b""
        try:
            entetes = {k: v for k, v in req.headers.items() if k.lower() not in retirer}
            async with req.app["session"].request(req.method, amont + req.path_qs, headers=entetes, data=corps) as r:
                rep = web.StreamResponse(status=r.status, headers={
                    k: v for k, v in r.headers.items()
                    if k.lower() not in ("content-length", "transfer-encoding", "connection", "content-encoding")})
                await rep.prepare(req)
                async for bloc in r.content.iter_any():
                    await rep.write(bloc)
                    if porte:
                        fin = (fin + bloc)[-65536:]
                await rep.write_eof()
                return rep
        finally:
            if porte:
                porte.rendre()
                t = lire_timings(fin)
                if t:
                    mesures.ajouter("hibou_llm_tokens_prompt_total", t.get("prompt_n", 0), modele=modele)
                    mesures.ajouter("hibou_llm_tokens_generes_total", t.get("predicted_n", 0), modele=modele)
                    mesures.ajouter("hibou_llm_generation_secondes_total", t.get("predicted_ms", 0) / 1000, modele=modele)
                    mesures.ajouter("hibou_llm_prompt_secondes_total", t.get("prompt_ms", 0) / 1000, modele=modele)
                    # Contexte occupé par la dernière requête : ce qui reste avant la troncature.
                    mesures.fixer("hibou_llm_contexte_utilise", t.get("prompt_n", 0) + t.get("predicted_n", 0)
                                  + t.get("cache_n", 0), modele=modele)

    async def debut(app):
        app["session"] = ClientSession(timeout=ClientTimeout(total=None), auto_decompress=False)

    async def fin(app):
        await app["session"].close()

    app = web.Application(client_max_size=256 * 1024 * 1024)
    app.on_startup.append(debut)
    app.on_cleanup.append(fin)
    app.router.add_route("*", "/{tail:.*}", relais)
    # handler_cancellation : un client qui s’en va quitte aussi la file d’attente.
    web.run_app(app, port=8080, handler_cancellation=True, access_log=None)


async def _autotest():
    p, ordre = Porte(), []
    await p.prendre(9)

    async def t(rang, nom):
        await p.prendre(rang)
        ordre.append(nom)
        p.rendre()

    taches = [asyncio.create_task(t(r, n)) for r, n in ((3, "c"), (0, "a"), (1, "b"), (0, "parti"))]
    await asyncio.sleep(0)
    taches[3].cancel()
    await asyncio.sleep(0)
    p.rendre()
    await asyncio.gather(*taches[:3])
    assert ordre == ["a", "b", "c"], ordre
    assert not p.occupe and not p.file
    flux = b'data: {"choices":[]}\n\ndata: {"choices":[],"timings":{"prompt_n":12,"predicted_n":30,"predicted_ms":600.0}}\n\ndata: [DONE]\n'
    assert lire_timings(flux)["predicted_n"] == 30
    assert lire_timings(b'{"id":1}') is None
    m = Mesures({"x": 1024}); m.ajouter("hibou_llm_requetes_total", 1, modele="x", utilisateur="alice")
    texte = m.texte({"x": Porte()}, {"x"})
    assert 'hibou_llm_requetes_total{modele="x",utilisateur="alice"} 1.0' in texte and 'hibou_llm_charge{modele="x"} 1' in texte, texte
    print("priorite : autotest réussi")


if __name__ == "__main__":
    asyncio.run(_autotest()) if os.environ.get("HIBOU_AUTOTEST") else servir()
PY
}

source_relecteur() {
cat <<'PY'
"""hibou-relecteur : relit chaque pull request de l’organisation avec le LLM dev et poste un avis.

Webhook d’organisation Forgejo (pull_request) -> diff -> LLM -> revue « commentaire ».
L’avis est consultatif : il ne bloque ni n’approuve rien. Bibliothèque standard uniquement.
"""
import hashlib, hmac, json, os, threading, urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

LIMITE = int(os.environ.get("LIMITE_DIFF", "120000"))  # caractères ; au-delà, le diff est coupé
CONSIGNE = (
    "Tu es Hibou, relecteur de code. Tu écris en français, au tutoiement, calme et précis, sans point d’exclamation ni émoji. "
    "Tu relis le diff d’une pull request. Signale uniquement les vrais problèmes : bogue, faille de sécurité, perte de données, "
    "cas limite oublié, test manquant pour une logique risquée, code inutile ou trop compliqué. Pour chacun : "
    "« **fichier:ligne** — gravité (bloquant, important, mineur) — le problème, puis la correction proposée ». "
    "Pas de compliment, pas de résumé du diff. Si rien ne pose problème, réponds seulement : « Rien à signaler. »")
en_cours, verrou = set(), threading.Lock()


def signature_valide(secret, corps, recue):
    attendue = hmac.new(secret.encode(), corps, hashlib.sha256).hexdigest()
    return hmac.compare_digest(attendue, (recue or "").strip())


def couper(diff, limite=LIMITE):
    if len(diff) <= limite:
        return diff, False
    return diff[:limite].rsplit("\n", 1)[0], True


def http(methode, url, jeton=None, corps=None, cle=None):
    entetes = {"Content-Type": "application/json"}
    if jeton:
        entetes["Authorization"] = f"token {jeton}"
    if cle:
        entetes["Authorization"] = f"Bearer {cle}"
    req = urllib.request.Request(url, json.dumps(corps).encode() if corps is not None else None, entetes, method=methode)
    with urllib.request.urlopen(req, timeout=1800) as r:
        return r.read().decode()


def relire(depot, numero, titre):
    e = os.environ
    api = f"{e['FORGEJO']}/api/v1/repos/{depot}/pulls/{numero}"
    try:
        diff, coupe = couper(http("GET", f"{api}.diff", e["JETON"]))
        if not diff.strip():
            return
        rep = json.loads(http("POST", f"{e['LLM_URL']}/chat/completions", cle=e["LLM_CLE"], corps={
            "model": e["MODELE"], "temperature": 0.2, "max_tokens": 4096,
            "messages": [{"role": "system", "content": CONSIGNE},
                         {"role": "user", "content": f"Pull request : {titre}\n\n```diff\n{diff}\n```"}]}))
        avis = (rep["choices"][0]["message"].get("content") or "").strip() or "Rien à signaler."
        if coupe:
            avis += f"\n\n_Diff trop long : seuls les {LIMITE // 1000} premiers milliers de caractères ont été relus._"
        avis += f"\n\n<sub>Relecture Hibou ({e['MODELE']}), consultative : la décision reste humaine.</sub>"
        http("POST", f"{api}/reviews", e["JETON"], {"body": avis, "event": "COMMENT"})
        print(f"{depot}#{numero} relue", flush=True)
    except Exception as x:  # un échec ne doit jamais bloquer le webhook ni le serveur
        print(f"{depot}#{numero} : échec de la relecture : {x}", flush=True)
    finally:
        with verrou:
            en_cours.discard((depot, numero))


class Webhook(BaseHTTPRequestHandler):
    def do_POST(self):
        corps = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        if not signature_valide(os.environ["SECRET"], corps, self.headers.get("X-Forgejo-Signature") or self.headers.get("X-Gitea-Signature")):
            self.send_response(401); self.end_headers(); return
        self.send_response(202); self.end_headers()
        ev = json.loads(corps or b"{}")
        pr = ev.get("pull_request") or {}
        if ev.get("action") not in ("opened", "reopened", "synchronized") or pr.get("draft"):
            return
        if (pr.get("user") or {}).get("login") == os.environ.get("COMPTE", "hibou-relecteur"):
            return
        cle = (ev["repository"]["full_name"], pr["number"])
        with verrou:  # une seule relecture à la fois par pull request
            if cle in en_cours:
                return
            en_cours.add(cle)
        threading.Thread(target=relire, args=(*cle, pr.get("title", "")), daemon=True).start()

    def log_message(self, *a):
        pass


def autotest():
    s = hmac.new(b"k", b"{}", hashlib.sha256).hexdigest()
    assert signature_valide("k", b"{}", s) and not signature_valide("k", b"{}", "0" * 64) and not signature_valide("k", b"{}", None)
    d, c = couper("a\nb\nc", 3)
    assert (d, c) == ("a", True) and couper("ab", 5) == ("ab", False)
    print("relecteur : autotest réussi")


if __name__ == "__main__":
    if os.environ.get("HIBOU_AUTOTEST"):
        autotest()
    else:
        ThreadingHTTPServer(("0.0.0.0", 8090), Webhook).serve_forever()
PY
}

telecharger() {
  SORTIE="${1:-$PWD/hibou-bundle-$(date +%Y%m%d)}"
  exiger_cmd docker "Installe Docker sur la machine connectée."
  exiger_cmd python3; exiger_cmd openssl; exiger_cmd zstd; exiger_cmd ssh-keygen
