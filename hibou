installer_forge() {
  local b="$1" montages_avant=""
  [[ -z "${HIBOU_MAJ:-}" ]] || montages_avant=$(empreintes_montages /srv/forgejo 2>/dev/null)
  # Phase « owui », lancée par l’installation ou la mise à jour de doc ou dev : Open WebUI suit les modèles réellement
  # servis (profil changé, base de templates à remplir une fois doc en ligne), l’évaluation aussi.
  if [[ "${HIBOU_PHASE:-}" == owui ]]; then
    ADMIN="$HIBOU_ADMIN_NOM"; MDP="$HIBOU_ADMIN_MDP"
    [[ -d /usr/local/lib/hibou ]] && cp "$b/config.env" /usr/local/lib/hibou/config.env
    etape "Open WebUI : modèles rebranchés sur les modèles installés"
    amorcer_open_webui "$b" "" || note "Open WebUI n’a pas tout accepté : vérifie les modèles Hibou dans son espace de travail."
    return 0
  fi
  if ! saute socle; then
  etape "Docker, DNS, heure"
  source_locale "$b/apt/ubuntu"
  apt_hibou docker-ce docker-ce-cli containerd.io docker-compose-plugin chrony dnsmasq curl git openssh-client openssh-server zstd jq rsync cloud-guest-utils qemu-guest-agent
  systemctl enable --now qemu-guest-agent >/dev/null 2>&1 || true
  agrandir_systeme
  local n
  {
    printf 'listen-address=%s\nbind-interfaces\nno-resolv\nlocal=/%s/\n' "$HIBOU_IP_FORGE" "$DOMAINE"
    # Toutes les applications sont sur forge ; doc et dev ne servent que leur API, derrière forge.
    for n in forge registry docs supervision etat alertes chat code llm-doc llm-dev; do printf 'address=/%s.%s/%s\n' "$n" "$DOMAINE" "$HIBOU_IP_FORGE"; done
    printf 'address=/doc.%s/%s\naddress=/dev.%s/%s\n' "$DOMAINE" "$HIBOU_IP_DOC" "$DOMAINE" "$HIBOU_IP_DEV"
    printf 'address=/pve-doc.%s/%s\naddress=/pve-dev.%s/%s\n' "$DOMAINE" "$HIBOU_IP_PVE_DOC" "$DOMAINE" "$HIBOU_IP_PVE_DEV"
    n=1; for ip in $HIBOU_IP_CLUSTER; do printf 'address=/pve%s.%s/%s\n' "$n" "$DOMAINE" "$ip"; n=$((n + 1)); done
  } > /etc/dnsmasq.d/hibou.conf
  systemctl enable dnsmasq >/dev/null 2>&1; systemctl restart dnsmasq
  printf 'local stratum 10\nallow %s\n' "$HIBOU_RESEAU" > /etc/chrony/conf.d/hibou.conf
  systemctl restart chrony
  resolveur
  fait "Docker installé, DNS et serveur d’heure actifs sur $HIBOU_IP_FORGE."
  fi
  saute images || { etape "Images"; charger_images "$b" forge; }
  if ! saute config; then
  etape "Forgejo, registre, applications"
  install -d /srv/forgejo/data/gitea /srv/forgejo/runner /srv/registry /srv/docs-site /srv/hibou /srv/workspace /srv/opencode
  # Modules Python livrés pour Open WebUI (export PDF), décompressés et montés en lecture seule. Le dossier monté est
  # synchronisé, jamais recréé : un conteneur qui n’est pas redémarré garderait sinon l’ancien dossier, supprimé, donc vide.
  # Montée dans le relecteur : présente même sans base sécurité (sinon Docker créerait un dossier à sa place).
  [[ -f /srv/hibou/securite.env ]] || install -m 600 /dev/null /srv/hibou/securite.env
  local roue owui_py; owui_py=$(mktemp -d)
  for roue in "$b"/owui-py/*.whl; do [[ -f "$roue" ]] && python3 -m zipfile -e "$roue" "$owui_py"; done
  install -d /srv/hibou/owui-py; rsync -a --delete "$owui_py/" /srv/hibou/owui-py/; rm -rf "$owui_py"
  [[ -d /srv/hibou/owui-py/fpdf ]] || note "fpdf2 absent du bundle : l’export PDF sera indisponible (Word, PowerPoint et Excel restent possibles)."
  if [[ ! -s /srv/forgejo/secrets.env ]]; then
    local s; umask 077
    for s in SECRET_KEY INTERNAL_TOKEN; do
      printf 'FORGEJO__security__%s=%s\n' "$s" "$(docker run --rm --entrypoint sh "${IMAGES[forgejo]}" -c "forgejo generate secret $s")"
    done > /srv/forgejo/secrets.env
    printf 'FORGEJO__oauth2__JWT_SECRET=%s\n' "$(docker run --rm --entrypoint sh "${IMAGES[forgejo]}" -c 'forgejo generate secret JWT_SECRET')" >> /srv/forgejo/secrets.env
    umask 022
  fi
  rsync -a "$b/charte/forgejo/public/" /srv/forgejo/data/gitea/public/
  rsync -a "$b/charte/" /srv/hibou/charte/
  config_opencode
  config_open_webui_env
  page_erreur
  cat > /srv/forgejo/Caddyfile <<EOF
{
	local_certs
}
# Pages d’erreur aux couleurs de Hibou pour tous les sites.
(hibou) {
	handle_errors {
		root * /srv/charte
		rewrite * /erreur.html
		templates
		file_server
	}
}
# Connexion unique par Forgejo pour les applications qui n’ont pas d’OIDC (ou pas le bon).
# Argument : groupes Forgejo admis. À importer dans un bloc route, avant le service.
(sso) {
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
		}
	}
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth?allowed_groups={args[0]}
		header_up X-Real-IP {remote_host}
		copy_headers X-Auth-Request-User X-Auth-Request-Email
		@anonyme status 401
		handle_response @anonyme {
			redir * /oauth2/sign_in?rd={scheme}://{host}{uri}
		}
		# Compte hors des groupes admis : page Hibou « Accès réservé » au lieu du « Forbidden » d’oauth2-proxy.
		@interdit status 403
		handle_response @interdit {
			error 403
		}
	}
}
forge.$DOMAINE {
	import hibou
	reverse_proxy forgejo:3000
}
# Registre en lecture seule pour le réseau ; les paquets et images des équipes vont dans Forgejo (avec ses comptes).
registry.$DOMAINE {
	import hibou
	@ecriture not method GET HEAD
	respond @ecriture "Registre en lecture seule." 403
	reverse_proxy registry:5000
}
docs.$DOMAINE {
	import hibou
	route {
		import sso hibou:doc,hibou:dev,hibou:owners
		root * /srv/docs
		file_server
	}
}
supervision.$DOMAINE {
	import hibou
	reverse_proxy grafana:3000
}
etat.$DOMAINE {
	import hibou
	route {
		import sso hibou:owners
		reverse_proxy uptime-kuma:3001
	}
}
alertes.$DOMAINE {
	import hibou
	route {
		import sso hibou:doc,hibou:dev,hibou:owners
		# Sujet « hibou » (alertes des serveurs) : administrateurs seulement. « hibou-pr » (pull requests) : toutes les équipes.
		@alertes path /hibou /hibou/*
		forward_auth @alertes oauth2-proxy:4180 {
			uri /oauth2/auth?allowed_groups=hibou:owners
			header_up X-Real-IP {remote_host}
			@refuse status 401 403
			handle_response @refuse {
				error 403
			}
		}
		reverse_proxy ntfy:80
	}
}
chat.$DOMAINE {
	import hibou
	reverse_proxy open-webui:8080
}
code.$DOMAINE {
	import hibou
	route {
		request_header -X-Auth-Request-Email   # seul oauth2-proxy le fournit, jamais le navigateur
		import sso hibou:dev,hibou:owners
$(routes_opencode)
		respond "Pas d’espace OpenCode pour ce compte. Demande à l’administrateur de t’ajouter à l’équipe dev." 403
	}
}
# API : la clé est vérifiée par le service de priorité de chaque serveur.
llm-doc.$DOMAINE {
	import hibou
	reverse_proxy $HIBOU_IP_DOC:8080
}
llm-dev.$DOMAINE {
	import hibou
	reverse_proxy $HIBOU_IP_DEV:8080
}
EOF
