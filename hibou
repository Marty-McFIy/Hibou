# Évaluation : copie locale de l’outil, minuterie hebdomadaire, tableau Grafana et alertes.
supervision_evaluation() {
  install -d /usr/local/lib/hibou
  rsync -a "$ICI_HIBOU/hibou" "$ICI_HIBOU/config.env" /usr/local/lib/hibou/
  rsync -a --exclude resultats "$ICI_HIBOU/amorces/hibou-eval" /usr/local/lib/hibou/amorces/
  cat > /etc/systemd/system/hibou-eval.service <<'EOF'
[Unit]
Description=Hibou : évaluation des modèles doc et dev
After=docker.service network-online.target
[Service]
Type=oneshot
Environment=NO_COLOR=1
ExecStart=/usr/local/lib/hibou/hibou evaluer tout /usr/local/lib/hibou
EOF
  cat > /etc/systemd/system/hibou-eval.timer <<'EOF'
[Unit]
Description=Hibou : évaluation hebdomadaire (dimanche 4 h, après la sauvegarde)
[Timer]
OnCalendar=Sun *-*-* 04:00
Persistent=true
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload && systemctl enable --now hibou-eval.timer >/dev/null 2>&1
  cat >> /srv/supervision/prometheus/regles.yml <<'EOF'
      - alert: EvaluationEnRecul
        expr: hibou_eval_score < 0.5
        for: 1h
        annotations: { resume: "{{ $labels.modele }} ({{ $labels.serveur }}) ne réussit que {{ $value | humanizePercentage }} des tâches {{ $labels.famille }}. Compare avec l’évaluation précédente dans hibou-eval." }
      - alert: EvaluationAncienne
        expr: time() - hibou_eval_derniere_timestamp > 8 * 86400
        for: 1h
        annotations: { resume: "Le serveur {{ $labels.serveur }} n’a pas été évalué depuis plus de 8 jours. Regarde : journalctl -u hibou-eval." }
EOF
  local panneau='{"type":"prometheus","uid":"prometheus"}'
  jq -n --argjson ds "$panneau" '{
    uid: "hibou-eval", title: "Hibou · Évaluation des modèles", timezone: "browser", schemaVersion: 39,
    time: {from: "now-90d", to: "now"}, refresh: "5m",
    panels: [
      {id: 1, type: "bargauge", title: "Tâches réussies", datasource: $ds, gridPos: {x: 0, y: 0, w: 12, h: 10},
       targets: [{expr: "hibou_eval_score", legendFormat: "{{serveur}} · {{modele}} · {{famille}}", refId: "A"}],
       options: {orientation: "horizontal", displayMode: "basic"},
       fieldConfig: {defaults: {unit: "percentunit", min: 0, max: 1, thresholds: {mode: "absolute",
         steps: [{color: "#F0876B", value: null}, {color: "#F2B544", value: 0.5}, {color: "#5CC8B8", value: 0.8}]}}}},
      {id: 2, type: "bargauge", title: "Vitesse (tokens/s)", datasource: $ds, gridPos: {x: 12, y: 0, w: 12, h: 10},
       targets: [{expr: "hibou_eval_tokens_par_seconde", legendFormat: "{{serveur}} · {{modele}} · {{famille}}", refId: "A"}],
       options: {orientation: "horizontal", displayMode: "basic"},
       fieldConfig: {defaults: {unit: "none", color: {mode: "fixed", fixedColor: "#F2B544"}}}},
      {id: 3, type: "timeseries", title: "Évolution des scores", datasource: $ds, gridPos: {x: 0, y: 10, w: 18, h: 9},
       targets: [{expr: "hibou_eval_score", legendFormat: "{{serveur}} · {{modele}} · {{famille}}", refId: "A"}],
       fieldConfig: {defaults: {unit: "percentunit", min: 0, max: 1}}},
      {id: 4, type: "stat", title: "Dernière évaluation (jours)", datasource: $ds, gridPos: {x: 18, y: 10, w: 6, h: 9},
       targets: [{expr: "(time() - hibou_eval_derniere_timestamp) / 86400", legendFormat: "{{serveur}}", refId: "A"}],
       fieldConfig: {defaults: {decimals: 1, color: {mode: "fixed", fixedColor: "#5CC8B8"}}}}
    ]}' > /srv/supervision/grafana/dashboards/evaluation.json
  fait "Évaluation chaque dimanche à 4 h, tableau « Hibou · Évaluation des modèles » et alertes en place."
  supervision_llm
}

supervision_llm() {
