    "Quand une remarque de sécurité découle d’un extrait des guides de l’ANSSI fourni, cite le guide entre crochets, "
    "par exemple [ANSSI · Usage sécurisé d’(Open)SSH, R12] ; n’invente jamais de référence. "
    "Pas de compliment, pas de résumé du diff. Si rien ne pose problème, réponds seulement : « Rien à signaler. »")
NTFY = os.environ.get("NTFY", "http://ntfy/hibou-pr")  # notifications d’équipe (https://alertes.<domaine>, sujet hibou-pr)
SECURITE = "/etc/hibou/securite.env"  # écrit par « hibou » à chaque passage (clé d’API du chat, base sécurité), relu à chaque relecture
en_cours, verrou = set(), threading.Lock()


def signature_valide(secret, corps, recue):
    attendue = hmac.new(secret.encode(), corps, hashlib.sha256).hexdigest()
    return hmac.compare_digest(attendue, (recue or "").strip())


def couper(diff, limite=LIMITE):
    if len(diff) <= limite:
        return diff, False
    return diff[:limite].rsplit("\n", 1)[0], True


def http(methode, url, jeton=None, corps=None, cle=None):
    entetes = {"Content-Type": "application/json"}
    if jeton:
        entetes["Authorization"] = f"token {jeton}"
    if cle:
        entetes["Authorization"] = f"Bearer {cle}"
    req = urllib.request.Request(url, json.dumps(corps).encode() if corps is not None else None, entetes, method=methode)
    with urllib.request.urlopen(req, timeout=1800) as r:
        return r.read().decode()


def notifier(titre, message, lien=""):
    """Notification ntfy ; un échec n’empêche jamais la relecture."""
    try:
        # Titre et lien en paramètres : les en-têtes HTTP n’acceptent pas les accents.
        q = urllib.parse.urlencode({"title": titre, "tags": "owl", **({"click": lien} if lien else {})})
        r = urllib.request.Request(f"{NTFY}?{q}", data=message.encode(), method="POST")
        urllib.request.urlopen(r, timeout=10).read()
    except Exception as x:
        print(f"ntfy indisponible : {x.__class__.__name__}", flush=True)


def guides_securite(diff):
    """Extraits des guides de l’ANSSI les plus proches du code ajouté, ou "" si la base n’est pas installée ou ne répond pas."""
    try:
        conf = dict(l.split("=", 1) for l in open(SECURITE).read().splitlines() if "=" in l)
        if not conf.get("BASE_ID"):
            return ""
        fichiers = re.findall(r"^\+\+\+ b/(.+)$", diff, re.M)
        ajouts = "\n".join(l[1:] for l in diff.splitlines() if l.startswith("+") and not l.startswith("+++"))
        requete = "Recommandations de sécurité pour : " + ", ".join(fichiers[:10]) + "\n" + ajouts[:1500]
        r = json.loads(http("POST", f"{conf['OWUI_URL']}/api/v1/retrieval/query/collection", cle=conf["OWUI_CLE"],
                            corps={"collection_names": [conf["BASE_ID"]], "query": requete, "k": 4}))
        extraits = [f"[{(m or {}).get('name') or (m or {}).get('source', '?')}]\n{d[:1200]}"
                    for d, m in zip((r.get("documents") or [[]])[0], (r.get("metadatas") or [[]])[0])]
        return "\n\n".join(extraits)
    except Exception as x:  # la relecture continue sans les guides
        print(f"base sécurité indisponible : {x.__class__.__name__}", flush=True)
        return ""


def relire(depot, numero, titre, lien=""):
    e = os.environ
    api = f"{e['FORGEJO']}/api/v1/repos/{depot}/pulls/{numero}"
    try:
        diff, coupe = couper(http("GET", f"{api}.diff", e["JETON"]))
        if not diff.strip():
            return
        guides = guides_securite(diff)
        demande = f"Pull request : {titre}\n\n```diff\n{diff}\n```"
        if guides:
            demande += ("\n\nExtraits des guides de l’ANSSI qui peuvent s’appliquer (ignore-les s’ils ne concernent pas ce code) :\n\n" + guides)
        rep = json.loads(http("POST", f"{e['LLM_URL']}/chat/completions", cle=e["LLM_CLE"], corps={
            # Un petit modèle peut répéter la même remarque jusqu’à la limite : pénalité, limite plus basse, doublons retirés ensuite.
            "model": e["MODELE"], "temperature": 0.2, "max_tokens": 2048, "presence_penalty": 1.0,
            "messages": [{"role": "system", "content": CONSIGNE},
                         {"role": "user", "content": demande}]}))
        choix = rep["choices"][0]
        vus, paragraphes = set(), []
        for p in (choix["message"].get("content") or "").split("\n\n"):
            if p.strip() and p.strip() not in vus:
                vus.add(p.strip()); paragraphes.append(p.strip())
        avis = "\n\n".join(paragraphes) or "Rien à signaler."
        if choix.get("finish_reason") == "length":
            avis += "\n\n_Avis coupé à la limite de longueur : la fin peut manquer._"
        if coupe:
            avis += f"\n\n_Diff trop long : seuls les {LIMITE // 1000} premiers milliers de caractères ont été relus._"
        avis += (f"\n\n<sub>Relecture Hibou ({e['MODELE']}){', avec les guides de l’ANSSI' if guides else ''}, "
                 "consultative : la décision reste humaine.</sub>")
        http("POST", f"{api}/reviews", e["JETON"], {"body": avis, "event": "COMMENT"})
        print(f"{depot}#{numero} relue", flush=True)
        notifier(f"Relecture prête : {depot}#{numero}", titre, lien)
    except Exception as x:  # un échec ne doit jamais bloquer le webhook ni le serveur
        print(f"{depot}#{numero} : échec de la relecture : {x}", flush=True)
        try:  # sans ce mot, la pull request semble simplement « pas encore relue »
            # Par /reviews comme l’avis : l’équipe relecture n’a pas le droit de commenter une issue (403).
            http("POST", f"{api}/reviews", e["JETON"], {"event": "COMMENT",
                 "body": f"Relecture automatique impossible : {x}. Le serveur dev est peut-être arrêté. La relecture humaine reste nécessaire."})
            notifier(f"Relecture impossible : {depot}#{numero}", f"{titre}\nRelecture humaine nécessaire.", lien)
        except Exception as y:
            print(f"{depot}#{numero} : commentaire d’échec refusé : {y}", flush=True)
    finally:
        with verrou:
            en_cours.discard((depot, numero))


class Webhook(BaseHTTPRequestHandler):
    def do_POST(self):
        corps = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        if not signature_valide(os.environ["SECRET"], corps, self.headers.get("X-Forgejo-Signature") or self.headers.get("X-Gitea-Signature")):
            self.send_response(401); self.end_headers(); return
        self.send_response(202); self.end_headers()
        ev = json.loads(corps or b"{}")
        pr = ev.get("pull_request") or {}
        if ev.get("action") not in ("opened", "reopened", "synchronized") or pr.get("draft"):
            return
        if (pr.get("user") or {}).get("login") == os.environ.get("COMPTE", "hibou-relecteur"):
            return
        cle = (ev["repository"]["full_name"], pr["number"])
        with verrou:  # une seule relecture à la fois par pull request
            if cle in en_cours:
                return
            en_cours.add(cle)
        if ev.get("action") in ("opened", "reopened"):
            notifier(f"PR à relire : {cle[0]}#{cle[1]}", f"{pr.get('title', '')}\npar {(pr.get('user') or {}).get('login', '?')}", pr.get("html_url", ""))
        threading.Thread(target=relire, args=(*cle, pr.get("title", ""), pr.get("html_url", "")), daemon=True).start()

    def log_message(self, *a):
        pass


def autotest():
    s = hmac.new(b"k", b"{}", hashlib.sha256).hexdigest()
    assert signature_valide("k", b"{}", s) and not signature_valide("k", b"{}", "0" * 64) and not signature_valide("k", b"{}", None)
    d, c = couper("a\nb\nc", 3)
    assert (d, c) == ("a", True) and couper("ab", 5) == ("ab", False)
    print("relecteur : autotest réussi")


if __name__ == "__main__":
    if os.environ.get("HIBOU_AUTOTEST"):
        autotest()
    else:
        ThreadingHTTPServer(("0.0.0.0", 8090), Webhook).serve_forever()
PY
}

