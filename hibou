#!/usr/bin/env bash
# hibou — bundle hors ligne.
#   Machine connectée : « hibou telecharger » pose les questions, puis prépare le bundle.
#   Infrastructure isolée : « hibou installer <rôle> » sur l’hôte Proxmox, tout est automatique.
# Local. Isolé. Discret.
set -euo pipefail

VERSION_HIBOU="0.9.0"

ICI_HIBOU="$(dirname "$(readlink -f "$0")")"
# Réponses du menu (non secrètes), posées à côté du script dans le bundle.
# shellcheck disable=SC1091
[[ -f "$ICI_HIBOU/config.env" ]] && source "$ICI_HIBOU/config.env"

# ─── Réglages (à relire avant chaque bundle) ────────────────────────────────
DOMAINE="${HIBOU_DOMAINE:-hibou.lan}"
UBUNTU_SUITE="resolute"            # Ubuntu 26.04
UBUNTU_VERSION="26.04"
DEBIAN_SUITE="trixie"              # Debian 13, base de Proxmox VE 9
NVIDIA_VERSION="620.70.06"         # version exacte, la même dans les VM doc et dev
NVIDIA_UBUNTU="https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/x86_64"
NVIDIA_CTK="https://nvidia.github.io/libnvidia-container/stable/deb/amd64"
IMAGE_CLOUD="ubuntu-${UBUNTU_VERSION}-server-cloudimg-amd64.img"
IMAGE_CLOUD_URL="https://cloud-images.ubuntu.com/releases/${UBUNTU_VERSION}/release"

# openssh-server est embarqué avec le client : sinon apt retire le serveur en mettant le client à jour.
PAQUETS_UBUNTU="docker-ce docker-ce-cli containerd.io docker-compose-plugin nvidia-container-toolkit \
chrony dnsmasq curl git openssh-client openssh-server zstd jq rsync nftables cloud-guest-utils qemu-guest-agent"
# VM doc et dev : pilote complet compilé par DKMS pour le noyau générique à jour.
PAQUETS_GPU="nvidia-open build-essential dkms linux-generic linux-headers-generic"
# Hôtes Proxmox : plus de pilote NVIDIA, les cartes partent entières dans les VM (vfio-pci).
PAQUETS_PVE="prometheus-node-exporter smartmontools ethtool zstd jq rsync"
SMARTCTL_EXPORTER="0.14.0"         # absent de Debian 13 : binaire officiel pris sur GitHub

# Images : le tag sert au téléchargement, l’empreinte (digest) est figée dans MANIFEST.md.
declare -A IMAGES=(
