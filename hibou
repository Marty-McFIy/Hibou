# Ports des VM GPU ouverts à forge seule (API, ComfyUI, métriques). Avant le DNAT de Docker.
pare_feu() {
  install -d /etc/hibou
  cat > /etc/hibou/pare-feu.nft <<EOF
table inet hibou
delete table inet hibou
table inet hibou {
  chain entree {
    type filter hook prerouting priority -150; policy accept;
    meta nfproto ipv6 tcp dport { 8080, 8188, 9100, 9835 } drop
    tcp dport { 8080, 8188, 9100, 9835 } ip saddr != $HIBOU_IP_FORGE drop
  }
}
EOF
  cat > /etc/systemd/system/hibou-pare-feu.service <<'EOF'
