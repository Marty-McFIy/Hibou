  [forgejo-runner]="code.forgejo.org/forgejo/runner:11"          # à vérifier : dernière version majeure
  [prometheus]="quay.io/prometheus/prometheus:v3.5.0"
  [alertmanager]="quay.io/prometheus/alertmanager:v0.28.1"
  [grafana]="docker.io/grafana/grafana-oss:12.1.0"
  [uptime-kuma]="docker.io/louislam/uptime-kuma:2"
  [ntfy]="docker.io/binwiederhier/ntfy:v2.13.0"
  [node-exporter]="quay.io/prometheus/node-exporter:v1.9.1"
