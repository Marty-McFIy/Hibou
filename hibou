  fi
  if [[ -n "${HIBOU_MAJ:-}" ]]; then
    consignes_agent   # les consignes de l’agent changent avec la version ; « configurer » n’est pas rejoué en mise à jour
    # Réglages de Grafana ajoutés depuis l’installation : complétés sans réécrire le fichier (il porte les secrets OAuth).
    local reglage
    for reglage in SSL_CERT_FILE=/etc/hibou/ca.crt GF_AUTH_OAUTH_AUTO_LOGIN=true GF_NEWS_NEWS_FEED_ENABLED=false \
        GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/provisioning/dashboards/hibou.json; do
      [[ ! -f /srv/supervision/grafana.env ]] || grep -q "^${reglage%%=*}=" /srv/supervision/grafana.env || echo "$reglage" >> /srv/supervision/grafana.env
    done
    demarrer /srv/forgejo
    redemarrer_montages_changes /srv/forgejo "$montages_avant"
    # Open WebUI démarré avant la correction ci-dessus : il peut encore voir l’ancien dossier des modules, vide.
    if [[ -d /srv/hibou/owui-py/fpdf ]] && ! docker exec hibou-forge-open-webui-1 test -d /app/hibou-py/fpdf 2>/dev/null; then
