  rsync -a --exclude resultats "$ICI_HIBOU/amorces/hibou-eval" /usr/local/lib/hibou/amorces/
  cat > /etc/systemd/system/hibou-eval.service <<'EOF'
[Unit]
Description=Hibou : évaluation des modèles doc et dev
After=docker.service network-online.target
[Service]
Type=oneshot
Environment=NO_COLOR=1
ExecStart=/usr/local/lib/hibou/hibou evaluer tout /usr/local/lib/hibou
EOF
  cat > /etc/systemd/system/hibou-eval.timer <<'EOF'
[Unit]
Description=Hibou : évaluation hebdomadaire (dimanche 4 h, après la sauvegarde)
[Timer]
OnCalendar=Sun *-*-* 04:00
Persistent=true
[Install]
WantedBy=timers.target
EOF
  systemctl daemon-reload && systemctl enable --now hibou-eval.timer >/dev/null 2>&1
  cat >> /srv/supervision/prometheus/regles.yml <<'EOF'
      - alert: EvaluationEnRecul
        expr: hibou_eval_score < 0.5
        for: 1h
