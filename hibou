       fieldConfig: {defaults: {thresholds: {mode: "absolute", steps: [{color: "#5CC8B8", value: null}, {color: "#F2B544", value: 1}]}}}},
      {id: 3, type: "bargauge", title: "Contexte utilisé (dernière requête)", datasource: $ds, gridPos: {x: 16, y: 0, w: 8, h: 7},
