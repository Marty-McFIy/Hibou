  systemctl enable --now qemu-guest-agent >/dev/null 2>&1 || true
  agrandir_systeme
  local n
  {
    printf 'listen-address=%s\nbind-interfaces\nno-resolv\nlocal=/%s/\n' "$HIBOU_IP_FORGE" "$DOMAINE"
    # Toutes les applications sont sur forge ; doc et dev ne servent que leur API, derrière forge.
    for n in forge registry docs supervision etat alertes chat code llm-doc llm-dev; do printf 'address=/%s.%s/%s\n' "$n" "$DOMAINE" "$HIBOU_IP_FORGE"; done
