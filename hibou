(hibou) {
	handle_errors {
		root * /srv/charte
		rewrite * /erreur.html
		templates
		file_server
	}
}
# Connexion unique par Forgejo pour les applications qui n’ont pas d’OIDC (ou pas le bon).
# Argument : groupes Forgejo admis. À importer dans un bloc route, avant le service.
(sso) {
	handle /oauth2/* {
		reverse_proxy oauth2-proxy:4180 {
			header_up X-Real-IP {remote_host}
		}
	}
	forward_auth oauth2-proxy:4180 {
		uri /oauth2/auth?allowed_groups={args[0]}
