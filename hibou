        annotations: { resume: "Sur {{ $labels.serveur }}, la dernière requête a attendu {{ $value | humanizeDuration }} son tour pour {{ $labels.modele }}. Deux personnes se partagent le serveur." }
      - alert: ContexteSature
        expr: hibou_llm_contexte_utilise / hibou_llm_contexte_max > 0.9
