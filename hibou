      {id: 4, type: "timeseries", title: "Génération (tokens/s)", datasource: $ds, gridPos: {x: 0, y: 7, w: 12, h: 8},
       targets: [{expr: "rate(hibou_llm_tokens_generes_total[5m]) / rate(hibou_llm_generation_secondes_total[5m])", legendFormat: $leg, refId: "A"}],
