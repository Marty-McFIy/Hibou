# Paquets du bundle publiés dans Forgejo (organisation hibou), depuis l’image hibou/miroir.
importer_miroir() {  # bundle
  local b="${1:-$ICI_HIBOU}"
  [[ -d "$b/mirror" ]] || { [[ "${HIBOU_MIROIR:-0}" == 1 ]] && note "Pas de dossier mirror dans le bundle : miroir sauté."; return 0; }
  exiger_root; secrets "$b"
  etape "Miroir de dépendances vers Forgejo"
  docker image inspect hibou/miroir:actuel >/dev/null 2>&1 || zstd -dc "$b/images/miroir.tar.zst" | docker load -q >/dev/null
  # Le démon Docker de forge pousse les images vers forge.<domaine> : il doit connaître l’autorité interne.
  install -d "/etc/docker/certs.d/forge.$DOMAINE"
  cp /srv/hibou/hibou-ca.crt "/etc/docker/certs.d/forge.$DOMAINE/ca.crt"
  local jeton
  jeton=$(curl -fsS -u "$HIBOU_ADMIN_NOM:$HIBOU_ADMIN_MDP" -H 'Content-Type: application/json' -X POST \
    "http://127.0.0.1:3000/api/v1/users/$HIBOU_ADMIN_NOM/tokens" \
    -d "{\"name\":\"miroir-$(date +%Y%m%d%H%M%S)\",\"scopes\":[\"write:package\",\"write:repository\",\"write:organization\"]}" | jq -r .sha1) \
    || erreur "Forgejo refuse de créer le jeton d’import." "Vérifie que forge est configurée (hibou configurer)."
  docker run --rm --network hibou-forge_default -v "$b/mirror:/m:ro" -v /var/run/docker.sock:/var/run/docker.sock \
    hibou/miroir:actuel push --dir /m --url http://forgejo:3000 --owner hibou \
    --user "$HIBOU_ADMIN_NOM" --password "$HIBOU_ADMIN_MDP" --token "$jeton" --registry "forge.$DOMAINE" \
    || note "Une partie du miroir n’est pas passée : relis les lignes « ÉCHEC » ci-dessus, puis relance « hibou miroir »."
  curl -fsS -u "$HIBOU_ADMIN_NOM:$HIBOU_ADMIN_MDP" -X DELETE \
    "http://127.0.0.1:3000/api/v1/users/$HIBOU_ADMIN_NOM/tokens/$(curl -fsS -u "$HIBOU_ADMIN_NOM:$HIBOU_ADMIN_MDP" \
    "http://127.0.0.1:3000/api/v1/users/$HIBOU_ADMIN_NOM/tokens" | jq -r '[.[] | select(.name | startswith("miroir-"))] | last | .id')" >/dev/null 2>&1 || true
  fait "Paquets publiés dans Forgejo : https://forge.$DOMAINE/hibou/-/packages"
}

consignes_agent() {  # AGENTS.md global d’OpenCode : ton de la charte et circuit Forgejo
  cat > /srv/hibou/AGENTS.md <<EOF
# Hibou : consignes pour l'agent

Tu travailles pour Hibou, une IA locale et hors ligne. Rien ne sort de ce réseau.

## Ton
- Réponds en français, en tutoyant. Phrases courtes. Calme, précis, discret.
- Dis ce que tu as fait, pas ce que tu ressens.
- Pas de point d'exclamation, pas d'émoji, pas de superlatif. Une majuscule initiale seulement dans les titres.
- Être hors ligne est un état normal. Ne t'excuse pas de ne pas avoir Internet.

## Travail
- Lis un fichier avant de le modifier. Propose le plus petit changement qui règle le problème.
- Montre les commandes que tu lances. Ne supprime rien sans qu'on te le demande.
- Dans un projet existant, garde son style, ses outils et ses conventions.
- Quand tu n'es pas sûr, pose une seule question précise.

## Forgejo (https://forge.$DOMAINE, organisation hibou)
Les projets vivent dans /workspace/<projet>. Tu es le compte hibou-dev. Jeton : \$FORGEJO_TOKEN.

- Projet existant : \`git clone git@forge.$DOMAINE:hibou/<projet>.git /workspace/<projet>\`
- Nouveau projet : crée le dépôt, puis clone-le :
  \`curl -fsS -H "Authorization: token \$FORGEJO_TOKEN" -H 'Content-Type: application/json' -d '{"name":"<projet>","private":true,"auto_init":true,"default_branch":"main"}' \$FORGEJO_URL/api/v1/orgs/hibou/repos\`
- Jamais de push sur main. Travaille sur une branche \`agent/<sujet>\`, pousse-la, puis ouvre une pull request :
  \`curl -fsS -H "Authorization: token \$FORGEJO_TOKEN" -H 'Content-Type: application/json' -d '{"head":"agent/<sujet>","base":"main","title":"<titre>","body":"<ce qui change et comment le vérifier>"}' \$FORGEJO_URL/api/v1/repos/hibou/<projet>/pulls\`
- Donne l'adresse de la pull request à la fin. Une personne la relit et la fusionne.
EOF
  chmod 644 /srv/hibou/AGENTS.md
}

