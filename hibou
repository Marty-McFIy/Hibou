# ─── Vérification ───────────────────────────────────────────────────────────
verifier() {
  local b="${1:-$ICI_HIBOU}"
  [[ -f "$b/SHA256SUMS" ]] || erreur "Je ne trouve pas SHA256SUMS dans $b." "Indique le dossier du bundle : hibou verifier /chemin/du/bundle"
  etape "Vérification des empreintes"
  local opt=(); [[ -f "$b/.partiel" ]] && opt=(--ignore-missing)
  if (cd "$b" && sha256sum --quiet -c "${opt[@]}" SHA256SUMS); then fait "Tous les fichiers présents sont intacts."
  else erreur "Des fichiers sont abîmés ou manquants." "Recopie-les depuis la machine connectée, puis relance."; fi
}

# ─── Étapes à sauter ────────────────────────────────────────────────────────
# Une seule question au début, sans réponse sous 30 s tout s’enchaîne. HIBOU_SAUTER=vm,copie pour l’imposer.
proposer_sauts() {  # "id:libellé"...
  [[ -t 0 && -z "${HIBOU_SAUTER+x}" ]] || return 0
  local i=1 e r n
  dire "Étapes prévues :"
  for e in "$@"; do printf '    %s%d%s  %s\n' "$AMBRE" "$i" "$FIN" "${e#*:}"; i=$((i + 1)); done
  read -t 30 -rp "  Numéros à sauter, séparés par des espaces (Entrée ou 30 s = aucune) : " r || echo
  HIBOU_SAUTER=""
  for n in $r; do [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= $# )) && HIBOU_SAUTER+="${!n%%:*},"; done
  [[ -z "$HIBOU_SAUTER" ]] || note "Sautées : ${HIBOU_SAUTER%,}"
}
saute() { [[ ",${HIBOU_SAUTER:-}," == *",$1,"* ]]; }

# ─── Secrets ────────────────────────────────────────────────────────────────
secrets() {  # bundle ; phrase lue au clavier, ou sur l’entrée standard quand l’hôte pilote la VM
  [[ -n "${HIBOU_ADMIN_MDP:-}" ]] && return 0
  [[ -f "$1/secrets.chiffre" ]] || erreur "Je ne trouve pas secrets.chiffre dans $1." "Refais le bundle avec « hibou telecharger »."
  if [[ -z "${PHRASE:-}" ]]; then
    if [[ -t 0 ]]; then read -rsp "  Phrase de passe du bundle : " PHRASE; echo; else IFS= read -r PHRASE || true; fi
  fi
  local clair
  clair=$(openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -in "$1/secrets.chiffre" -pass fd:3 3<<<"$PHRASE" 2>/dev/null) \
    || erreur "Phrase de passe refusée." "Relance et vérifie la saisie."
  eval "$clair"
}

# ─── Installation : outils communs ──────────────────────────────────────────
source_locale() {  # $1 = dossier apt du bundle
  echo "deb [trusted=yes] file:$1 ./" > /etc/apt/sources.list.d/hibou.list
  APT_HIBOU=(-o Dir::Etc::sourcelist=/etc/apt/sources.list.d/hibou.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0)
  printf 'Package: *\nPin: version %s*\nPin-Priority: 1001\n' "$NVIDIA_VERSION" > /etc/apt/preferences.d/hibou-nvidia
  apt-get "${APT_HIBOU[@]}" update -qq
}
# --no-remove : apt s’arrête plutôt que de désinstaller un paquet (cas du serveur SSH en REX 2).
apt_hibou() {
  DEBIAN_FRONTEND=noninteractive apt-get "${APT_HIBOU[@]}" install -y -qq --no-remove --no-install-recommends "$@" >/dev/null \
    || erreur "apt refuse l’installation." "Relance à la main pour voir le détail : apt-get ${APT_HIBOU[*]} install --no-remove $*"
}

# Module NVIDIA compilé pour le noyau le plus récent installé, celui du prochain démarrage.
verifier_dkms() {
  local k; k=$(find /lib/modules -mindepth 1 -maxdepth 1 -printf '%f\n' | sort -V | tail -1)
  dkms status -k "$k" 2>/dev/null | grep -q 'nvidia.*installed' \
    || erreur "Le module NVIDIA n’est pas compilé pour le noyau $k." "Lis /var/lib/dkms/nvidia*/*/build/make.log ; il manque souvent les en-têtes de ce noyau."
  fait "Module NVIDIA $NVIDIA_VERSION compilé pour le noyau $k."
}

demarrer() {  # dossier [services...]
  (cd "$1" && docker compose up -d --quiet-pull "${@:2}") \
    || erreur "Les services de $1 ne démarrent pas." "Lis : docker compose -f $1/compose.yaml logs --tail 50"
}

# Démarrage des services à chaque mise sous tension, une fois Docker et le pilote prêts.
service_demarrage() {  # dossier
  cat > /etc/systemd/system/hibou-services.service <<EOF
[Unit]
Description=Hibou : démarrage des services
After=docker.service network-online.target
Wants=network-online.target
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$1
ExecStart=/usr/bin/docker compose up -d
[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload && systemctl enable hibou-services.service >/dev/null 2>&1
}

# Seules les images dont le fichier a changé depuis le dernier chargement sont relues.
charger_images() {  # $1 bundle, $2 rôle
  local nom e n=0; install -d /srv/hibou/etat
  for nom in $(images_du_role "$2"); do
    e=$(sha256sum "$1/images/$nom.tar.zst" | cut -c1-64)
    [[ "$(cat "/srv/hibou/etat/image-$nom" 2>/dev/null)" == "$e" ]] && continue
    note "$nom"; zstd -dc "$1/images/$nom.tar.zst" | docker load -q >/dev/null
    echo "$e" > "/srv/hibou/etat/image-$nom"; n=$((n + 1))
  done
  fait "$n image(s) chargée(s), les autres étaient à jour."
}

copier_modeles() {  # $1 bundle, $2 rôle
  install -d /srv/models
  local alias d garder=" $(modeles_du_role "$2" | tr '\n' ' ') "
  for alias in $(modeles_du_role "$2"); do note "$alias"; rsync -a --delete "$1/models/$2/$alias/" "/srv/models/$alias/"; done
  for d in /srv/models/*/; do
    [[ -d "$d" && "$garder" != *" $(basename "$d") "* ]] && { note "retiré : $(basename "$d")"; rm -rf "$d"; }
  done
  fait "Modèles à jour dans /srv/models ($(du -sh /srv/models | cut -f1))."
}

# Premier fichier GGUF d’un modèle (hors projecteur), relatif à /srv/models.
gguf()   { (cd /srv/models && find "$1" -name '*.gguf' ! -name '*mmproj*' | sort | head -1); }
mmproj() { (cd /srv/models && find "$1" -name '*mmproj*.gguf' | sort | head -1); }

resolveur() {  # systemd-resolved interroge forge pour tout le domaine
  install -d /etc/systemd/resolved.conf.d
  printf '[Resolve]\nDNS=%s\nDomains=~%s\n' "$HIBOU_IP_FORGE" "$DOMAINE" > /etc/systemd/resolved.conf.d/hibou.conf
  systemctl restart systemd-resolved 2>/dev/null || true
}

client_reseau() {  # DNS et heure depuis la VM forge
  resolveur
  printf 'server %s iburst\n' "$HIBOU_IP_FORGE" > /etc/chrony/sources.d/hibou.sources
  systemctl restart chrony
  fait "DNS et heure pointés sur forge ($HIBOU_IP_FORGE)."
}

