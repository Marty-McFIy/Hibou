  if veut securite && [[ "${HIBOU_SECURITE:-0}" == 1 ]]; then
  etape "Documentation de sécurité (ANSSI, textes de référence)"
  listes_securite "$SORTIE/securite.d"
  install -d "$SORTIE/securite/anssi" "$SORTIE/securite/autres" "$SORTIE/securite/ajouts"
  cp -a "$SORTIE/securite.d/ajouts/." "$SORTIE/securite/ajouts/" 2>/dev/null || true   # dossier d’ajouts vide : rien à copier
  python3 - "$SORTIE" <<'PY' || erreur "Le portail de l’ANSSI ne répond pas." "Relance plus tard : HIBOU_PARTIES=securite ./hibou telecharger …"
import concurrent.futures as cf, html, pathlib, re, sys, urllib.parse, urllib.request
S = pathlib.Path(sys.argv[1]); B = "https://messervices.cyber.gouv.fr"
def lire(u):
    u = urllib.parse.quote(u, safe=":/%?=&")   # adresses avec accents (« stratégique », « données »…)
    for essai in range(3):
        try:
            return urllib.request.urlopen(u, timeout=120).read()
        except Exception:
            if essai == 2: raise
def page(slug):
    t = lire(f"{B}/guides/{slug}").decode(errors="replace")
    titre = html.unescape((re.search(r"<title>([^<|]+)", t) or [None, slug])[1]).strip()
    return titre, sorted(set(re.findall(r"https://messervices\.cyber\.gouv\.fr/documents-guides/[^\"\\ ]+?\.pdf", t)))
slugs = sorted({x for x in re.findall(r"/guides/([A-Za-z0-9-]+)", lire(B + "/guides").decode(errors="replace")) if not x.lower().startswith("en-")})
index, echecs = [], 0
with cf.ThreadPoolExecutor(4) as ex:
    pages = list(ex.map(lambda x: (x, *page(x)), slugs))
for slug, titre, pdfs in pages:
    if "(EN)" in titre:  # version anglaise d’un guide déjà présent en français
        continue
    for i, u in enumerate(pdfs):
        f = S / "securite/anssi" / u.rsplit("/", 1)[1]
        if not f.exists() or f.stat().st_size == 0:
            try:
                f.write_bytes(lire(u))
            except Exception:
                echecs += 1; print(f"  non téléchargé : {u}"); continue
        index.append(f"anssi/{f.name}\tANSSI · {titre}" + (f" ({i + 1})" if len(pdfs) > 1 else "") + f"\t{u}")
for ligne in (S / "securite.d/autres.txt").read_text().splitlines():
    if not ligne.strip() or ligne.lstrip().startswith("#"):
        continue
    u, _, titre = ligne.strip().partition(" ")
    f = S / "securite/autres" / u.rsplit("/", 1)[1].split("?")[0]
    try:
        if not f.exists(): f.write_bytes(lire(u))
        index.append(f"autres/{f.name}\t{titre or f.stem}\t{u}")
    except Exception:
        echecs += 1; print(f"  non téléchargé : {u}")
for f in sorted((S / "securite/ajouts").glob("*.pdf")):
    index.append(f"ajouts/{f.name}\t{f.stem}\tajout local")
# Deux guides distincts portent parfois le même titre (« Fondamentaux » et « Essentiels ») : la base nomme ses fichiers
# d’après le titre et prendrait le second pour un doublon.
vus = {}
for k, ligne in enumerate(index):
    f, t, u = ligne.split("\t")
    vus[t] = vus.get(t, 0) + 1
    if vus[t] > 1:
        index[k] = f"{f}\t{t} ({vus[t]})\t{u}"
(S / "securite/INDEX.tsv").write_text("\n".join(index) + "\n")
print(f"  {len(index)} documents ({len(slugs)} guides de l’ANSSI), {echecs} échec(s).")
PY
  fait "Documentation de sécurité : $(du -sh "$SORTIE/securite" | cut -f1) dans securite/."
  fi
  etape "Charte, manifeste, empreintes"
  local charte="${HIBOU_CHARTE:-$ICI_HIBOU/charte}"
  [[ -d "$charte" ]] || erreur "Je ne trouve pas la charte dans $charte." "Place le dossier charte à côté du script, ou indique-le avec HIBOU_CHARTE."
  rm -rf "$SORTIE/charte" "$SORTIE/amorces"
  cp -r "$charte" "$SORTIE/charte" && cp -r "$(dirname "$charte")/amorces" "$SORTIE/amorces"
  [[ "$(readlink -f "$0")" == "$SORTIE/hibou" ]] || cp "$0" "$ICI_HIBOU/hibou-miroir.py" "$SORTIE/"
  chmod 755 "$SORTIE/hibou"
  {
    echo "# Bundle Hibou $(date +%Y-%m-%d)"; echo
    echo "Script : $VERSION_HIBOU · Domaine : $DOMAINE · NVIDIA : $NVIDIA_VERSION"; echo
    echo "dev : $HIBOU_DEV_NB × $HIBOU_DEV_GPU, profil ${PROFILS_DEV[HIBOU_PROFIL_DEV-1]}"
    echo "doc : $HIBOU_DOC_NB × $HIBOU_DOC_GPU, profil ${PROFILS_DOC[HIBOU_PROFIL_DOC-1]}"
    [[ "$HIBOU_IMG_NB" != 0 ]] && echo "images : $HIBOU_IMG_GPU, $(modele_image "$HIBOU_IMG_GO" | cut -d'|' -f2)"
    [[ "${HIBOU_RAG_NB:-0}" != 0 ]] && echo "recherche documentaire : $HIBOU_RAG_GPU"
    echo; echo "## Images"; echo; [[ -f "$SORTIE/images/digests.txt" ]] && sed 's/^/- /' "$SORTIE/images/digests.txt"; echo
    echo "## Modèles"; echo
    for role in dev doc; do n="HIBOU_PROFIL_${role^^}"; profil "$role" "${!n}"; for ligne in "${MODELES_ROLE[@]}"; do echo "- $role · ${ligne//|/ · }"; done; done; echo
    echo "## Versions figées"; echo; sed 's/^/- /' "$SORTIE/versions.lock" 2>/dev/null; echo
    echo "## Paquets"; echo
    (cd "$SORTIE/apt" && find . -name '*.deb' | sort | sed 's/^/- /')
  } > "$SORTIE/MANIFEST.md"
  (cd "$SORTIE" && find . -type f ! -name SHA256SUMS ! -path './.venv-hf/*' -print0 \
    | sort -z | xargs -0 sha256sum > SHA256SUMS)

  local taille; taille=$(du -s --block-size=1G "$SORTIE" | cut -f1)
  fait "Bundle prêt : ${taille} Go."
  (( taille <= CAPACITE_SUPPORT_GO * 90 / 100 )) || note "Le bundle dépasse 90 % du support de ${CAPACITE_SUPPORT_GO} Go (HIBOU_SUPPORT_GO)."
  dire "Copie le dossier sur le disque USB (ext4), branche-le sur un hôte Proxmox et lance :"
  note "sudo ./hibou installer forge   (sur un nœud du cluster)"
  note "sudo ./hibou installer doc     (sur l’hôte des cartes doc)"
  note "sudo ./hibou installer dev     (sur l’hôte des cartes dev)"
}

# ─── Vérification ───────────────────────────────────────────────────────────
verifier() {
  local b="${1:-$ICI_HIBOU}"
  [[ -f "$b/SHA256SUMS" ]] || erreur "Je ne trouve pas SHA256SUMS dans $b." "Indique le dossier du bundle : hibou verifier /chemin/du/bundle"
  etape "Vérification des empreintes"
  local opt=(); [[ -f "$b/.partiel" ]] && opt=(--ignore-missing)
  if (cd "$b" && sha256sum --quiet -c "${opt[@]}" SHA256SUMS); then fait "Tous les fichiers présents sont intacts."
  else erreur "Des fichiers sont abîmés ou manquants." "Recopie-les depuis la machine connectée, puis relance."; fi
}

# ─── Étapes à sauter ────────────────────────────────────────────────────────
# Une seule question au début, sans réponse sous 30 s tout s’enchaîne. HIBOU_SAUTER=vm,copie pour l’imposer.
proposer_sauts() {  # "id:libellé"...
  [[ -t 0 && -z "${HIBOU_SAUTER+x}" ]] || return 0
  local i=1 e r n
  dire "Étapes prévues :"
  for e in "$@"; do printf '    %s%d%s  %s\n' "$AMBRE" "$i" "$FIN" "${e#*:}"; i=$((i + 1)); done
  read -t 30 -rp "  Numéros à sauter, séparés par des espaces (Entrée ou 30 s = aucune) : " r || echo
  HIBOU_SAUTER=""
  for n in $r; do [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= $# )) && HIBOU_SAUTER+="${!n%%:*},"; done
  [[ -z "$HIBOU_SAUTER" ]] || note "Sautées : ${HIBOU_SAUTER%,}"
}
saute() { [[ ",${HIBOU_SAUTER:-}," == *",$1,"* ]]; }

# ─── Secrets ────────────────────────────────────────────────────────────────
secrets() {  # bundle ; phrase lue au clavier, ou sur l’entrée standard quand l’hôte pilote la VM
  [[ -n "${HIBOU_ADMIN_MDP:-}" ]] && return 0
  [[ -f "$1/secrets.chiffre" ]] || erreur "Je ne trouve pas secrets.chiffre dans $1." "Refais le bundle avec « hibou telecharger »."
  if [[ -z "${PHRASE:-}" ]]; then
    if [[ -t 0 ]]; then read -rsp "  Phrase de passe du bundle : " PHRASE; echo; else IFS= read -r PHRASE || true; fi
  fi
  local clair
  clair=$(openssl enc -d -aes-256-cbc -pbkdf2 -iter 600000 -in "$1/secrets.chiffre" -pass fd:3 3<<<"$PHRASE" 2>/dev/null) \
    || erreur "Phrase de passe refusée." "Relance et vérifie la saisie."
  eval "$clair"
}

# ─── Installation : outils communs ──────────────────────────────────────────
source_locale() {  # $1 = dossier apt du bundle
  echo "deb [trusted=yes] file:$1 ./" > /etc/apt/sources.list.d/hibou.list
  # Sandbox root : le bundle est sous ~hibou (0750 sur Ubuntu 26.04), illisible pour l’utilisateur _apt.
  APT_HIBOU=(-o Dir::Etc::sourcelist=/etc/apt/sources.list.d/hibou.list -o Dir::Etc::sourceparts=- -o APT::Get::List-Cleanup=0
             -o APT::Sandbox::User=root)
  printf 'Package: *\nPin: version %s*\nPin-Priority: 1001\n' "$NVIDIA_VERSION" > /etc/apt/preferences.d/hibou-nvidia
  apt-get "${APT_HIBOU[@]}" update -qq
}
# --no-remove : apt s’arrête plutôt que de désinstaller un paquet (cas du serveur SSH en REX 2).
apt_hibou() {
  DEBIAN_FRONTEND=noninteractive apt-get "${APT_HIBOU[@]}" install -y -qq --no-remove --no-install-recommends "$@" >/dev/null \
    || erreur "apt refuse l’installation." "Relance à la main pour voir le détail : apt-get ${APT_HIBOU[*]} install --no-remove $*"
