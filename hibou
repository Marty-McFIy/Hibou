# Module NVIDIA compilé pour le noyau le plus récent installé, celui du prochain démarrage.
verifier_dkms() {
  local k; k=$(find /lib/modules -mindepth 1 -maxdepth 1 -printf '%f\n' | sort -V | tail -1)
  dkms status -k "$k" 2>/dev/null | grep -q 'nvidia.*installed' \
    || erreur "Le module NVIDIA n’est pas compilé pour le noyau $k." "Lis /var/lib/dkms/nvidia*/*/build/make.log ; il manque souvent les en-têtes de ce noyau."
  fait "Module NVIDIA $NVIDIA_VERSION compilé pour le noyau $k."
}

demarrer() {  # dossier [services...]
  (cd "$1" && docker compose up -d --quiet-pull --remove-orphans "${@:2}") \
    || erreur "Les services de $1 ne démarrent pas." "Lis : docker compose -f $1/compose.yaml logs --tail 50"
  # « up » réussit même si un conteneur plante juste après (ex. droits d’un volume) : on regarde 30 s plus tard.
  local i boucle
  for i in 1 2 3; do
    sleep 10
    boucle=$(cd "$1" && docker compose ps -a --status restarting --format '{{.Service}}' | tr '\n' ' ')
    [[ -z "${boucle// }" ]] || break
  done
  [[ -z "${boucle// }" ]] || erreur "Service(s) qui redémarrent en boucle : $boucle" "Lis : docker compose -f $1/compose.yaml logs --tail 50 $boucle"
}

