api() {  # méthode chemin [json]
  curl -fsS -u "$ADMIN:$MDP" -X "$1" -H 'Content-Type: application/json' \
    "http://127.0.0.1:3000/api/v1$2" ${3:+-d "$3"}
}
app_oauth() {  # nom redirection... → "id secret" ; remplace une application du même nom
  local id uris; uris=$(printf '%s\n' "${@:2}" | jq -R . | jq -sc .)
  for id in $(api GET /user/applications/oauth2 | jq -r --arg n "$1" '.[] | select(.name==$n) | .id'); do
    api DELETE "/user/applications/oauth2/$id" >/dev/null
  done
  api POST /user/applications/oauth2 "{\"name\":\"$1\",\"redirect_uris\":$uris,\"confidential_client\":true}" \
    | jq -r '"\(.client_id) \(.client_secret)"'
}

amorcer() {  # dépôt dossier : premier commit, avant la protection de main
  local tmp; tmp=$(mktemp -d)
  local auth; auth="Authorization: Basic $(printf '%s:%s' "$ADMIN" "$MDP" | base64 -w0)"
  git -c http.extraHeader="$auth" clone -q "http://127.0.0.1:3000/hibou/$1.git" "$tmp/d"
  cp -a "$2/." "$tmp/d/"
  sed -i "s/hibou\.lan/$DOMAINE/g" "$tmp/d/mkdocs.yml" 2>/dev/null || true
  (cd "$tmp/d" && git add -A && git -c user.name=Hibou -c user.email="hibou@$DOMAINE" commit -qm "Amorce Hibou" && git -c http.extraHeader="$auth" push -q origin main)
  rm -rf "$tmp"
  note "$1 amorcé."
}

# Dépôt déjà amorcé : les outils, le workflow et les gabarits d’une nouvelle version arrivent par une pull request
# (main est protégée et la fusion reste humaine). Rien n’est proposé si tout est déjà à jour ; PR déjà ouverte : sa branche est mise à jour.
# La PR est ouverte au nom de hibou-redac (en-tête Sudo) : ouverte par l’administrateur, il ne pourrait pas l’approuver lui-même.
outils_par_pr() {  # dépôt dossier_amorce
  local tmp b="hibou/outils-$VERSION_HIBOU" auth p ouverte=""
  auth="Authorization: Basic $(printf '%s:%s' "$ADMIN" "$MDP" | base64 -w0)"
  api GET "/repos/hibou/$1/pulls?state=open" | jq -e --arg b "$b" 'any(.[]; .head.ref == $b)' >/dev/null && ouverte=1
  tmp=$(mktemp -d)
  git -c http.extraHeader="$auth" clone -q "http://127.0.0.1:3000/hibou/$1.git" "$tmp/d" || { rm -rf "$tmp"; return 1; }
  for p in outils .forgejo templates .markdownlint-cli2.yaml docs/assets; do   # docs/assets : charte du site
    [[ -e "$2/$p" ]] && install -d "$tmp/d/$(dirname "$p")" && cp -a "$2/$p" "$tmp/d/$(dirname "$p")/"
  done
  if [[ -n "$(git -C "$tmp/d" status --porcelain)" ]]; then
    git -C "$tmp/d" checkout -qB "$b"
    git -C "$tmp/d" add -A
    git -C "$tmp/d" -c user.name=Hibou -c user.email="hibou@$DOMAINE" commit -qm "Hibou $VERSION_HIBOU : mise à jour des outils"
    if [[ -n "$ouverte" ]]; then
      git -C "$tmp/d" -c http.extraHeader="$auth" push -q -f origin "$b" && note "$1 : pull request des outils $VERSION_HIBOU mise à jour, à relire et fusionner." \
        || note "$1 : la branche $b n’a pas pu être mise à jour."
    else
    git -C "$tmp/d" -c http.extraHeader="$auth" push -q -f origin "$b" \
      && jq -nc --arg b "$b" --arg v "$VERSION_HIBOU" '{head:$b, base:"main", title:("Hibou " + $v + " : mise à jour des outils"),
           body:"Outils, workflow et gabarits de la nouvelle version du bundle. À relire et fusionner pour que le runner les utilise."}' \
      | curl -fsS -u "$ADMIN:$MDP" -H "Sudo: hibou-redac" -H 'Content-Type: application/json' -X POST "http://127.0.0.1:3000/api/v1/repos/hibou/$1/pulls" -d @- >/dev/null \
      && note "$1 : outils de la version $VERSION_HIBOU proposés par pull request, à relire et fusionner." \
      || note "$1 : la pull request de mise à jour des outils n’a pas pu être ouverte."
    fi
  fi
  rm -rf "$tmp"
}

# Jeton d’API d’un compte de service. Les jetons précédents du même usage sont révoqués : sans cela, chaque
# « configurer » en ajoutait un et un jeton divulgué restait valide.
jeton_neuf() {  # compte usage scopes_json → jeton
  local nom j id f=http://127.0.0.1:3000/api/v1/users/$1/tokens
  nom="$2-$(date +%Y%m%d%H%M%S)"
  j=$(curl -fsS -u "$ADMIN:$MDP" -H "Sudo: $1" -H 'Content-Type: application/json' -X POST "$f" \
      -d "$(jq -nc --arg n "$nom" --argjson s "$3" '{name:$n,scopes:$s}')" | jq -r '.sha1 // empty')
  [[ -n "$j" ]] || return 1
  for id in $(curl -fsS -u "$ADMIN:$MDP" -H "Sudo: $1" "$f?limit=100" \
      | jq -r --arg p "$2-" --arg n "$nom" '.[] | select((.name | startswith($p)) and .name != $n) | .id'); do
    curl -fsS -u "$ADMIN:$MDP" -H "Sudo: $1" -X DELETE "$f/$id" >/dev/null || return 1
  done
  printf '%s' "$j"
}

equipe_id() { api GET "/orgs/hibou/teams/search?q=$1" | jq -r --arg n "$1" '.data[] | select(.name==$n) | .id'; }

configurer() {
  { set +x; } 2>/dev/null   # jamais de trace ici : les secrets apparaîtraient en clair
  exiger_root
  local b="${1:-$ICI_HIBOU}"
  secrets "$b"
  [[ -f /srv/forgejo/compose.yaml ]] || erreur "Forgejo n’est pas installé ici." "Lance « hibou installer forge » d’abord."
  local i; for i in $(seq 1 60); do curl -fsS http://127.0.0.1:3000/api/healthz >/dev/null 2>&1 && break; sleep 2; done
  curl -fsS http://127.0.0.1:3000/api/healthz >/dev/null || erreur "Forgejo ne répond pas." "Vérifie avec : docker compose -f /srv/forgejo/compose.yaml ps"
  ADMIN="$HIBOU_ADMIN_NOM"; MDP="$HIBOU_ADMIN_MDP"

  etape "Compte administrateur Forgejo"
  if ! api GET /user >/dev/null 2>&1; then
    docker exec -u git hibou-forge-forgejo-1 forgejo --config /data/gitea/conf/app.ini admin user create --admin \
      --username "$ADMIN" --email "$HIBOU_ADMIN_MAIL" --password "$MDP" --must-change-password=false >/dev/null
    api GET /user >/dev/null || erreur "Le compte $ADMIN ne répond pas." "Si la double authentification est déjà active, désactive-la le temps de relancer « hibou configurer »."
  fi
  fait "$ADMIN prêt. Active sa double authentification après l’installation."

  etape "Organisation et équipes"
  api GET /orgs/hibou >/dev/null 2>&1 || api POST /orgs '{"username":"hibou","full_name":"Hibou","visibility":"private"}' >/dev/null
  local equipe unites='["repo.code","repo.issues","repo.pulls","repo.releases","repo.wiki","repo.actions"]'
  for equipe in dev doc; do
    [[ -n "$(equipe_id "$equipe")" ]] \
      || api POST /orgs/hibou/teams "{\"name\":\"$equipe\",\"permission\":\"write\",\"units\":$unites,\"includes_all_repositories\":true}" >/dev/null
    api PUT "/teams/$(equipe_id "$equipe")/members/$ADMIN" >/dev/null
  done
  fait "Organisation hibou, équipes dev et doc."

  etape "Utilisateurs"
  local u nom mail mdp eq k
  for u in "${HIBOU_UTILISATEURS[@]}"; do
    IFS='|' read -r nom mail mdp eq k <<< "$u"
    api GET "/users/$nom" >/dev/null 2>&1 \
      || api POST /admin/users "$(jq -nc --arg n "$nom" --arg m "$mail" --arg p "$mdp" '{username:$n,email:$m,password:$p,must_change_password:true,visibility:"private"}')" >/dev/null
    for equipe in ${eq//,/ }; do api PUT "/teams/$(equipe_id "$equipe")/members/$nom" >/dev/null; done
    note "$nom ($eq)"
  done
  fait "${#HIBOU_UTILISATEURS[@]} utilisateurs ; mot de passe à changer à la première connexion."

  etape "Dépôts protégés"
  local depot
  for depot in hibou-infra hibou-docs hibou-eval; do
    if ! api GET "/repos/hibou/$depot" >/dev/null 2>&1; then
      api POST /orgs/hibou/repos "{\"name\":\"$depot\",\"auto_init\":true,\"default_branch\":\"main\",\"private\":true}" >/dev/null
      [[ -d "$b/amorces/$depot" ]] && amorcer "$depot" "$b/amorces/$depot"
    fi
    api GET "/repos/hibou/$depot/branch_protections/main" >/dev/null 2>&1 \
      || api POST "/repos/hibou/$depot/branch_protections" '{"rule_name":"main","enable_push":false,"required_approvals":1,"block_on_rejected_reviews":true,"dismiss_stale_approvals":true}' >/dev/null
  done
  fait "main protégée : fusion par pull request approuvée uniquement."

  etape "Compte de rédaction hibou-redac"
  if ! api GET /users/hibou-redac >/dev/null 2>&1; then
    api POST /admin/users "{\"username\":\"hibou-redac\",\"email\":\"hibou-redac@$DOMAINE\",\"password\":\"$(cle)\",\"must_change_password\":false,\"visibility\":\"private\"}" >/dev/null
  fi
  api PUT /repos/hibou/hibou-docs/collaborators/hibou-redac '{"permission":"write"}' >/dev/null
  local jeton_redac
  jeton_redac=$(jeton_neuf hibou-redac open-webui '["write:repository"]') || erreur "Forgejo refuse le jeton de hibou-redac." "Relance « hibou configurer »."
  fait "hibou-redac n’écrit que dans hibou-docs, par branches."

  etape "Runner Forgejo Actions"
  if [[ ! -f /srv/forgejo/runner/.runner ]]; then
    local jeton_runner
    jeton_runner=$(docker exec -u git hibou-forge-forgejo-1 forgejo actions generate-runner-token)
    cat > /srv/forgejo/runner/config.yml <<EOF
log: { level: info }
runner: { file: /data/.runner, capacity: 1 }
container:
  network: hibou-forge_default
  force_pull: false
  options: -v /srv/docs-site:/publication
  valid_volumes: ["/srv/docs-site"]
EOF
    (cd /srv/forgejo && docker compose --profile runner run --rm -T runner \
      forgejo-runner register --no-interactive --config /data/config.yml --instance http://forgejo:3000 \
      --token "$jeton_runner" --name forge --labels "hibou-docs:docker://hibou/docs-builder:actuel" >/dev/null)
  fi
  fait "Runner enregistré avec l’étiquette hibou-docs."

  etape "Compte de l’agent hibou-dev"
  if ! api GET /users/hibou-dev >/dev/null 2>&1; then
    api POST /admin/users "{\"username\":\"hibou-dev\",\"email\":\"hibou-dev@$DOMAINE\",\"password\":\"$(cle)\",\"must_change_password\":false,\"visibility\":\"private\"}" >/dev/null
  fi
  api PUT "/teams/$(equipe_id dev)/members/hibou-dev" >/dev/null
  # L’équipe dev peut créer des dépôts dans l’organisation : l’agent y ouvre ses nouveaux projets.
  api PATCH "/teams/$(equipe_id dev)" '{"name":"dev","can_create_org_repo":true}' >/dev/null
  local jeton_dev
  jeton_dev=$(jeton_neuf hibou-dev opencode '["write:repository","write:organization","write:issue","read:package"]') \
    || erreur "Forgejo refuse le jeton de hibou-dev." "Relance « hibou configurer »."
  umask 077
  printf 'FORGEJO_URL=https://forge.%s\nFORGEJO_ORG=hibou\nFORGEJO_TOKEN=%s\n' "$DOMAINE" "$jeton_dev" > /srv/hibou/opencode.env
  # pip et npm de l’agent lisent les paquets du miroir dans Forgejo.
  printf 'PIP_INDEX_URL=https://hibou-dev:%s@forge.%s/api/packages/hibou/pypi/simple\nPIP_CERT=/etc/hibou/ca-bundle.crt\n' "$jeton_dev" "$DOMAINE" >> /srv/hibou/opencode.env
  printf 'registry=https://forge.%s/api/packages/hibou/npm/\n//forge.%s/api/packages/hibou/npm/:_authToken=%s\ncafile=/etc/hibou/ca-bundle.crt\n' \
    "$DOMAINE" "$DOMAINE" "$jeton_dev" > /srv/hibou/npmrc
  chown 1000:1000 /srv/hibou/npmrc
  umask 022
  consignes_agent
  install -d -m 700 -o 1000 -g 1000 /srv/hibou/ssh
  base64 -d <<< "$HIBOU_SSH_AGENT_B64" > /srv/hibou/ssh/id_ed25519
  chmod 600 /srv/hibou/ssh/id_ed25519   # écrite sous umask 022 : ssh-keygen refuserait une clé en 0644
  ssh-keygen -y -f /srv/hibou/ssh/id_ed25519 > /srv/hibou/ssh/id_ed25519.pub
  local pub; pub=$(cat /srv/hibou/ssh/id_ed25519.pub)
  api GET /users/hibou-dev/keys | jq -e --arg k "${pub% *}" '.[] | select(.key | startswith($k))' >/dev/null \
    || api POST /admin/users/hibou-dev/keys "{\"title\":\"opencode\",\"key\":\"$pub\",\"read_only\":false}" >/dev/null
  printf 'Host forge.%s\n  Port 2222\n  User git\n  IdentityFile ~/.ssh/id_ed25519\n' "$DOMAINE" > /srv/hibou/ssh/config
  ssh-keyscan -p 2222 127.0.0.1 2>/dev/null | sed "s/^\[127.0.0.1\]:2222/[forge.$DOMAINE]:2222/" > /srv/hibou/ssh/known_hosts
  chown -R 1000:1000 /srv/hibou/ssh && chmod 600 /srv/hibou/ssh/*
  fait "hibou-dev créé, membre de dev, clé SSH déposée pour OpenCode."

  etape "Relecture des pull requests par le LLM dev"
  if ! api GET /users/hibou-relecteur >/dev/null 2>&1; then
    api POST /admin/users "{\"username\":\"hibou-relecteur\",\"email\":\"hibou-relecteur@$DOMAINE\",\"password\":\"$(cle)\",\"must_change_password\":false,\"visibility\":\"private\"}" >/dev/null
  fi
  [[ -n "$(equipe_id relecture)" ]] \
    || api POST /orgs/hibou/teams "{\"name\":\"relecture\",\"permission\":\"read\",\"units\":[\"repo.code\",\"repo.pulls\"],\"includes_all_repositories\":true}" >/dev/null
  api PUT "/teams/$(equipe_id relecture)/members/hibou-relecteur" >/dev/null
  local jeton_rel secret_rel h
  jeton_rel=$(jeton_neuf hibou-relecteur relecteur '["write:repository"]') || erreur "Forgejo refuse le jeton de hibou-relecteur." "Relance « hibou configurer »."
  secret_rel=$(cle)
  for h in $(api GET /orgs/hibou/hooks | jq -r '.[] | select(.config.url=="http://relecteur:8090/") | .id'); do api DELETE "/orgs/hibou/hooks/$h" >/dev/null; done
  api POST /orgs/hibou/hooks "$(jq -nc --arg s "$secret_rel" '{type:"forgejo",active:true,events:["pull_request"],config:{url:"http://relecteur:8090/",content_type:"json",secret:$s}}')" >/dev/null
  profil dev "$HIBOU_PROFIL_DEV"
  umask 077
  cat > /srv/hibou/relecteur.env <<EOF
FORGEJO=http://forgejo:3000
JETON=$jeton_rel
SECRET=$secret_rel
LLM_URL=http://$HIBOU_IP_DEV:8080/v1
LLM_CLE=${HIBOU_CLE_RELECTEUR:-$HIBOU_CLE_WEBUI}
MODELE=$PRINCIPAL
EOF
  umask 022
  fait "Chaque pull request de l’organisation hibou reçoit un avis de hibou-relecteur ($PRINCIPAL), au dernier rang de la file."

  etape "Applications de connexion"
  local owui code pve graf
  owui=$(app_oauth "Open WebUI" "https://chat.$DOMAINE/oauth/oidc/callback")
  code=$(app_oauth "OpenCode" "https://code.$DOMAINE/oauth2/callback")
  # Une adresse de retour par hôte Proxmox : on se connecte à chacun par son propre nom.
  local hotes=("https://pve-doc.$DOMAINE:8006" "https://pve-dev.$DOMAINE:8006") n=1 ip
  for ip in $HIBOU_IP_CLUSTER; do hotes+=("https://pve$n.$DOMAINE:8006"); n=$((n + 1)); done
  pve=$(app_oauth "Proxmox" "${hotes[@]}")
  graf=$(app_oauth "Grafana" "https://supervision.$DOMAINE/login/generic_oauth")
  umask 077
  cat > /srv/hibou/open-webui-oidc.env <<EOF
ENABLE_OAUTH_SIGNUP=true
ENABLE_LOGIN_FORM=false
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OAUTH_PROVIDER_NAME=Hibou · Forge
OPENID_PROVIDER_URL=https://forge.$DOMAINE/.well-known/openid-configuration
OAUTH_CLIENT_ID=${owui% *}
OAUTH_CLIENT_SECRET=${owui#* }
OAUTH_SCOPES=openid email profile groups
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=groups
OAUTH_ALLOWED_ROLES=hibou:doc,hibou:dev,hibou:owners
OAUTH_ADMIN_ROLES=hibou:owners
EOF
  cat > /srv/hibou/code-oidc.env <<EOF
OAUTH2_PROXY_CLIENT_ID=${code% *}
OAUTH2_PROXY_CLIENT_SECRET=${code#* }
OAUTH2_PROXY_COOKIE_SECRET=$(head -c 32 /dev/urandom | base64 | tr -dc 'A-Za-z0-9' | head -c 32)
EOF
  cat > /srv/supervision/grafana.env <<EOF
GF_SECURITY_ADMIN_USER=$ADMIN
GF_SECURITY_ADMIN_PASSWORD=$MDP
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Hibou · Forge
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=${graf% *}
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=${graf#* }
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile groups
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://forge.$DOMAINE/login/oauth/authorize
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://forge.$DOMAINE/login/oauth/access_token
GF_AUTH_GENERIC_OAUTH_API_URL=https://forge.$DOMAINE/login/oauth/userinfo
GF_AUTH_GENERIC_OAUTH_TLS_CLIENT_CA=/etc/hibou/ca.crt
# Paquet d’autorités aussi pour le client HTTP général de Grafana (Go lit SSL_CERT_FILE).
SSL_CERT_FILE=/etc/hibou/ca.crt
# Connexion directe par Forgejo (page à la charte) ; formulaire local de secours : /login?disableAutoLogin
GF_AUTH_OAUTH_AUTO_LOGIN=true
# Accueil sur le tableau Hibou, sans le fil d’actualités de grafana.com (hors ligne : rien à afficher).
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/provisioning/dashboards/hibou.json
GF_NEWS_NEWS_FEED_ENABLED=false
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(groups[*], 'hibou:owners') && 'Admin' || 'Viewer'
GF_AUTH_GENERIC_OAUTH_ALLOWED_GROUPS=hibou:owners,hibou:dev,hibou:doc
GF_AUTH_GENERIC_OAUTH_GROUPS_ATTRIBUTE_PATH=groups
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_DISABLE_LOGIN_FORM=true
EOF
  printf 'PVE_ID=%s\nPVE_SECRET=%s\n' "${pve% *}" "${pve#* }" > /srv/hibou/pve-oidc.env
  umask 022
  docker cp hibou-forge-caddy-1:/data/caddy/pki/authorities/local/root.crt /srv/supervision/hibou-ca.crt
  cat /etc/ssl/certs/ca-certificates.crt /srv/supervision/hibou-ca.crt > /srv/supervision/ca.crt
  cat /etc/ssl/certs/ca-certificates.crt /srv/supervision/hibou-ca.crt > /srv/hibou/ca-bundle.crt
  cp /srv/supervision/hibou-ca.crt /srv/hibou/hibou-ca.crt
  # Profils actifs à chaque « docker compose up », y compris au redémarrage.
  echo "COMPOSE_PROFILES=apps,runner" > /srv/forgejo/.env
  demarrer /srv/forgejo
  (cd /srv/forgejo && docker compose up -d --force-recreate grafana uptime-kuma >/dev/null 2>&1) || true
  fait "Connexion unique par Forgejo : Open WebUI, OpenCode, Grafana."

  etape "Open WebUI : outil, modèles et templates"
  amorcer_open_webui "$b" "$jeton_redac" || note "Open WebUI n’a pas tout accepté : importe à la main $b/amorces/open-webui/ (outil et modèles)."

  etape "Accès"
  local acces=/root/hibou-acces.txt
  umask 077
  {
    echo "Hibou $VERSION_HIBOU — accès ($(date +%F)). Fichier à garder hors ligne."
    echo; echo "Certificat racine à installer sur les postes : /srv/hibou/hibou-ca.crt"
    echo; echo "Clés d’API (en-tête Authorization: Bearer <clé>) :"
    echo "  https://llm-doc.$DOMAINE/v1   https://llm-dev.$DOMAINE/v1"
    for u in "${HIBOU_UTILISATEURS[@]}"; do IFS='|' read -r nom mail mdp eq k <<< "$u"; printf '  %-20s %s\n' "$nom" "$k"; done
    echo; echo "Paquets hors ligne (jeton Forgejo personnel avec read:package) :"
    echo "  pip  : pip config set global.index-url https://<compte>:<jeton>@forge.$DOMAINE/api/packages/hibou/pypi/simple"
    echo "  npm  : npm config set registry https://forge.$DOMAINE/api/packages/hibou/npm/"
    echo "         npm config set //forge.$DOMAINE/api/packages/hibou/npm/:_authToken <jeton>"
    echo "  docker login forge.$DOMAINE ; docker pull forge.$DOMAINE/hibou/<image>:<tag>"
    echo; echo "Proxmox : « hibou installer » déclare Forgejo sur chaque hôte. À la main :"
    echo "  pveum realm add forgejo --type openid --issuer-url https://forge.$DOMAINE --client-id ${pve% *} --client-key ${pve#* } --username-claim username --autocreate 1"
  } > "$acces"
  umask 022
  fait "Clés d’API et commande Proxmox dans $acces (lisible par root seulement)."
  note "Uptime Kuma : crée son administrateur sur https://etat.$DOMAINE au premier accès."
  printf '\n'; dire "Forge configurée. Installe maintenant doc et dev depuis leurs hôtes."
}

# Premier administrateur d’Open WebUI créé par l’API, puis outil, modèles et base de templates.
amorcer_open_webui() {  # bundle jeton_redac
  local u=http://127.0.0.1:8081/api/v1 jeton i
  for i in $(seq 1 90); do curl -fsS http://127.0.0.1:8081/health >/dev/null 2>&1 && break; sleep 2; done
  local ident; ident=$(jq -nc --arg n "$ADMIN" --arg e "$HIBOU_ADMIN_MAIL" --arg p "$MDP" '{name:$n,email:$e,password:$p}')
  jeton=$(curl -fsS "$u/auths/signup" -H 'Content-Type: application/json' -d "$ident" 2>/dev/null | jq -r .token) \
    || jeton=$(curl -fsS "$u/auths/signin" -H 'Content-Type: application/json' -d "$ident" | jq -r .token) || return 1
  local h=(-H "Authorization: Bearer $jeton" -H 'Content-Type: application/json')
  # Open WebUI 0.13 : sans autorisation, une ressource n’est visible que de l’administrateur (« Model not found » pour les autres).
  # Modèles de chat, outils et bases Hibou : lecture pour tous les comptes.
  local public='[{"principal_type":"user","principal_id":"*","permission":"read"}]'
  # Modèle lu sur l’entrée : créé, ou mis à jour s’il existe (Open WebUI répond 401 à la création d’un identifiant déjà pris).
  modele_owui() {
    # Modèles de chat : bouton « Compression du contexte » proposé et actif par défaut (chacun peut le couper).
    # file_context : Open WebUI 0.13 ne donne le texte d’un fichier joint qu’à un modèle qui a cette capacité ; sans elle,
    # le modèle doit lire le fichier par ses propres outils, ce que les petits modèles ne font pas (documents joints ignorés).
    local m; m=$(jq -c --argjson g "$public" 'if .is_active then .access_grants = $g
      | .meta.capabilities = ((.meta.capabilities // {}) + {file_context: true})
      | .meta.filterIds = ((.meta.filterIds // []) + ["compression_contexte"] | unique)
      | .meta.defaultFilterIds = ((.meta.defaultFilterIds // []) + ["compression_contexte"] | unique) else . end')
    curl -fsS "${h[@]}" "$u/models/create" -d "$m" >/dev/null 2>&1 \
      || curl -fsS "${h[@]}" "$u/models/model/update?id=$(jq -r .id <<< "$m")" -d "$m" >/dev/null || return 1
    # La mise à jour ignore access_grants : les droits ont leur propre point d’entrée.
    [[ "$(jq -r .is_active <<< "$m")" != true ]] \
      || jq -c '{id, access_grants}' <<< "$m" | curl -fsS "${h[@]}" "$u/models/model/access/update" -d @- >/dev/null
  }
  # Outil : créé, ou son code remplacé (une nouvelle version doit atteindre une installation existante).
  local outil; outil=$(jq -n --rawfile c "$1/amorces/open-webui/publier_forgejo.py" \
    --argjson g "$public" '{id:"publier_forgejo",name:"Publier dans Forgejo",content:$c,access_grants:$g,meta:{description:"Dépose un document dans hibou-docs et ouvre une pull request."}}')
  curl -fsS "${h[@]}" "$u/tools/create" -d "$outil" >/dev/null 2>&1 \
    || curl -fsS "${h[@]}" "$u/tools/id/publier_forgejo/update" -d "$outil" >/dev/null || return 1
  curl -fsS "${h[@]}" "$u/tools/id/publier_forgejo/access/update" -d "{\"access_grants\":$public}" >/dev/null || return 1
  # Export de documents (Word, PDF, PowerPoint, Excel) téléchargeables dans le chat.
  outil=$(jq -n --rawfile c "$1/amorces/open-webui/exporter_document.py" \
    --argjson g "$public" '{id:"exporter_document",name:"Exporter un document",content:$c,access_grants:$g,meta:{description:"Crée un fichier Word, PDF, PowerPoint ou Excel à télécharger dans le chat."}}')
  curl -fsS "${h[@]}" "$u/tools/create" -d "$outil" >/dev/null 2>&1 \
    || curl -fsS "${h[@]}" "$u/tools/id/exporter_document/update" -d "$outil" >/dev/null || return 1
  curl -fsS "${h[@]}" "$u/tools/id/exporter_document/access/update" -d "{\"access_grants\":$public}" >/dev/null || return 1
  # Compression du contexte : filtre global, réglé sur le contexte réel de chaque modèle servi (doc et dev).
  # Même nom sur doc et dev (ex. qwen3.5-4b en 8k et 32k) : le plus petit, sûr quel que soit le serveur qui répond.
  local fn ctx_json="{}" r n l a c x
  for r in doc dev; do
    n="HIBOU_PROFIL_${r^^}"; profil "$r" "${!n}"
    for l in "${MODELES_ROLE[@]}"; do IFS='|' read -r a _ _ c x <<< "$l"; servi "$x" && [[ "$x" != *--embedding* ]] && ctx_json=$(jq -c --arg a "$a" --argjson c "$c" '.[$a] = ([.[$a] // $c, $c] | min)' <<< "$ctx_json"); done
  done
  # Modèles de base enregistrés et ouverts à tous : sans eux, Open WebUI 0.13 refuse aux comptes non administrateurs
  # tout modèle Hibou construit dessus (« Model not found », raison base_model_unregistered).
  for a in $(jq -r 'keys[] | select(. != "fim")' <<< "$ctx_json"); do
    jq -nc --arg i "$a" '{id:$i,name:$i,base_model_id:null,meta:{},params:{},is_active:true}' | modele_owui || return 1
  done
  fn=$(jq -n --rawfile c "$1/amorces/open-webui/compression_contexte.py" \
    '{id:"compression_contexte",name:"Compression du contexte",content:$c,meta:{description:"Résume les anciens échanges quand une conversation approche de la limite du modèle."}}')
  curl -fsS "${h[@]}" "$u/functions/create" -d "$fn" >/dev/null 2>&1 \
    || curl -fsS "${h[@]}" "$u/functions/id/compression_contexte/update" -d "$fn" >/dev/null || return 1
  jq -nc --arg c "$ctx_json" '{contextes:$c, seuil:0.5, garder:4}' | curl -fsS "${h[@]}" "$u/functions/id/compression_contexte/valves/update" -d @- >/dev/null || return 1
  local etat; etat=$(curl -fsS "${h[@]}" "$u/functions/id/compression_contexte")
  [[ "$(jq -r .is_active <<< "$etat")" == true ]] || curl -fsS "${h[@]}" -X POST "$u/functions/id/compression_contexte/toggle" >/dev/null || return 1
  [[ "$(jq -r .is_global <<< "$etat")" == true ]] || curl -fsS "${h[@]}" -X POST "$u/functions/id/compression_contexte/toggle/global" >/dev/null || return 1
  if [[ -n "$2" ]]; then   # installation : jeton de hibou-redac (en mise à jour, les valves déjà en place sont gardées)
  jq -nc --arg f "https://forge.$DOMAINE" --arg j "$2" '{forgejo_url:$f,depot:"hibou/hibou-docs",jeton:$j}' \
    | curl -fsS "${h[@]}" "$u/tools/id/publier_forgejo/valves/update" -d @- >/dev/null || return 1
  fi
  # Embeddings : 4 requêtes simultanées par lots de 16. Open WebUI ne lit ses variables RAG_* qu’au tout premier démarrage
  # (ensuite la valeur en base l’emporte) : sans ce réglage, l’indexation d’un gros PDF part en rafale et le serveur doc répond 429.
  # Recherche hybride (mots-clés BM25 + sens) : retrouve aussi les termes exacts (numéro de recommandation, nom de commande).
  # Seulement avec le reranker de la carte de recherche : sans lui, Open WebUI reclasse les candidats en recalculant leurs
  # embeddings (~8 s par extrait sur le processeur, plusieurs minutes par question). Sinon, recherche par le sens seule.
  local rr='{"ENABLE_RAG_HYBRID_SEARCH":false,"TOP_K":10,"RAG_RERANKING_ENGINE":"","RAG_RERANKING_MODEL":""}'
  [[ "${HIBOU_RERANKER:-0}" != 1 ]] || rr=$(jq -nc --arg u "http://$HIBOU_IP_DOC:8080/v1/rerank" --arg k "$HIBOU_CLE_WEBUI" \
    '{ENABLE_RAG_HYBRID_SEARCH:true,TOP_K:20,TOP_K_RERANKER:5,HYBRID_BM25_WEIGHT:0.5,RAG_RERANKING_ENGINE:"external",RAG_RERANKING_MODEL:"qwen3-reranker",
      RAG_EXTERNAL_RERANKER_URL:$u,RAG_EXTERNAL_RERANKER_API_KEY:$k,RAG_EXTERNAL_RERANKER_TIMEOUT:"120"}')
  curl -fsS "${h[@]}" "$u/retrieval/config/update" -d "$rr" >/dev/null || return 1
  # Clés des serveurs de modèles : Open WebUI les garde en base (l’environnement n’est lu qu’au premier démarrage).
  # Imposées à chaque passage, pour qu’un renouvellement des secrets les atteigne.
  curl -fsS "${h[@]}" "${u%/api/v1}/openai/config" | jq -c --arg k "$HIBOU_CLE_WEBUI" '.OPENAI_API_KEYS = [.OPENAI_API_BASE_URLS[] | $k]' \
    | curl -fsS "${h[@]}" "${u%/api/v1}/openai/config/update" -d @- >/dev/null || return 1
  curl -fsS "${h[@]}" "$u/retrieval/embedding" | jq -c --arg k "$HIBOU_CLE_WEBUI" '.RAG_EMBEDDING_BATCH_SIZE = 16 | .RAG_EMBEDDING_CONCURRENT_REQUESTS = 4 | .openai_config.key = $k' \
    | curl -fsS "${h[@]}" "$u/retrieval/embedding/update" -d @- >/dev/null || return 1
  # Base de connaissances avec les templates de hibou-docs.
  local kb f fid
  kb=$(curl -fsS "${h[@]}" "$u/knowledge/" | jq -c '(.items? // .)[] | select(.name=="Hibou · Templates")' | head -1)
  [[ -n "$kb" ]] || kb=$(curl -fsS "${h[@]}" "$u/knowledge/create" -d '{"name":"Hibou · Templates","description":"Templates de hibou-docs"}')
  curl -fsS "${h[@]}" "$u/knowledge/$(jq -r .id <<< "$kb")/access/update" -d "{\"access_grants\":$public}" >/dev/null || return 1
  # Remplie tant qu’elle est vide : à la première installation de forge, les embeddings (VM doc) n’existent pas encore.
  # GET /knowledge/{id} ne liste plus ses fichiers : on compte par /files (champ total).
  if [[ "$(curl -fsS "${h[@]}" "$u/knowledge/$(jq -r .id <<< "$kb")/files" | jq '.total // 0')" == 0 ]]; then
    for f in "$1"/amorces/hibou-docs/templates/*.md; do
      fid=$(curl -fsS -H "Authorization: Bearer $jeton" -F "file=@$f" "$u/files/?process_in_background=false" | jq -r .id)   # texte extrait avant l’ajout à la base
      curl -fsS "${h[@]}" "$u/knowledge/$(jq -r .id <<< "$kb")/file/add" -d "{\"file_id\":\"$fid\"}" >/dev/null 2>&1 \
        || { note "Base « Hibou · Templates » vide : les embeddings de doc ne répondent pas. Après « installer doc », relance « hibou mettre-a-jour forge »."; break; }
    done
  fi
  profil doc "$HIBOU_PROFIL_DOC"
  # Base « Hibou · Documentation » : alimentée par le runner à chaque fusion dans hibou-docs.
  local kbdoc cle_owui
  kbdoc=$(curl -fsS "${h[@]}" "$u/knowledge/" | jq -c '(.items? // .)[] | select(.name=="Hibou · Documentation")' | head -1)
  [[ -n "$kbdoc" ]] || kbdoc=$(curl -fsS "${h[@]}" "$u/knowledge/create" -d '{"name":"Hibou · Documentation","description":"Documentation validée de hibou-docs"}')
  curl -fsS "${h[@]}" "$u/knowledge/$(jq -r .id <<< "$kbdoc")/access/update" -d "{\"access_grants\":$public}" >/dev/null || return 1
  # Renouveler la clé révoque l’ancienne : un chargement de la base sécurité en cours l’utilise encore et échouerait
  # sur tout le reste. On l’arrête d’abord (--init : le chargeur reçoit le signal) ; il est relancé plus bas et reprend où il s’est arrêté.
  systemctl stop hibou-securite 2>/dev/null || true
  cle_owui=$(curl -fsS "${h[@]}" -X POST "$u/auths/api_key" | jq -r '.api_key // empty')
  if [[ -n "$cle_owui" ]]; then
    # Base remplie avec la documentation fusionnée (main de hibou-docs), par l’outil du bundle (toujours le plus récent) :
    # pas avec les documents de départ, qui effaceraient les pages validées depuis l’installation.
    local docs_main; docs_main=$(mktemp -d)
    # La clé vient d’être renouvelée : le runner reçoit la nouvelle dans tous les cas.
    if ! api PUT /repos/hibou/hibou-docs/actions/secrets/OWUI_CLE "$(jq -nc --arg d "$cle_owui" '{data:$d}')" >/dev/null; then
      note "Clé du runner refusée par Forgejo : la synchronisation de la documentation vers le chat échouera (secret OWUI_CLE de hibou-docs)."
    elif ! curl -fsS -m 5 "http://$HIBOU_IP_DOC:8080/health" >/dev/null 2>&1; then
      note "Serveur doc injoignable (il calcule les embeddings) : documentation non envoyée au chat. Elle le sera à la mise à jour de doc ou à la prochaine fusion."
    else
      git -c http.extraHeader="Authorization: Basic $(printf '%s:%s' "$ADMIN" "$MDP" | base64 -w0)" clone -q --depth 1 http://127.0.0.1:3000/hibou/hibou-docs.git "$docs_main/d" \
      && docker run --rm --network hibou-forge_default -v "$docs_main/d:/d:ro" -v "$1/amorces/hibou-docs/outils/synchroniser_owui.py:/outil.py:ro" -w /d \
        -e OWUI_URL=http://open-webui:8080 -e OWUI_CLE="$cle_owui" hibou/docs-builder:actuel python3 /outil.py docs >/dev/null \
      && fait "Documentation fusionnée envoyée au chat ($(find "$docs_main/d/docs" -name '*.md' | wc -l) pages) ; le runner la tient à jour après chaque fusion." \
      || note "Synchronisation refusée : la base se remplira à la prochaine fusion dans hibou-docs."
    fi
    rm -rf "$docs_main"
    outils_par_pr hibou-docs "$1/amorces/hibou-docs" || note "hibou-docs : dépôt illisible, outils non comparés."
  else
    note "Open WebUI n’a pas délivré de clé d’API : la synchronisation de la documentation est à brancher à la main (secret OWUI_CLE de hibou-docs)."
  fi
  # Base « Hibou · Sécurité » (option du menu) : guides de l’ANSSI et textes de référence. ~180 PDF : indexation
  # en tâche de fond, reprise où elle s’est arrêtée à chaque passage.
  if [[ -f "$1/securite/INDEX.tsv" && -n "$cle_owui" ]]; then
    local kbsec
    kbsec=$(curl -fsS "${h[@]}" "$u/knowledge/" | jq -c '(.items? // .)[] | select(.name=="Hibou · Sécurité")' | head -1)
    [[ -n "$kbsec" ]] || kbsec=$(curl -fsS "${h[@]}" "$u/knowledge/create" -d '{"name":"Hibou · Sécurité","description":"Guides de l’ANSSI et textes de référence en sécurité des SI"}')
    curl -fsS "${h[@]}" "$u/knowledge/$(jq -r .id <<< "$kbsec")/access/update" -d "{\"access_grants\":$public}" >/dev/null || return 1
    ( umask 077; printf 'OWUI_URL=http://open-webui:8080\nOWUI_CLE=%s\nBASE_ID=%s\n' "$cle_owui" "$(jq -r .id <<< "$kbsec")" > /srv/hibou/securite.env )
    if ! curl -fsS -m 5 "http://$HIBOU_IP_DOC:8080/health" >/dev/null 2>&1; then
      note "Base « Hibou · Sécurité » : chargement reporté, le serveur doc (embeddings) est injoignable. Il démarrera à la mise à jour de doc."
    else
    systemd-run --quiet --unit hibou-securite --collect docker run --rm --init --network hibou-forge_default --env-file /srv/hibou/securite.env \
      -v "$1/securite:/securite:ro" -v "$1/amorces/open-webui/charger_securite.py:/charger.py:ro" hibou/docs-builder:actuel python3 /charger.py /securite >/dev/null \
      && fait "Base « Hibou · Sécurité » : $(grep -c . "$1/securite/INDEX.tsv") documents, chargement en tâche de fond, repris où il en était (journalctl -fu hibou-securite)." \
      || note "Chargement de la base « Hibou · Sécurité » non lancé."
    fi
    jq -nc --argjson kb "$kbsec" --arg b "$PRINCIPAL" '{id:"hibou-securite",name:"Hibou · Sécurité",base_model_id:$b,
      meta:{description:"Répond à partir des guides de l’ANSSI et des textes de référence, avec ses sources.",profile_image_url:"/static/hibou/symbole-sur-nuit.svg",
        knowledge:[$kb + {type:"collection"}],capabilities:{citations:true},toolIds:["exporter_document"]},
      params:{system:"Tu es Hibou, conseiller en sécurité des systèmes d’information. Tu réponds en français, au tutoiement, calme et précis, sans point d’exclamation ni émoji. Tu t’appuies d’abord sur les documents fournis (guides et recommandations de l’ANSSI, textes de référence) et tu cites le document et la recommandation utilisés. Si les documents ne couvrent pas la question, dis-le avant de répondre avec tes connaissances générales, en le signalant. Pour une mise en œuvre, donne des étapes à l’infinitif et les commandes exactes. Si la personne demande un fichier, appelle l’outil exporter_document. Ne nomme jamais tes outils dans tes réponses.",temperature:0.2},
      is_active:true}' | modele_owui || return 1
  fi
  # Modèle de questions-réponses sur la documentation interne.
  jq -nc --argjson kb "$kbdoc" --arg b "$PRINCIPAL" '{id:"hibou-documentation",name:"Hibou · Documentation interne",base_model_id:$b,
    meta:{description:"Répond à partir de la documentation validée de hibou-docs, avec ses sources.",profile_image_url:"/static/hibou/symbole-sur-nuit.svg",
      knowledge:[$kb + {type:"collection"}],capabilities:{citations:true},toolIds:["exporter_document"]},
    params:{system:"Tu es Hibou. Tu réponds en français, au tutoiement, calme et précis, sans point d’exclamation ni émoji. Tu réponds uniquement à partir des documents fournis et tu cites la page utilisée. Si la documentation ne contient pas la réponse, dis-le et propose de rédiger la page manquante avec un modèle Hibou de rédaction. Si la personne demande un fichier, appelle l’outil exporter_document. Ne nomme jamais tes outils dans tes réponses.",temperature:0.2},
    is_active:true}' | modele_owui || return 1

  # Modèles Hibou rattachés au modèle principal réellement installé sur doc.
  local base; profil doc "$HIBOU_PROFIL_DOC"; base="$PRINCIPAL"
  jq -c --arg b "$base" --argjson kb "$kb" '.[] | .base_model_id = $b | .meta.knowledge = [$kb + {type: "collection"}]' \
    "$1/amorces/open-webui/modeles-hibou.json" | while read -r m; do modele_owui <<< "$m" || exit 1; done || return 1
  # Import d’un document existant (Word, PDF…) : le texte extrait par Open WebUI est repris dans le gabarit Hibou le plus proche.
  local gabarits="" g
  for g in "$1"/amorces/hibou-docs/templates/*.md; do
    gabarits+="- $(basename "$g" .md) : sections $(sed -n 's/^sections: //p' "$g")"$'\n'
  done
  # Sans la base des gabarits : leurs consignes en commentaire seraient recopiées telles quelles.
  jq -nc --arg b "$base" --arg g "$gabarits" '{id:"hibou-import",name:"Hibou · Import d’un document",base_model_id:$b,
    meta:{description:"Reprend un document existant (Word, PDF, texte) dans le gabarit Hibou le plus proche, puis le propose à la documentation.",
      profile_image_url:"/static/hibou/symbole-sur-nuit.svg",toolIds:["publier_forgejo","exporter_document"],capabilities:{citations:true}},
    params:{system:("Tu es Hibou, assistant de reprise de documents. Tu écris en français, au tutoiement, calme et précis, sans point d’exclamation ni émoji.\n\n"
      + "La personne dépose un document existant. Tu le reprends dans un gabarit de la documentation Hibou :\n"
      + "1. Choisis le gabarit le plus proche et dis lequel en une phrase. Gabarits et sections, dans l’ordre :\n" + $g
      + "2. Écris le document Markdown complet. Il commence exactement ainsi (exemple pour une procédure) :\n---\nmodele: procedure\ntitre: Redémarrer le service X\ndate: {{CURRENT_DATE}}\n---\n\n# Redémarrer le service X\n"
      + "puis toutes les sections ## du gabarit, dans l’ordre, avec ces intitulés exacts, chacune remplie de texte. Aucun commentaire <!-- --> dans le document.\n"
      + "3. Reprends le contenu fidèlement : ne résume pas, n’ajoute rien, garde les commandes, valeurs et noms exacts. Corrige seulement la forme : "
      + "étapes à l’infinitif, listes, blocs de code avec leur langage et une ligne vide autour.\n"
      + "4. Range chaque information du document dans la section qui lui correspond (pour une procédure : ce que fait le document → Objet ; droits et accès → Prérequis ; "
      + "actions → Étapes ; contrôle du résultat → Vérification ; que faire en cas d’échec → Retour arrière). Seulement si le document ne dit rien pour une section, "
      + "écris « À compléter : » et ce qu’il faut fournir.\n"
      + "5. Après le document, liste en quelques puces ce que tu as déplacé ou laissé à compléter.\n\n"
      + "Demande ensuite si la personne veut publier. Publie seulement après son accord explicite, dans docs/<dossier>/<nom-en-minuscules-sans-accent>.md "
      + "(procedures, fiches-techniques, guides, architecture ou decisions selon le gabarit). Ne nomme jamais tes outils."),temperature:0.2},
    is_active:true}' | modele_owui || return 1

  # Modèles techniques masqués du sélecteur : embeddings et autocomplétion ne servent pas au chat.
  for m in qwen3-embedding qwen3-reranker fim; do
    jq -nc --arg i "$m" '{id:$i,name:$i,base_model_id:null,meta:{},params:{},is_active:false}' | modele_owui || return 1
  done
  fait "Outil publier_forgejo, 5 modèles Hibou (base $base), base de templates, suggestions et modèle par défaut en place."
}

installer() {
  local role="${1:-}" b="${2:-$ICI_HIBOU}"
  [[ "$role" =~ ^(forge|doc|dev|noeud)$ ]] || erreur "Rôle inconnu : ${role:-aucun}." "Choisis forge, doc, dev ou noeud."
  exiger_root
  b="$(cd "$b" && pwd)"
  [[ -f "$b/MANIFEST.md" && -f "$b/config.env" ]] || erreur "Je ne trouve pas le bundle dans $b." "Indique son dossier : hibou installer $role /chemin/du/bundle"
  # shellcheck disable=SC1091
  source "$b/config.env"; DOMAINE="$HIBOU_DOMAINE"
  if [[ -f /etc/pve/.version ]]; then
    sur_proxmox "$role" "$b"
  else
    [[ "$role" != noeud ]] || erreur "Le rôle noeud s’installe sur un hôte Proxmox."
    local et=("socle:Socle (paquets, pilote, Docker)" "images:Chargement des images")
    if [[ $role == forge ]]; then et+=("config:Configuration et démarrage" "comptes:Comptes et connexion unique" "miroir:Import du miroir")
    else et+=("modeles:Copie des modèles" "config:Configuration et démarrage"); fi
    proposer_sauts "${et[@]}"
    secrets "$b"
    if [[ -n "${HIBOU_SANS_VERIF:-}" ]]; then :; else verifier "$b"; fi
    if [[ "$role" == forge ]]; then installer_forge "$b"; else installer_gpu "$role" "$b"; fi
  fi
  printf '\n'; dire "J’ai terminé le rôle $role${HIBOU_PHASE:+ (phase $HIBOU_PHASE)}."
}

# ─── Autotest ───────────────────────────────────────────────────────────────
autotest() {
  local role i n=0 ligne alias depot motifs ctx args
  for role in dev doc; do
    local -n libs="PROFILS_${role^^}" seuils="PROFILS_${role^^}_GO"
    (( ${#libs[@]} == ${#seuils[@]} )) || erreur "PROFILS_${role^^} et ses seuils n’ont pas la même longueur."
    for i in $(seq 1 ${#libs[@]}); do
      profil "$role" "$i"
      for ligne in "${MODELES_ROLE[@]}"; do
        IFS='|' read -r alias depot motifs ctx args <<< "$ligne"
        [[ -n "$alias" && "$depot" == */* && -n "$motifs" && "$ctx" =~ ^[0-9]+$ ]] || erreur "Modèle mal formé ($role $i) : $ligne"
        n=$((n + 1))
      done
    done
    unset -n libs seuils
  done
  for role in "${!ROLE_IMAGES[@]}"; do
    for alias in ${ROLE_IMAGES[$role]}; do
      [[ " $LOCALES " == *" $alias "* || -n "${IMAGES[$alias]:-}" ]] || erreur "Image $alias du rôle $role absente de IMAGES."
    done
  done
  [[ "$(modele_image 4 | cut -d'|' -f4)" == --lowvram && -z "$(modele_image 12 | cut -d'|' -f4)" ]] || erreur "modele_image incohérent."
  if python3 -c 'import asyncio' 2>/dev/null; then source_priorite | HIBOU_AUTOTEST=1 python3 - || erreur "Autotest de la file de priorité en échec."; fi
  fait "Configuration cohérente : $n lignes de modèles, ${#IMAGES[@]} images, 3 rôles."
}

# Nouvelles clés d’API, nouveaux jetons des comptes de service, nouvelles applications de connexion et secret du webhook,
# appliqués à toutes les VM en marche. Les mots de passe des personnes et la phrase du bundle ne changent pas.
renouveler_secrets() {  # bundle
  { set +x; } 2>/dev/null   # jamais de trace : les secrets apparaîtraient en clair
  exiger_root
  local b; b="$(cd "${1:-$ICI_HIBOU}" && pwd)"
  [[ -f /etc/pve/.version ]] || erreur "Cette commande se lance sur l’hôte Proxmox qui a installé Hibou." "Sur cet hôte : hibou renouveler-secrets /chemin/du/bundle"
  # shellcheck disable=SC1091
  source "$b/config.env"; DOMAINE="$HIBOU_DOMAINE"
  verifier "$b"
  secrets "$b"
  local vm role i nom mail mdp eq k
  vm=$(qm status "$HIBOU_VMID_FORGE" 2>/dev/null) || erreur "La VM forge n’existe pas sur cet hôte." "Lance la commande sur l’hôte de forge."
  [[ "$vm" == *running* ]] || erreur "La VM forge est arrêtée." "Démarre-la (qm start $HIBOU_VMID_FORGE), puis relance."

  etape "Nouvelles clés"
  HIBOU_CLE_WEBUI=$(cle); HIBOU_CLE_OPENCODE=$(cle); HIBOU_CLE_RELECTEUR=$(cle)
  for i in "${!HIBOU_UTILISATEURS[@]}"; do
    IFS='|' read -r nom mail mdp eq k <<< "${HIBOU_UTILISATEURS[$i]}"
    HIBOU_UTILISATEURS[i]="$nom|$mail|$mdp|$eq|$(cle)"
  done
  chiffrer_secrets "$b" "$PHRASE"
  (cd "$b" && sed -i -E "s|^[0-9a-f]{64}  (\./)?secrets\.chiffre$|$(sha256sum secrets.chiffre | cut -c1-64)  \1secrets.chiffre|" SHA256SUMS)
  fait "secrets.chiffre réécrit, même phrase de passe. Les copies plus anciennes du bundle ne correspondent plus : remplace-les."

  for role in forge doc dev; do
    vm=$(v=HIBOU_VMID_${role^^}; qm status "${!v}" 2>/dev/null) || true
    if [[ "$vm" != *running* ]]; then
      note "VM $role arrêtée : lance « hibou mettre-a-jour $role » dès son démarrage (elle garde l’ancienne clé d’ici là)."
      continue
    fi
    etape "Application à $role"
    ( HIBOU_MAJ=1 HIBOU_RENOUVELER=1 HIBOU_SAUTER=verif,miroir,evaluation; sur_proxmox "$role" "$b" )
  done
  fait "Secrets renouvelés : clés d’API (nouvelles clés personnelles dans /root/hibou-acces.txt sur forge), jetons hibou-dev, hibou-redac et hibou-relecteur
        (anciens révoqués), applications de connexion Open WebUI, OpenCode, Grafana et Proxmox, secret du webhook de relecture."
  note "Inchangés : mots de passe des personnes et de l’administrateur (à changer dans Forgejo), phrase du bundle, clés SSH."
}

# Contrôle de tout ce qui tourne sur cet hôte, avec un rapport sans secret à joindre à un ticket. Ne modifie rien.
diagnostic() {  # bundle
  exiger_root
  local b; b="$(cd "${1:-$ICI_HIBOU}" && pwd)"
  [[ -f /etc/pve/.version ]] || erreur "Cette commande se lance sur un hôte Proxmox de Hibou." "Sur l’hôte : hibou diagnostic /chemin/du/bundle"
  # shellcheck disable=SC1091
  source "$b/config.env"; DOMAINE="$HIBOU_DOMAINE"
  local rapport; rapport="/root/hibou-diagnostic-$(date +%Y%m%d-%H%M).txt"
  local n_ok=0 n_att=0 n_ech=0
  diag() {  # ok|attention|echec libellé [détail]
    local c=$SUCCES m="OK"
    case $1 in attention) c=$AMBRE m="ATTENTION"; n_att=$((n_att + 1)) ;; echec) c=$DANGER m="ÉCHEC"; n_ech=$((n_ech + 1)) ;; *) n_ok=$((n_ok + 1)) ;; esac
    printf '  %s%-9s%s %s%s\n' "$c" "$m" "$FIN" "$2" "${3:+ ($3)}"
    printf '%-9s %s%s\n' "$m" "$2" "${3:+ ($3)}" >> "$rapport"
  }
  seuil_disque() {  # libellé pourcentage
    if (( $2 >= 95 )); then diag echec "$1 : disque plein à $2 %"; elif (( $2 >= 85 )); then diag attention "$1 : disque à $2 %"; else diag ok "$1 : disque à $2 %"; fi
  }
  umask 077
  { echo "Hibou $VERSION_HIBOU — diagnostic de $(hostname) le $(date '+%F %T')"; echo "Aucun secret dans ce rapport."; echo; } > "$rapport"

  etape "Hôte Proxmox"
  local st pct
  for st in "$HIBOU_STOCKAGE" "$HIBOU_STOCKAGE_SAUVEGARDE"; do
    [[ -n "$st" ]] || continue
    pct=$(pvesm status --storage "$st" 2>/dev/null | awk 'NR==2 && $3=="active" {printf "%d", $7}')
    if [[ -z "$pct" ]]; then diag echec "Stockage $st inactif ou absent"; else seuil_disque "Stockage $st" "$pct"; fi
  done
  if [[ -f /etc/pve/corosync.conf ]]; then
    if pvecm status 2>/dev/null | grep -q '^Quorate:.*Yes'; then diag ok "Cluster : quorum atteint" "$(pvecm status | awk '/^Nodes:/ {print $2}') nœuds"
    else diag echec "Cluster : pas de quorum" "pvecm status"; fi
  fi
  local carte pilote
  while read -r carte; do
    pilote=$(lspci -nnks "$carte" | awk -F': ' '/Kernel driver in use/ {print $2}')
    if [[ "$pilote" == vfio-pci ]]; then diag ok "Carte $carte réservée aux VM (vfio-pci)"; else diag attention "Carte $carte tenue par ${pilote:-aucun pilote}" "attendu : vfio-pci"; fi
  done < <(lspci -Dn | awk '$2 ~ /^03/ && $3 ~ /^10de:/ {print $1}')
  if [[ -n "$HIBOU_STOCKAGE_SAUVEGARDE" ]] && qm status "$HIBOU_VMID_FORGE" >/dev/null 2>&1; then
    local der
    der=$(pvesh get "/nodes/$(hostname)/storage/$HIBOU_STOCKAGE_SAUVEGARDE/content" --content backup --vmid "$HIBOU_VMID_FORGE" --output-format json 2>/dev/null \
          | jq -r 'if length > 0 then (max_by(.ctime) | .ctime) else empty end')
    if [[ -z "$der" ]]; then diag echec "Aucune sauvegarde de forge"
    elif (( $(date +%s) - der > 26 * 3600 )); then diag attention "Dernière sauvegarde de forge : $(date -d "@$der" '+%F %H:%M')" "plus de 26 h"
    else diag ok "Dernière sauvegarde de forge : $(date -d "@$der" '+%F %H:%M')"; fi
  fi

  local role vmid ip etat
  for role in forge doc dev; do
    vmid="HIBOU_VMID_${role^^}"; vmid=${!vmid}; ip="HIBOU_IP_${role^^}"; ip=${!ip}
    etat=$(qm status "$vmid" 2>/dev/null | awk '{print $2}') || continue   # VM sur un autre hôte du cluster
    [[ -n "$etat" ]] || continue
    etape "VM $role ($vmid, $ip)"
    if [[ "$etat" != running ]]; then diag attention "VM $role : $etat"; continue; fi
    if ! ssh_vm "$ip" true 2>/dev/null; then diag echec "VM $role : en marche mais injoignable en SSH"; continue; fi
    diag ok "VM $role en marche, joignable"
    seuil_disque "VM $role" "$(ssh_vm "$ip" "df --output=pcent / | tail -1 | tr -dc 0-9")"
    local hs
    hs=$(ssh_vm "$ip" "sudo docker ps -a --filter name=^hibou- --format '{{.Names}} {{.State}}' | awk '\$2 != \"running\" {print \$1 \":\" \$2}' | tr '\n' ' '")
    if [[ -n "$hs" ]]; then diag echec "VM $role : conteneurs arrêtés ou en boucle" "$hs"
    else diag ok "VM $role : $(ssh_vm "$ip" "sudo docker ps -q --filter name=^hibou- | wc -l") conteneurs en marche"; fi
    if [[ "$role" == forge ]]; then
      ssh_vm "$ip" "curl -fsS -m 5 http://127.0.0.1:3000/api/healthz >/dev/null" && diag ok "Forgejo répond" || diag echec "Forgejo ne répond pas"
      ssh_vm "$ip" "curl -fsS -m 5 http://127.0.0.1:8081/health >/dev/null" && diag ok "Open WebUI répond" || diag echec "Open WebUI ne répond pas"
      local site code
      for site in forge chat code docs supervision etat; do
        code=$(ssh_vm "$ip" "curl -sk -o /dev/null -m 10 -w '%{http_code}' --resolve $site.$DOMAINE:443:127.0.0.1 https://$site.$DOMAINE/")
        case $code in 2??|30?) diag ok "https://$site.$DOMAINE" "$code" ;; *) diag echec "https://$site.$DOMAINE" "réponse $code" ;; esac
      done
      local fin
      fin=$(ssh_vm "$ip" "sudo openssl x509 -enddate -noout -in /srv/hibou/hibou-ca.crt 2>/dev/null | cut -d= -f2")
      if [[ -z "$fin" ]]; then diag attention "Autorité Hibou introuvable" "/srv/hibou/hibou-ca.crt"
      elif (( $(date -d "$fin" +%s) - $(date +%s) < 60 * 86400 )); then diag attention "Autorité Hibou : expire le $(date -d "$fin" +%F)" "moins de 60 jours"
      else diag ok "Autorité Hibou valable jusqu’au $(date -d "$fin" +%F)"; fi
      case $(ssh_vm "$ip" "systemctl is-active hibou-securite 2>/dev/null; systemctl is-failed --quiet hibou-securite 2>/dev/null && echo echec") in
        *echec*) diag attention "Chargement de la base sécurité en échec" "journalctl -u hibou-securite" ;;
        active*) diag ok "Base sécurité : chargement en cours" ;;
      esac
      local r
      for r in doc dev; do
        local ipr="HIBOU_IP_${r^^}"; ipr=${!ipr}
        ssh_vm "$ip" "curl -fsS -m 5 http://$ipr:8080/health >/dev/null 2>&1" && diag ok "forge joint le serveur $r" \
          || diag attention "forge ne joint pas le serveur $r" "VM $r arrêtée ou sur un autre hôte ?"
      done
    else
      local nb attendu="HIBOU_${role^^}_NB"; attendu=${!attendu:-1}
      nb=$(ssh_vm "$ip" "nvidia-smi -L 2>/dev/null | grep -c '^GPU'") || nb=0
      if (( nb >= attendu )); then diag ok "VM $role : $nb carte(s) NVIDIA" "$(ssh_vm "$ip" "nvidia-smi --query-gpu=name,memory.used,memory.total,temperature.gpu --format=csv,noheader | sed 's/, / · /g' | paste -sd ';'")"
      else diag echec "VM $role : $nb carte(s) vue(s) sur $attendu" "nvidia-smi"; fi
      ssh_vm "$ip" "curl -fsS -m 5 localhost:8080/health >/dev/null" && diag ok "API des modèles $role en ligne" || diag echec "API des modèles $role hors ligne"
    fi
  done

  { echo; echo "Bilan : $n_ok OK, $n_att attention, $n_ech échec."; } >> "$rapport"
  printf '\n'
  if (( n_ech )); then dire "$n_ech échec(s), $n_att point(s) d’attention. Rapport : $rapport"; return 1; fi
  if (( n_att )); then dire "Aucun échec : $n_ok contrôles OK, $n_att point(s) d’attention. Rapport : $rapport"
  else dire "Tout va bien : $n_ok contrôles OK. Rapport : $rapport"; fi
}

# Essai de bout en bout, comme une personne, avec un compte temporaire supprimé à la fin. Sur l’hôte de forge.
essai() {  # bundle
  { set +x; } 2>/dev/null
  exiger_root
  local b; b="$(cd "${1:-$ICI_HIBOU}" && pwd)"
  [[ -f /etc/pve/.version ]] || erreur "Cette commande se lance sur l’hôte Proxmox de forge." "Sur cet hôte : hibou essai /chemin/du/bundle"
  # shellcheck disable=SC1091
  source "$b/config.env"; DOMAINE="$HIBOU_DOMAINE"
  secrets "$b"
  [[ "$(qm status "$HIBOU_VMID_FORGE" 2>/dev/null)" == *running* ]] || erreur "La VM forge n’est pas en marche sur cet hôte." "Démarre-la, ou lance l’essai sur l’hôte de forge."
  local f=HIBOU_IP_FORGE sans_dev="" rapport ligne etat lib det n_ok=0 n_att=0 n_ech=0 debut
  f=${!f}; debut=$(date +%s)
  ssh_vm "$f" "curl -fsS -m 5 http://$HIBOU_IP_DEV:8080/health >/dev/null 2>&1" \
    || { sans_dev=--sans-dev; note "Serveur dev injoignable : relecture et agent de code non essayés."; }
  local rs=(rsync -a -e "ssh -i /root/.ssh/hibou_ed25519 -o BatchMode=yes -o UserKnownHostsFile=/root/.ssh/hibou_known_hosts")
  "${rs[@]}" "$b/hibou" "hibou@$f:hibou-bundle/hibou" && "${rs[@]}" --mkpath "$b/amorces/essai/" "hibou@$f:hibou-bundle/amorces/essai/" \
    || erreur "Copie du script d’essai vers forge impossible." "Vérifie la connexion : ssh hibou@$f"
  rapport="/root/hibou-essai-$(date +%Y%m%d-%H%M).txt"
  umask 077
  { echo "Hibou $VERSION_HIBOU — essai de bout en bout le $(date '+%F %T')"; echo "Aucun secret dans ce rapport."; echo; } > "$rapport"
  etape "Essai de bout en bout (1 à 5 min ; plus si un modèle doit se charger)"
  while IFS=$'\t' read -r ligne etat lib det; do
    [[ "$ligne" == R ]] || { [[ -n "$ligne" ]] && note "$ligne${etat:+ $etat}"; continue; }
    case $etat in
      ok) n_ok=$((n_ok + 1)); printf '  %s%-9s%s %s%s\n' "$SUCCES" OK "$FIN" "$lib" "${det:+ ($det)}"; printf '%-9s %s%s\n' OK "$lib" "${det:+ ($det)}" >> "$rapport" ;;
      attention) n_att=$((n_att + 1)); printf '  %s%-9s%s %s%s\n' "$AMBRE" ATTENTION "$FIN" "$lib" "${det:+ ($det)}"; printf '%-9s %s%s\n' ATTENTION "$lib" "${det:+ ($det)}" >> "$rapport" ;;
      *) n_ech=$((n_ech + 1)); printf '  %s%-9s%s %s%s\n' "$DANGER" ÉCHEC "$FIN" "$lib" "${det:+ ($det)}"; printf '%-9s %s%s\n' ÉCHEC "$lib" "${det:+ ($det)}" >> "$rapport" ;;
    esac
  done < <(printf '%s\n' "$PHRASE" | ssh_vm "$f" "sudo NO_COLOR=1 bash hibou-bundle/hibou essai-forge hibou-bundle $sans_dev" 2>&1)
  { echo; echo "Bilan : $n_ok OK, $n_att attention, $n_ech échec, $(( ($(date +%s) - debut) / 60 )) min."; } >> "$rapport"
  printf '\n'
  if (( n_ech )) || (( n_ok == 0 )); then dire "Essai en échec : $n_ech échec(s), $n_att point(s) d’attention. Rapport : $rapport"; return 1; fi
  dire "Essai réussi : $n_ok contrôles OK${sans_dev:+ (sans le serveur dev)}, $n_att point(s) d’attention, $(( ($(date +%s) - debut) / 60 )) min. Rapport : $rapport"
}

essai_forge() {  # bundle [--sans-dev] — dans la VM forge, appelé par « hibou essai »
  { set +x; } 2>/dev/null
  exiger_root
  local b; b="$(cd "$1" && pwd)"
  # shellcheck disable=SC1091
  source "$b/config.env"; DOMAINE="$HIBOU_DOMAINE"
  secrets "$b"
  ADMIN="$HIBOU_ADMIN_NOM"; MDP="$HIBOU_ADMIN_MDP"
  local nom mdp eq attendus="hibou-documentation,hibou-procedure,hibou-fiche-technique,hibou-guide-utilisateur,hibou-architecture,hibou-decision,hibou-import"
  nom="essai-$(date +%m%d%H%M%S)"; mdp=$(cle)
  [[ -f "$b/securite/INDEX.tsv" || -f /srv/hibou/securite.env ]] && attendus+=",hibou-securite"
  api POST /admin/users "$(jq -nc --arg n "$nom" --arg m "$nom@$DOMAINE" --arg p "$mdp" '{username:$n,email:$m,password:$p,must_change_password:false,visibility:"private"}')" >/dev/null \
    || { printf 'R\techec\tCompte d’essai\tForgejo refuse de le créer\n'; return 1; }
  for eq in doc dev; do api PUT "/teams/$(equipe_id "$eq")/members/$nom" >/dev/null; done
  printf 'R\tok\tCompte d’essai temporaire\t%s\n' "$nom"
  docker cp "$b/amorces/essai/hibou_essai.py" hibou-forge-open-webui-1:/tmp/hibou_essai.py >/dev/null
  docker cp /srv/hibou/hibou-ca.crt hibou-forge-open-webui-1:/tmp/hibou-ca.crt >/dev/null
  printf '%s\n' "$mdp" | docker exec -i hibou-forge-open-webui-1 python3 /tmp/hibou_essai.py "$DOMAINE" "$nom" /tmp/hibou-ca.crt "$attendus" ${2:-} \
    || printf 'R\techec\tScript d’essai\tarrêté avant la fin\n'
  # Instance OpenCode de chaque personne de l’équipe dev, vue depuis Caddy (qui la sert).
  local m k
  while read -r m _ k; do
    if docker exec hibou-forge-caddy-1 wget -q -T 10 -O /dev/null "http://opencode-$m:4096/" 2>/dev/null; then printf 'R\tok\tInstance OpenCode de %s\t\n' "$m"
    else printf 'R\techec\tInstance OpenCode de %s\tne répond pas (docker logs hibou-forge-opencode-%s-1)\n' "$m" "$m"; fi
  done < <(utilisateurs_dev)
  # Ménage : compte du chat (et ses conversations, fichiers), puis compte Forgejo.
  local u=http://127.0.0.1:8081/api/v1 jeton id
  jeton=$(curl -fsS "$u/auths/signin" -H 'Content-Type: application/json' \
          -d "$(jq -nc --arg e "$HIBOU_ADMIN_MAIL" --arg p "$MDP" '{email:$e,password:$p}')" | jq -r .token)
  id=$(curl -fsS -H "Authorization: Bearer $jeton" "$u/users/search?query=$nom" | jq -r --arg m "$nom@$DOMAINE" '.users[]? | select(.email==$m) | .id')
  [[ -z "$id" ]] || curl -fsS -X DELETE -H "Authorization: Bearer $jeton" "$u/users/$id" >/dev/null
  # Compte Grafana créé à la connexion unique.
  local g=(-sk -u "$ADMIN:$MDP" --resolve "supervision.$DOMAINE:443:127.0.0.1")
  id=$(curl "${g[@]}" "https://supervision.$DOMAINE/api/users/lookup?loginOrEmail=$nom@$DOMAINE" | jq -r '.id // empty' 2>/dev/null)
  [[ -z "$id" ]] || curl "${g[@]}" -X DELETE "https://supervision.$DOMAINE/api/admin/users/$id" >/dev/null
  api DELETE "/admin/users/$nom?purge=true" >/dev/null && printf 'R\tok\tMénage\tcompte d’essai supprimé (Forgejo, chat, Grafana)\n' \
    || printf 'R\tattention\tMénage\tsupprime le compte %s dans Forgejo\n' "$nom"
  docker exec hibou-forge-open-webui-1 rm -f /tmp/hibou_essai.py
}

aide() {
  cat <<EOF
  ${GRAS}${BRUME}Utilisation${FIN}
    hibou telecharger [dossier]          Machine connectée : questions, puis préparation du bundle.
    hibou verifier [dossier]             Contrôle les empreintes SHA-256.
    hibou installer <rôle> [dossier]     Sur l’hôte Proxmox : crée la VM et installe tout, sans question.
    hibou mettre-a-jour <rôle> [dossier] Sur l’hôte Proxmox : n’apporte que ce qui a changé (images, modèles, cartes, réglages).
    hibou configurer [dossier]           Sur forge : rejoue comptes, dépôts et connexion unique.
    hibou renouveler-secrets [dossier]   Sur l’hôte Proxmox : nouvelles clés, jetons et secrets de connexion, appliqués partout.
    hibou diagnostic [dossier]           Sur l’hôte Proxmox : contrôle tout, rapport sans secret dans /root.
    hibou essai [dossier]                Sur l’hôte de forge : essai de bout en bout avec un compte temporaire.
    hibou evaluer <doc|dev|tout> [dossier]  Sur forge : note les modèles (code, rédaction, vision) et met à jour Grafana.
    hibou miroir [dossier]               Sur forge : republie le miroir pip, npm, git, images dans Forgejo.
    hibou autotest                       Vérifie la cohérence des réglages.

  ${GRAS}${BRUME}Rôles${FIN}
    forge   Sur un nœud du cluster : VM des applications (Forgejo, Open WebUI, OpenCode, supervision).
    doc     Sur l’hôte des cartes doc : VM avec les cartes en passthrough, LLM de rédaction, vision, images.
    dev     Sur l’hôte des cartes dev : VM avec les cartes en passthrough, LLM de code.
    noeud   Sur les autres nœuds du cluster : supervision de l’hôte seulement.

  ${GRAS}${BRUME}Options${FIN}
    HIBOU_SAUTER=vm,copie     installer : étapes à sauter, sans question
    HIBOU_STOCKAGE=<nom>      installer : stockage Proxmox des disques
    HIBOU_RAM_GPU=48          installer doc/dev : mémoire de la VM en Go (défaut : tout l’hôte − 16 Go)
    HIBOU_CPU_GPU=12          installer doc/dev : fils de la VM (défaut : tous − 4)
    HIBOU_PARTIES=apt,extra   telecharger : ne refait que certaines parties
    HIBOU_SUPPORT_GO=512      telecharger : taille du disque de transport

  ${PIERRE}Ordre : forge, puis doc et dev. Phrase de passe demandée une fois par installation.${FIN}
EOF
}

symbole
case "${1:-aide}" in
  telecharger) shift; telecharger "$@" ;;
  verifier)    shift; verifier "$@" ;;
  installer)   shift; installer "$@" ;;
  mettre-a-jour) shift; HIBOU_MAJ=1; installer "$@" ;;
  configurer)  shift; configurer "$@" ;;
  renouveler-secrets) shift; renouveler_secrets "$@" ;;
  diagnostic)  shift; diagnostic "$@" ;;
  essai)       shift; essai "$@" ;;
  essai-forge) shift; essai_forge "$@" ;;
  evaluer)     shift; b="$(cd "${2:-$ICI_HIBOU}" && pwd)"; source "$b/config.env"; DOMAINE="$HIBOU_DOMAINE"; evaluer "${1:-tout}" "$b" ;;
  miroir)      shift; b="$(cd "${1:-$ICI_HIBOU}" && pwd)"; source "$b/config.env"; DOMAINE="$HIBOU_DOMAINE"; importer_miroir "$b" ;;
  autotest)    autotest ;;
  aide|-h|--help) aide ;;
  *) erreur "Commande inconnue : $1." "Lance « hibou aide » pour voir les commandes." ;;
esac
