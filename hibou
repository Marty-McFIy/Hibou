       targets: [{expr: "rate(hibou_llm_tokens_prompt_total[5m]) / rate(hibou_llm_prompt_secondes_total[5m])", legendFormat: $leg, refId: "A"}]},
      {id: 6, type: "timeseries", title: "Attente moyenne avant réponse, par utilisateur (s)", datasource: $ds, gridPos: {x: 0, y: 15, w: 12, h: 8},
       targets: [{expr: "sum by (serveur, utilisateur) (rate(hibou_llm_attente_secondes_total[15m])) / sum by (serveur, utilisateur) (rate(hibou_llm_requetes_total[15m]))", legendFormat: "{{serveur}} · {{utilisateur}}", refId: "A"}],
       fieldConfig: {defaults: {unit: "s"}}},
      {id: 7, type: "bargauge", title: "Requêtes sur 24 h, par utilisateur", datasource: $ds, gridPos: {x: 12, y: 15, w: 12, h: 8},
       targets: [{expr: "sum by (serveur, utilisateur) (increase(hibou_llm_requetes_total[24h]))", legendFormat: "{{serveur}} · {{utilisateur}}", refId: "A"}],
