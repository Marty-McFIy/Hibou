# Le disque de la VM est plus grand que l’image ou que ce que l’installateur d’Ubuntu a utilisé :
# on agrandit la partition, puis le volume LVM s’il y en a un, puis le système de fichiers.
agrandir_systeme() {
  local src part pv="" vg disque num avant
  src=$(findmnt -no SOURCE /)
  if [[ "$src" == /dev/mapper/* ]]; then
    vg=$(lvs --noheadings -o vg_name "$src" | tr -d ' ')
    pv=$(pvs --noheadings -o pv_name -S "vg_name=$vg" | head -1 | tr -d ' ')
    part="$pv"
  else part="$src"; fi
  disque="/dev/$(lsblk -no pkname "$part" | head -1)"
  num=$(cat "/sys/class/block/$(basename "$(readlink -f "$part")")/partition" 2>/dev/null || true)
  avant=$(df -BG --output=size / | tail -1 | tr -dc 0-9)
  [[ -n "$num" ]] && { growpart "$disque" "$num" >/dev/null 2>&1 || true; }   # code 1 = rien à agrandir
  if [[ -n "$pv" ]]; then
    pvresize -q "$pv" >/dev/null
    lvextend -q -r -l +100%FREE "$src" >/dev/null 2>&1 || true
  else
    case "$(findmnt -no FSTYPE /)" in
      ext4) resize2fs "$src" >/dev/null 2>&1 || true ;;
      xfs)  xfs_growfs / >/dev/null 2>&1 || true ;;
    esac
  fi
  fait "Système : ${avant} Go → $(df -BG --output=size / | tail -1 | tr -dc 0-9) Go (tout le disque)."
}

