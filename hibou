# Évalue les modèles d’un serveur avec hibou-eval, depuis forge (code exécuté dans un conteneur sans réseau).
evaluer() {  # doc|dev|tout [dossier]
  local quoi="${1:-tout}" b="${2:-$ICI_HIBOU}" role n ligne alias motifs args ip vision familles modeles
  [[ -r /srv/hibou/secrets/cle-eval ]] || erreur "Je ne trouve pas la clé d’évaluation." "Lance cette commande sur forge, en root, une fois forge installée."
  [[ "$quoi" =~ ^(doc|dev|tout)$ ]] || erreur "Serveur inconnu : $quoi." "Choisis doc, dev ou tout."
  local travail=/srv/hibou/eval
  install -d "$travail"; rsync -a --exclude resultats "$b/amorces/hibou-eval/" "$travail/"
  for role in doc dev; do
    [[ "$quoi" == tout || "$quoi" == "$role" ]] || continue
    n="HIBOU_PROFIL_${role^^}"; profil "$role" "${!n}"
    modeles=(); vision=0
    for ligne in "${MODELES_ROLE[@]}"; do
      IFS='|' read -r alias _ motifs _ args <<< "$ligne"
      [[ "$alias" == fim || "$args" == *--embedding* ]] || ! servi "$args" && continue
      modeles+=("$alias"); [[ "$motifs" == *mmproj* ]] && vision=1
    done
    familles=code; [[ "$role" == doc ]] && familles="doc$( (( vision )) && echo ,vision)"
    ip="HIBOU_IP_${role^^}"
    etape "Évaluation du serveur $role : ${modeles[*]} ($familles)"
    # Clé de service d’Open WebUI : dernier rang, l’évaluation passe toujours après les utilisateurs.
    (cd "$travail" && python3 evaluer.py --api "http://${!ip}:8080/v1" --cle "$(cat /srv/hibou/secrets/cle-eval)" \
      --modeles "$(IFS=,; echo "${modeles[*]}")" --familles "$familles" --reference "$PRINCIPAL" \
      --serveur "$role" --metriques "/srv/supervision/metriques/eval-$role.prom") \
      || note "L’évaluation de $role s’est arrêtée ; les résultats partiels sont dans $travail/resultats."
  done
  fait "Résultats dans $travail/resultats (CSV et réponses brutes), scores dans https://supervision.$DOMAINE"
}

config_opencode() {  # modèles du serveur dev, avec leurs vraies limites de contexte
  local n="HIBOU_PROFIL_DEV" ligne alias ctx args modeles="{}"
  profil dev "${!n}"
  for ligne in "${MODELES_ROLE[@]}"; do
    IFS='|' read -r alias _ _ ctx args <<< "$ligne"
    [[ "$alias" == fim ]] || ! servi "$args" && continue
    # Sans limite déclarée, OpenCode suppose un contexte inconnu et compacte trop tard ou trop tôt.
    # Sortie réservée : un quart du contexte au plus. Égale au contexte, OpenCode croit la fenêtre pleine et compacte à chaque tour.
    modeles=$(jq -c --arg a "$alias" --argjson c "$ctx" --argjson o $(( ctx >= 131072 ? 32768 : ctx / 4 )) \
      '. + {($a): {name: $a, tool_call: true, limit: {context: $c, output: $o}}}' <<< "$modeles")
  done
  # Refus immédiats : sans Internet ni droits root, ces commandes ne mènent nulle part et un petit modèle y perd des dizaines de tours.
  jq -n --arg p "$PRINCIPAL" --arg u "http://$HIBOU_IP_DEV:8080/v1" --arg k "$HIBOU_CLE_OPENCODE" --argjson m "$modeles" '{
    "$schema": "https://opencode.ai/config.json", theme: "hibou", autoupdate: false, share: "disabled",
    model: ("hibou/" + $p),
    provider: {hibou: {npm: "@ai-sdk/openai-compatible", name: "Hibou", options: {baseURL: $u, apiKey: $k}, models: $m}},
    permission: {edit: "allow", bash: {"*": "ask", "git status*": "allow", "git diff*": "allow", "git log*": "allow",
      "ls*": "allow", "cat*": "allow", "grep*": "allow", "rg*": "allow", "git push*main*": "deny", "sudo*": "deny",
      "apt*": "deny", "su *": "deny", "*--index-url*": "deny", "*--break-system-packages*": "deny",
      "*echo*TOKEN*": "deny", "*printenv*": "deny", "env": "deny", "*/proc/*/environ*": "deny",
      "*rm -*r* .git": "deny", "*rm -*r* .git *": "deny", "*rm -*r* .git/*": "deny", "*rm -*r* */.git*": "deny"}}
  }' > /srv/hibou/opencode.json
  chmod 644 /srv/hibou/opencode.json
  # Une instance par personne de l’équipe dev : son espace, ses sessions, sa clé (donc son rang dans la file du serveur dev).
  local nom mail k
  install -d /srv/hibou/opencode
  while read -r nom mail k; do
    jq --arg k "$k" '.provider.hibou.options.apiKey = $k' /srv/hibou/opencode.json > "/srv/hibou/opencode/$nom.json"
    chmod 644 "/srv/hibou/opencode/$nom.json"
    install -d -o 1000 -g 1000 "/srv/workspace/$nom" "/srv/opencode/$nom"
  done < <(utilisateurs_dev)
  # awk et non grep -v : « rien trouvé » n’est pas une erreur (grep sort en 1 et arrêtait la mise à jour).
  local ancien; ancien=$(awk 'NR==FNR {u[$1]; next} !($0 in u)' <(utilisateurs_dev) <(find /srv/workspace -mindepth 1 -maxdepth 1 -printf '%f\n') | tr '\n' ' ')
  [[ -z "${ancien// }" ]] || note "Dans /srv/workspace, hors des espaces personnels (version précédente, partagée) : $ancien. Déplace-les dans /srv/workspace/<utilisateur>."
}

utilisateurs_dev() {  # « nom courriel clé » pour chaque utilisateur de l’équipe dev
  local u nom mail mdp eq k
  for u in "${HIBOU_UTILISATEURS[@]}"; do
    IFS='|' read -r nom mail mdp eq k <<< "$u"
    [[ ",$eq," == *,dev,* ]] && echo "$nom $mail $k"
  done
  return 0
}

routes_opencode() {  # Caddyfile : chaque personne vers sa propre instance
  local nom mail k
  while read -r nom mail k; do
    printf '\t\t@%s header X-Auth-Request-Email %s\n\t\treverse_proxy @%s opencode-%s:4096\n' "$nom" "$mail" "$nom" "$nom"
  done < <(utilisateurs_dev)
}

services_opencode() {  # compose : une instance OpenCode par personne de l’équipe dev
  local nom mail k
  while read -r nom mail k; do
    cat <<YAML
  opencode-$nom:
    image: hibou/opencode:actuel
    profiles: [apps]
    restart: unless-stopped
    volumes:
      - /srv/workspace/$nom:/workspace
      - /srv/opencode/$nom:/home/node/.local   # sessions et état. Tout .local : monté plus bas, Docker crée .local au nom de root.
      - /srv/hibou/opencode/$nom.json:/home/node/.config/opencode/opencode.json:ro
      - /srv/hibou/charte/opencode/themes:/home/node/.config/opencode/themes:ro
      - /srv/hibou/ssh:/home/node/.ssh:ro
      - /srv/hibou/AGENTS.md:/home/node/.config/opencode/AGENTS.md:ro
      - /srv/hibou/npmrc:/home/node/.npmrc:ro
      - /srv/hibou/ca-bundle.crt:/etc/hibou/ca-bundle.crt:ro
    env_file: [{ path: /srv/hibou/opencode.env, required: false }]
    environment:
      CURL_CA_BUNDLE: /etc/hibou/ca-bundle.crt
      GIT_SSL_CAINFO: /etc/hibou/ca-bundle.crt
      NODE_EXTRA_CA_CERTS: /etc/hibou/ca-bundle.crt
      HIBOU_UTILISATEUR: $nom
      GIT_AUTHOR_NAME: $nom
      GIT_AUTHOR_EMAIL: $mail
      GIT_COMMITTER_NAME: hibou-dev
      GIT_COMMITTER_EMAIL: hibou-dev@$DOMAINE
YAML
  done < <(utilisateurs_dev)
}

